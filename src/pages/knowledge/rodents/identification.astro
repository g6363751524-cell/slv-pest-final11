---
import Layout from '../../../layouts/Layout.astro';
import { Header } from '../../../components/Header';
import { Footer } from '../../../components/Footer';
import { FloatingActions } from '../../../components/FloatingActions';
import {
  BookOpen,
  Search,
  Eye,
  AlertTriangle,
  ArrowRight,
  Phone,
  MessageCircle,
  Mail,
  ShieldCheck,
  Activity,
  Layers,
  Sparkles,
  Package,
  Home,
  Volume2
} from 'lucide-react';

const relatedArticles = [
  {
    title: 'Where Rodents Hide',
    desc: 'Kitchens, storage areas, ceiling voids, wall cavities, and utility rooms.',
    href: '/knowledge/rodents/where-they-hide'
  },
  {
    title: 'How Rodents Enter & Spread',
    desc: 'Foundation gaps, plumbing conduits, utility penetrations, and rooflines.',
    href: '/knowledge/rodents/how-they-spread'
  },
  {
    title: 'Rodent Prevention',
    desc: 'Securing food, clutter reduction, waste sanitation, and exclusion tips.',
    href: '/knowledge/rodents/prevention'
  },
  {
    title: 'Rodent Management Guide',
    desc: 'The 4-stage management workflow: inspection, assessment, targeted control, and monitoring.',
    href: '/knowledge/rodents/treatment-guide'
  },
  {
    title: 'Rodent FAQ',
    desc: 'Practical answers to 12 questions on costs, signs, preparation, and commercial treatment.',
    href: '/knowledge/rodents/faq'
  }
];

const identificationSigns = [
  {
    title: 'Rodent Droppings',
    desc: 'Small, dark, cylindrical or spindle-shaped droppings found along kitchen skirtings, inside lower cabinets, beneath pantry shelves, and behind motor appliances. Fresh droppings appear dark and moist, turning grey and crumbly over time.',
    icon: Activity
  },
  {
    title: 'Gnaw Marks & Structural Damage',
    desc: 'Rats and mice possess continuously growing incisors and must gnaw on wood, PVC conduits, cardboard packaging, and electrical wiring to grind them down, leaving visible tooth grooves and stripped cable sheaths.',
    icon: AlertTriangle
  },
  {
    title: 'Nocturnal Scratching & Scurrying',
    desc: 'Audible rustling, squeaking, and scratching noises occurring during quiet nighttime hours inside false ceilings, behind drywall partitions, within duct shafts, or under floorboards.',
    icon: Volume2
  },
  {
    title: 'Nesting Materials',
    desc: 'Shredded paper, cardboard scraps, insulation batting, and fabric remnants gathered into soft, ball-shaped nests in dark, rarely disturbed voids such as attic corners, drawer backs, or behind water heaters.',
    icon: Layers
  },
  {
    title: 'Damaged Food Packaging',
    desc: 'Chewed corners on cereal boxes, flour sacks, pet food bags, and grain packaging in kitchens, storage pantries, or restaurant dry goods stores.',
    icon: Package
  },
  {
    title: 'Visual Rodent Sightings',
    desc: 'Spotting live rodents darting along wall perimeters, particularly near dusk or dawn. Seeing rodents during daylight hours often indicates a well-established colony or competition for nesting space.',
    icon: Eye
  },
  {
    title: 'Unusual Musky Odours',
    desc: 'A distinct, stale, ammonia-like musky scent in enclosed cupboards, crawlspaces, or utility rooms caused by rodent urine and body scent trails.',
    icon: Sparkles
  },
  {
    title: 'Grease Smear Marks (Rub Marks)',
    desc: 'Dark oily smudge marks deposited along baseboards, pipes, and wall corners as rodents repeatedly brush their sebum-coated fur against building surfaces while traversing regular runways.',
    icon: Search
  }
];
---

<Layout
  title="Rodent Identification | Signs of Activity in Bangalore | SLV Pest Control"
  description="Learn how to identify signs of rodent activity in Bangalore properties: droppings, gnaw marks, scratching sounds, nesting materials, and food damage."
  canonical="https://slvpestcontrol.com/knowledge/rodents/identification"
>
  <Header client:load activeItem="knowledge" />

  <main class="flex-1 w-full relative overflow-hidden bg-[#090a0c]">
    {/* Architectural Background Pattern */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 right-1/4 w-[500px] h-[500px] bg-[#E5A93C]/[0.06] rounded-full blur-[140px]"></div>
      <div class="absolute top-[40%] left-[-100px] w-[500px] h-[500px] bg-[#E5A93C]/[0.04] rounded-full blur-[160px]"></div>
    </div>

    {/* Breadcrumbs: Home > Knowledge Hub > Rodents > Current Page */}
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs text-zinc-400">
        <a href="/" class="hover:text-white transition">Home</a>
        <span>&gt;</span>
        <a href="/knowledge" class="hover:text-white transition">Knowledge Hub</a>
        <span>&gt;</span>
        <a href="/services/rodent-control" class="hover:text-white transition">Rodents</a>
        <span>&gt;</span>
        <span class="text-[#F6C453] font-semibold">Rodent Identification</span>
      </nav>
    </div>

    {/* HERO */}
    <section class="relative z-10 pt-10 sm:pt-14 pb-12 sm:pb-16 border-b border-white/[0.06]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 mb-4 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-md">
          <BookOpen class="w-3.5 h-3.5 text-[#E5A93C]" />
          <span class="text-[#E5A93C] text-xs font-extrabold tracking-[0.2em] uppercase">
            RODENT KNOWLEDGE HUB
          </span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-[1.1] mb-5 font-heading">
          How to Identify <span class="slv-gold-text">Rodent Activity</span> in Bangalore
        </h1>

        <p class="text-zinc-300 text-sm sm:text-base leading-relaxed max-w-2xl mx-auto mb-8 font-normal">
          Because rodents are predominantly nocturnal and instinctive burrowers, infestations often manifest through physical traces before a live rat or mouse is observed. Learning these 8 visual and auditory indicators helps identify activity early.
        </p>

        <div class="inline-flex flex-wrap items-center justify-center gap-4 text-xs font-semibold">
          <a
            href="/services/rodent-control"
            class="slv-btn-primary px-6 py-3 text-xs uppercase tracking-wider inline-flex items-center gap-2"
          >
            <span>Rodent Inspection</span>
            <ArrowRight class="w-4 h-4" />
          </a>
          <a
            href="tel:9180397822"
            class="slv-btn-secondary px-6 py-3 text-xs uppercase tracking-wider inline-flex items-center gap-2"
          >
            <Phone class="w-4 h-4 text-[#F6C453]" />
            <span>Call 91803 97822</span>
          </a>
        </div>
      </div>
    </section>

    {/* SIGNS GRID */}
    <section class="relative z-10 py-14 sm:py-18 border-b border-white/[0.06]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-2">
            FIELD IDENTIFIERS
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
            8 Key Signs of Rodent Presence
          </h2>
          <p class="text-zinc-400 text-xs sm:text-sm mt-2">
            Check your property for these telltale indicators of mice or roof rats.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {identificationSigns.map((sign) => {
            const Icon = sign.icon;
            return (
              <div class="slv-card rounded-2xl p-6 sm:p-7 border border-white/[0.08] hover:border-[#E5A93C]/40 transition flex gap-5 items-start">
                <div class="w-12 h-12 rounded-xl bg-[#E5A93C]/10 border border-[#E5A93C]/20 flex items-center justify-center shrink-0 mt-1">
                  <Icon class="w-6 h-6 text-[#E5A93C]" />
                </div>
                <div>
                  <h3 class="text-lg font-bold text-white mb-2 font-heading">
                    {sign.title}
                  </h3>
                  <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed">
                    {sign.desc}
                  </p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* COMPARISON DETAIL SECTION */}
    <section class="relative z-10 py-14 sm:py-18 border-b border-white/[0.06] bg-[#0c0d10]/50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-2">
            SPECIES DIFFERENTIATION
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
            Rats vs. Mice: Identifying Droppings &amp; Habitats
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="slv-card rounded-2xl p-6 border border-white/[0.08]">
            <h3 class="text-lg font-bold text-[#F6C453] mb-3 font-heading">
              Rats (Roof Rat &amp; Norway Rat)
            </h3>
            <ul class="space-y-2.5 text-xs sm:text-sm text-zinc-300">
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#E5A93C] mt-1.5 shrink-0"></span>
                <span><strong>Dropping Size:</strong> 12mm to 19mm with blunt or spindle-pointed ends.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#E5A93C] mt-1.5 shrink-0"></span>
                <span><strong>Travel Paths:</strong> Overhead ceiling beams, cable trays, and exterior sewer drainage lines.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#E5A93C] mt-1.5 shrink-0"></span>
                <span><strong>Gnaw Depth:</strong> Capable of chewing through heavy wooden doors, plastic pipes, and thin aluminum.</span>
              </li>
            </ul>
          </div>

          <div class="slv-card rounded-2xl p-6 border border-white/[0.08]">
            <h3 class="text-lg font-bold text-[#F6C453] mb-3 font-heading">
              Mice (House Mouse)
            </h3>
            <ul class="space-y-2.5 text-xs sm:text-sm text-zinc-300">
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#E5A93C] mt-1.5 shrink-0"></span>
                <span><strong>Dropping Size:</strong> 3mm to 6mm, rod-shaped with pointed ends (resembling black rice grains).</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#E5A93C] mt-1.5 shrink-0"></span>
                <span><strong>Travel Paths:</strong> Floor level baseboards, appliance undersides, and pantry shelves.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#E5A93C] mt-1.5 shrink-0"></span>
                <span><strong>Entry Capability:</strong> Can squeeze through tiny 6mm (pencil-diameter) gaps under doors.</span>
              </li>
            </ul>
          </div>
        </div>

        {/* Call to action */}
        <div class="mt-10 text-center">
          <a
            href="/services/rodent-control"
            class="slv-btn-primary px-8 py-3.5 text-xs sm:text-sm font-bold uppercase tracking-wider inline-flex items-center gap-2"
          >
            <span>Schedule Rodent Inspection</span>
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>
    </section>

    {/* RELATED GUIDES */}
    <section class="relative z-10 py-14 sm:py-18 border-b border-white/[0.06]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-2">
            CONTINUE LEARNING
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
            More Rodent Knowledge Guides
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedArticles.map((article) => (
            <div class="slv-card rounded-2xl p-6 border border-white/[0.08] hover:border-[#E5A93C]/40 transition flex flex-col justify-between">
              <div>
                <h3 class="text-base font-bold text-white mb-2 font-heading">
                  {article.title}
                </h3>
                <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed mb-4">
                  {article.desc}
                </p>
              </div>
              <a
                href={article.href}
                class="text-xs font-bold text-[#F6C453] hover:text-white inline-flex items-center gap-1.5 transition"
              >
                <span>Read Guide</span>
                <ArrowRight class="w-3.5 h-3.5" />
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* FOOTER CTA SECTION */}
    <section class="relative z-10 py-14 sm:py-16 bg-[#0c0d10]/80">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-4">
          Suspect Rodents on Your Bangalore Property?
        </h2>
        <p class="text-zinc-300 text-xs sm:text-sm max-w-xl mx-auto mb-6">
          Get a professional property assessment from SLV Pest Control to identify activity hotspots, entry points, and tailored management solutions.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            href="/services/rodent-control"
            class="slv-btn-primary px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider inline-flex items-center gap-2"
          >
            <span>Rodent Inspection</span>
            <ArrowRight class="w-4 h-4" />
          </a>
          <a
            href="https://wa.me/9180397822"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 rounded-full bg-[#25D366] text-white text-xs sm:text-sm font-bold uppercase tracking-wider inline-flex items-center gap-2 shadow-md hover:bg-[#20bd5a] transition"
          >
            <MessageCircle class="w-4 h-4" />
            <span>WhatsApp 91803 97822</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingActions client:load />
</Layout>
