---
import Layout from '../../../layouts/Layout.astro';
import { Header } from '../../../components/Header';
import { Footer } from '../../../components/Footer';
import { FloatingActions } from '../../../components/FloatingActions';
import {
  BookOpen,
  Search,
  Eye,
  AlertTriangle,
  ArrowRight,
  Phone,
  MessageCircle,
  Mail,
  ShieldCheck,
  CheckCircle2,
  HelpCircle,
  Activity,
  Layers,
  Wrench,
  Clock,
  Compass
} from 'lucide-react';

const relatedArticles = [
  {
    title: 'Rodent Identification',
    desc: 'Signs of activity: droppings, gnaw marks, scratching noises, and smear trails.',
    href: '/knowledge/rodents/identification'
  },
  {
    title: 'Where Rodents Hide',
    desc: 'Kitchens, storage areas, ceiling voids, wall cavities, and utility rooms.',
    href: '/knowledge/rodents/where-they-hide'
  },
  {
    title: 'How Rodents Enter & Spread',
    desc: 'Concealed gaps, door sweeps, utility pipes, and roofline travel paths.',
    href: '/knowledge/rodents/how-they-spread'
  },
  {
    title: 'Rodent Prevention',
    desc: 'Securing food, clutter reduction, waste sanitation, and exclusion tips.',
    href: '/knowledge/rodents/prevention'
  },
  {
    title: 'Rodent FAQ',
    desc: 'Practical answers to 12 questions on costs, signs, preparation, and commercial treatment.',
    href: '/knowledge/rodents/faq'
  }
];

const managementStages = [
  {
    step: '01',
    title: 'Inspection',
    tagline: 'Thorough on-site visual and structural investigation.',
    desc: 'Our trained technicians conduct a systematic survey of the property envelope, examining baseboards, kitchen voids, utility pipe penetrations, suspended ceilings, and exterior perimeter grounds to identify signs of activity, mapped harbourages, and possible entry points.',
    icon: Search
  },
  {
    step: '02',
    title: 'Assessment',
    tagline: 'Customized strategy based on premise conditions.',
    desc: 'No two properties are identical. We evaluate the specific rodent species involved (roof rats, Norway rats, or house mice), the extent of the infestation, property layout, and presence of children or pets to determine the appropriate, safe management approach.',
    icon: Compass
  },
  {
    step: '03',
    title: 'Targeted Management',
    tagline: 'Strategic application of calibrated control measures.',
    desc: 'Deploying targeted control solutions directly along verified travel runways and harbourage zones. Measures may include tamper-resistant locked bait stations for exterior perimeters, mechanical snap traps, and multi-catch stations placed away from food-contact surfaces.',
    icon: Wrench
  },
  {
    step: '04',
    title: 'Monitoring & Prevention',
    tagline: 'Scheduled evaluation and ongoing structural exclusion.',
    desc: 'Follow-up monitoring tracks station activity, evaluates population reduction, and provides property owners with actionable recommendations on sealing structural gaps, sanitizing food storage, and reducing harbourage to mitigate future re-entry.',
    icon: ShieldCheck
  }
];
---

<Layout
  title="Rodent Management Guide | 4-Stage Protocol in Bangalore | SLV Pest Control"
  description="Explore the professional 4-stage rodent management process in Bangalore: inspection, assessment, targeted control, and monitoring by SLV Pest Control."
  canonical="https://slvpestcontrol.com/knowledge/rodents/treatment-guide"
>
  <Header client:load activeItem="knowledge" />

  <main class="flex-1 w-full relative overflow-hidden bg-[#090a0c]">
    {/* Architectural Background Pattern */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 right-1/4 w-[500px] h-[500px] bg-[#E5A93C]/[0.06] rounded-full blur-[140px]"></div>
      <div class="absolute top-[40%] left-[-100px] w-[500px] h-[500px] bg-[#E5A93C]/[0.04] rounded-full blur-[160px]"></div>
    </div>

    {/* Breadcrumbs: Home > Knowledge Hub > Rodents > Current Page */}
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs text-zinc-400">
        <a href="/" class="hover:text-white transition">Home</a>
        <span>&gt;</span>
        <a href="/knowledge" class="hover:text-white transition">Knowledge Hub</a>
        <span>&gt;</span>
        <a href="/services/rodent-control" class="hover:text-white transition">Rodents</a>
        <span>&gt;</span>
        <span class="text-[#F6C453] font-semibold">Rodent Management Guide</span>
      </nav>
    </div>

    {/* HERO */}
    <section class="relative z-10 pt-10 sm:pt-14 pb-12 sm:pb-16 border-b border-white/[0.06]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 mb-4 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-md">
          <BookOpen class="w-3.5 h-3.5 text-[#E5A93C]" />
          <span class="text-[#E5A93C] text-xs font-extrabold tracking-[0.2em] uppercase">
            RODENT KNOWLEDGE HUB
          </span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-[1.1] mb-5 font-heading">
          The 4-Stage <span class="slv-gold-text">Rodent Management Guide</span>
        </h1>

        <p class="text-zinc-300 text-sm sm:text-base leading-relaxed max-w-2xl mx-auto mb-8 font-normal">
          Effective rodent management relies on a scientific, methodical Integrated Pest Management (IPM) approach. Learn how professional inspection, customized assessment, targeted measures, and scheduled monitoring work together.
        </p>

        <div class="inline-flex flex-wrap items-center justify-center gap-4 text-xs font-semibold">
          <a
            href="/services/rodent-control"
            class="slv-btn-primary px-6 py-3 text-xs uppercase tracking-wider inline-flex items-center gap-2"
          >
            <span>View Rodent Management</span>
            <ArrowRight class="w-4 h-4" />
          </a>
          <a
            href="tel:9180397822"
            class="slv-btn-secondary px-6 py-3 text-xs uppercase tracking-wider inline-flex items-center gap-2"
          >
            <Phone class="w-4 h-4 text-[#F6C453]" />
            <span>Call 91803 97822</span>
          </a>
        </div>
      </div>
    </section>

    {/* 4 STAGES PROCESS */}
    <section class="relative z-10 py-14 sm:py-18 border-b border-white/[0.06]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-2">
            METHODOLOGY
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
            The 4 Stages of Professional Rodent Control
          </h2>
          <p class="text-zinc-400 text-xs sm:text-sm mt-2">
            Structured protocols designed to locate harbourage, reduce active populations, and protect structures.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {managementStages.map((stage) => {
            const Icon = stage.icon;
            return (
              <div class="slv-card rounded-2xl p-6 border border-white/[0.08] hover:border-[#E5A93C]/40 transition flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between mb-4">
                    <span class="text-3xl font-black font-heading slv-gold-text">
                      {stage.step}
                    </span>
                    <div class="w-10 h-10 rounded-xl bg-white/[0.04] border border-white/[0.08] flex items-center justify-center">
                      <Icon class="w-5 h-5 text-[#E5A93C]" />
                    </div>
                  </div>

                  <h3 class="text-lg font-bold text-white mb-1 font-heading">
                    {stage.title}
                  </h3>
                  <p class="text-xs font-semibold text-[#F6C453] mb-3">
                    {stage.tagline}
                  </p>
                  <p class="text-zinc-400 text-xs leading-relaxed">
                    {stage.desc}
                  </p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* HONEST EXPECTATION SETTING (NO GUARANTEED CLAIMS) */}
    <section class="relative z-10 py-14 sm:py-18 border-b border-white/[0.06] bg-[#0c0d10]/50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="slv-card rounded-3xl p-8 sm:p-10 border border-white/[0.08]">
          <div class="flex items-start gap-4">
            <HelpCircle class="w-6 h-6 text-[#E5A93C] shrink-0 mt-0.5" />
            <div>
              <h2 class="text-xl sm:text-2xl font-bold text-white mb-3 font-heading">
                Factual Management Expectations
              </h2>
              <p class="text-zinc-300 text-xs sm:text-sm leading-relaxed mb-4">
                Because wild rodents inhabit open municipal environments, drains, and adjacent grounds across Bangalore, no pest control provider can claim that every property requires the exact same treatment or that wild rodents will never attempt to seek shelter.
              </p>
              <p class="text-zinc-300 text-xs sm:text-sm leading-relaxed mb-4">
                Treatment timelines vary naturally based on property size, surrounding environmental factors, structural integrity, and the level of resident cooperation with sanitation and entry exclusion. Sustainable rodent management is an ongoing partnership involving targeted professional interventions and diligent property upkeep.
              </p>
              <div class="pt-3 border-t border-white/[0.06] flex flex-wrap items-center gap-3 text-xs text-zinc-400">
                <span class="inline-flex items-center gap-1.5 text-zinc-300">
                  <CheckCircle2 class="w-4 h-4 text-[#E5A93C]" />
                  Customized for each premise
                </span>
                <span class="inline-flex items-center gap-1.5 text-zinc-300">
                  <CheckCircle2 class="w-4 h-4 text-[#E5A93C]" />
                  Tamper-resistant locked stations
                </span>
                <span class="inline-flex items-center gap-1.5 text-zinc-300">
                  <CheckCircle2 class="w-4 h-4 text-[#E5A93C]" />
                  Evidence-based monitoring
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* RELATED GUIDES */}
    <section class="relative z-10 py-14 sm:py-18 border-b border-white/[0.06]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-2">
            CONTINUE LEARNING
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
            More Rodent Knowledge Guides
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedArticles.map((article) => (
            <div class="slv-card rounded-2xl p-6 border border-white/[0.08] hover:border-[#E5A93C]/40 transition flex flex-col justify-between">
              <div>
                <h3 class="text-base font-bold text-white mb-2 font-heading">
                  {article.title}
                </h3>
                <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed mb-4">
                  {article.desc}
                </p>
              </div>
              <a
                href={article.href}
                class="text-xs font-bold text-[#F6C453] hover:text-white inline-flex items-center gap-1.5 transition"
              >
                <span>Read Guide</span>
                <ArrowRight class="w-3.5 h-3.5" />
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* FOOTER CTA SECTION */}
    <section class="relative z-10 py-14 sm:py-16 bg-[#0c0d10]/80">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-4">
          Ready to Implement Professional Rodent Management?
        </h2>
        <p class="text-zinc-300 text-xs sm:text-sm max-w-xl mx-auto mb-6">
          Connect with SLV Pest Control for an on-site property evaluation, tailored control strategies, and evidence-based monitoring.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            href="/services/rodent-control"
            class="slv-btn-primary px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider inline-flex items-center gap-2"
          >
            <span>View Rodent Management</span>
            <ArrowRight class="w-4 h-4" />
          </a>
          <a
            href="https://wa.me/9180397822"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 rounded-full bg-[#25D366] text-white text-xs sm:text-sm font-bold uppercase tracking-wider inline-flex items-center gap-2 shadow-md hover:bg-[#20bd5a] transition"
          >
            <MessageCircle class="w-4 h-4" />
            <span>WhatsApp 91803 97822</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingActions client:load />
</Layout>
