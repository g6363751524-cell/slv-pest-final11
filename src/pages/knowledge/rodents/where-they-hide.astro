---
import Layout from '../../../layouts/Layout.astro';
import { Header } from '../../../components/Header';
import { Footer } from '../../../components/Footer';
import { FloatingActions } from '../../../components/FloatingActions';
import {
  BookOpen,
  Search,
  Eye,
  AlertTriangle,
  ArrowRight,
  Phone,
  MessageCircle,
  Mail,
  ShieldCheck,
  Building,
  Home,
  Layers,
  Wrench,
  UtensilsCrossed,
  Warehouse
} from 'lucide-react';

const relatedArticles = [
  {
    title: 'Rodent Identification',
    desc: 'Signs of activity: droppings, gnaw marks, scratching noises, and smear trails.',
    href: '/knowledge/rodents/identification'
  },
  {
    title: 'How Rodents Enter & Spread',
    desc: 'Concealed gaps, door sweeps, utility pipes, and roofline travel paths.',
    href: '/knowledge/rodents/how-they-spread'
  },
  {
    title: 'Rodent Prevention',
    desc: 'Secure food storage, clutter elimination, waste management, and sealing.',
    href: '/knowledge/rodents/prevention'
  },
  {
    title: 'Rodent Management Guide',
    desc: 'The 4-stage management workflow: inspection, assessment, targeted control, and monitoring.',
    href: '/knowledge/rodents/treatment-guide'
  },
  {
    title: 'Rodent FAQ',
    desc: 'Answers to 12 practical questions on costs, signs, preparation, and safety.',
    href: '/knowledge/rodents/faq'
  }
];

const hidingLocations = [
  {
    title: 'Kitchens & Food Preparation Areas',
    desc: 'Concealed undersides of modular cabinetry, spaces beneath kitchen sinks where water supply and drain pipes penetrate walls, and enclosed pantry storage shelves providing immediate access to food crumbs.',
    icon: UtensilsCrossed
  },
  {
    title: 'Behind Heavy Appliances',
    desc: 'Warm motor compartments behind refrigerators, deep voids beneath cooking stoves, washing machines, and microwave stands. The heat generated by appliance compressors attracts nesting rodents.',
    icon: Layers
  },
  {
    title: 'False Ceilings & Roof Spaces',
    desc: 'Suspended false ceiling grids in apartments and commercial offices, attic voids, and roofline insulation. Roof rats (Rattus rattus) are expert climbers that prioritize elevated, undisturbed nesting zones.',
    icon: Building
  },
  {
    title: 'Storage Rooms & Cluttered Pantries',
    desc: 'Cardboard storage cartons, rarely moved utility boxes, archival paper piles, and cluttered corners that offer both nesting fiber and complete visual shielding from human traffic.',
    icon: Warehouse
  },
  {
    title: 'Internal Wall Cavities & Drywalls',
    desc: 'Hollow spaces between drywall sheets, electrical conduit raceways, and plumbing shafts that provide hidden superhighways allowing rodents to traverse multiple floors undetected.',
    icon: Wrench
  },
  {
    title: 'Garages & Basements',
    desc: 'Dark garage corners, stacked tyres, stored garden fertilizer sacks, vehicle engine bays, and perimeter sump pump pits where external doors or shutter gaps permit entry.',
    icon: Home
  },
  {
    title: 'Utility Rooms & Laundry Enclosures',
    desc: 'Water heater alcoves, washing machine drain connections, electrical panel closets, and inverter battery cabinets where warm wiring and condensation moisture congregate.',
    icon: Search
  },
  {
    title: 'Other Sheltered Crawlspaces & Ducts',
    desc: 'Sub-floor voids, air-conditioning ventilation chases, elevator shafts, outdoor garden compost piles, and drainage inspection chambers connected directly to city sewer lines.',
    icon: ShieldCheck
  }
];
---

<Layout
  title="Where Rodents Hide | Common Harbourage Locations in Bangalore | SLV Pest Control"
  description="Discover where rats and mice hide inside Bangalore homes, apartments, and commercial facilities: kitchens, false ceilings, wall cavities, and utility rooms."
  canonical="https://slvpestcontrol.com/knowledge/rodents/where-they-hide"
>
  <Header client:load activeItem="knowledge" />

  <main class="flex-1 w-full relative overflow-hidden bg-[#090a0c]">
    {/* Architectural Background Pattern */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 right-1/4 w-[500px] h-[500px] bg-[#E5A93C]/[0.06] rounded-full blur-[140px]"></div>
      <div class="absolute top-[40%] left-[-100px] w-[500px] h-[500px] bg-[#E5A93C]/[0.04] rounded-full blur-[160px]"></div>
    </div>

    {/* Breadcrumbs: Home > Knowledge Hub > Rodents > Current Page */}
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs text-zinc-400">
        <a href="/" class="hover:text-white transition">Home</a>
        <span>&gt;</span>
        <a href="/knowledge" class="hover:text-white transition">Knowledge Hub</a>
        <span>&gt;</span>
        <a href="/services/rodent-control" class="hover:text-white transition">Rodents</a>
        <span>&gt;</span>
        <span class="text-[#F6C453] font-semibold">Where Rodents Hide</span>
      </nav>
    </div>

    {/* HERO */}
    <section class="relative z-10 pt-10 sm:pt-14 pb-12 sm:pb-16 border-b border-white/[0.06]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 mb-4 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-md">
          <BookOpen class="w-3.5 h-3.5 text-[#E5A93C]" />
          <span class="text-[#E5A93C] text-xs font-extrabold tracking-[0.2em] uppercase">
            RODENT KNOWLEDGE HUB
          </span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-[1.1] mb-5 font-heading">
          Where Rodents Hide in <span class="slv-gold-text">Bangalore Properties</span>
        </h1>

        <p class="text-zinc-300 text-sm sm:text-base leading-relaxed max-w-2xl mx-auto mb-8 font-normal">
          Rodents seek dark, quiet harbourages located near food and water sources. Understanding where rats and mice shelter enables targeted property inspection and effective management placement.
        </p>

        <div class="inline-flex flex-wrap items-center justify-center gap-4 text-xs font-semibold">
          <a
            href="/services/rodent-control"
            class="slv-btn-primary px-6 py-3 text-xs uppercase tracking-wider inline-flex items-center gap-2"
          >
            <span>Get Rodent Inspection</span>
            <ArrowRight class="w-4 h-4" />
          </a>
          <a
            href="tel:9180397822"
            class="slv-btn-secondary px-6 py-3 text-xs uppercase tracking-wider inline-flex items-center gap-2"
          >
            <Phone class="w-4 h-4 text-[#F6C453]" />
            <span>Call 91803 97822</span>
          </a>
        </div>
      </div>
    </section>

    {/* LOCATIONS GRID */}
    <section class="relative z-10 py-14 sm:py-18 border-b border-white/[0.06]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-2">
            PRIMARY HARBOURAGES
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
            8 Common Sheltered Spaces Rodents Inhabit
          </h2>
          <p class="text-zinc-400 text-xs sm:text-sm mt-2">
            Inspect these high-risk areas across residential homes and commercial buildings.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {hidingLocations.map((loc) => {
            const Icon = loc.icon;
            return (
              <div class="slv-card rounded-2xl p-6 sm:p-7 border border-white/[0.08] hover:border-[#E5A93C]/40 transition flex gap-5 items-start">
                <div class="w-12 h-12 rounded-xl bg-[#E5A93C]/10 border border-[#E5A93C]/20 flex items-center justify-center shrink-0 mt-1">
                  <Icon class="w-6 h-6 text-[#E5A93C]" />
                </div>
                <div>
                  <h3 class="text-lg font-bold text-white mb-2 font-heading">
                    {loc.title}
                  </h3>
                  <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed">
                    {loc.desc}
                  </p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* PRACTICAL INSPECTION CHECKLIST */}
    <section class="relative z-10 py-14 sm:py-18 border-b border-white/[0.06] bg-[#0c0d10]/50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="slv-card rounded-3xl p-8 sm:p-10 border border-white/[0.08]">
          <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-2">
            HOW TO INSPECT
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-4">
            Safe Inspection Tips for Property Owners
          </h2>
          <p class="text-zinc-300 text-xs sm:text-sm leading-relaxed mb-6">
            When checking potential harbourage spots, avoid inserting bare hands into concealed cavities or behind appliances where sharp gnawed wires or nesting debris may be present. Always use a strong flashlight and wear gloves when examining storage boxes or baseboard conduits.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 items-center justify-between pt-4 border-t border-white/[0.06]">
            <span class="text-xs text-zinc-400">
              Need a professional structural survey of your concealed roof or wall cavities?
            </span>
            <a
              href="/services/rodent-control"
              class="slv-btn-primary px-6 py-2.5 text-xs font-bold uppercase tracking-wider inline-flex items-center gap-2 shrink-0"
            >
              <span>Get Rodent Inspection</span>
              <ArrowRight class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* RELATED GUIDES */}
    <section class="relative z-10 py-14 sm:py-18 border-b border-white/[0.06]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-2">
            CONTINUE LEARNING
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
            More Rodent Knowledge Guides
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedArticles.map((article) => (
            <div class="slv-card rounded-2xl p-6 border border-white/[0.08] hover:border-[#E5A93C]/40 transition flex flex-col justify-between">
              <div>
                <h3 class="text-base font-bold text-white mb-2 font-heading">
                  {article.title}
                </h3>
                <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed mb-4">
                  {article.desc}
                </p>
              </div>
              <a
                href={article.href}
                class="text-xs font-bold text-[#F6C453] hover:text-white inline-flex items-center gap-1.5 transition"
              >
                <span>Read Guide</span>
                <ArrowRight class="w-3.5 h-3.5" />
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* FOOTER CTA SECTION */}
    <section class="relative z-10 py-14 sm:py-16 bg-[#0c0d10]/80">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-4">
          Suspect Rodents are Nesting in Concealed Spaces?
        </h2>
        <p class="text-zinc-300 text-xs sm:text-sm max-w-xl mx-auto mb-6">
          Our certified technicians identify hidden nesting cavities and deploy tamper-resistant stations to protect your property.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            href="/services/rodent-control"
            class="slv-btn-primary px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider inline-flex items-center gap-2"
          >
            <span>Get Rodent Inspection</span>
            <ArrowRight class="w-4 h-4" />
          </a>
          <a
            href="https://wa.me/9180397822"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 rounded-full bg-[#25D366] text-white text-xs sm:text-sm font-bold uppercase tracking-wider inline-flex items-center gap-2 shadow-md hover:bg-[#20bd5a] transition"
          >
            <MessageCircle class="w-4 h-4" />
            <span>WhatsApp 91803 97822</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingActions client:load />
</Layout>
