---
import Layout from '../../layouts/Layout.astro';
import { Header } from '../../components/Header';
import { Footer } from '../../components/Footer';
import { FloatingActions } from '../../components/FloatingActions';
import {
  Calendar,
  Sun,
  CloudRain,
  Snowflake,
  Wind,
  ShieldCheck,
  AlertTriangle,
  ArrowRight,
  Phone,
  MessageCircle,
  ChevronRight,
  CheckCircle2,
  Bug,
  Thermometer,
  Droplets,
  ExternalLink,
  Sparkles,
  Leaf
} from 'lucide-react';

const seasonsData = [
  {
    id: 'monsoon',
    number: '01',
    season: 'Monsoon Season',
    period: 'June – September',
    climateTag: 'High Rainfall & High Humidity (>80%)',
    iconColor: 'text-cyan-400',
    borderColor: 'border-cyan-500/30',
    bgColor: 'bg-cyan-500/5',
    headline: 'Mosquitoes, Sewer Cockroaches & Subterranean Termite Swarms',
    overview: 'Bangalore receives substantial rainfall during the south-west monsoon. High atmospheric humidity combined with accumulated storm runoff creates rapid standing water reservoirs, driving pest displacement and accelerated breeding.',
    primaryPests: [
      { name: 'Mosquitoes (Aedes & Culex)', link: '/services/mosquitoes', note: 'Breeding in terrace drain sumps & balcony plant saucers' },
      { name: 'American Cockroaches', link: '/services/cockroach-control', note: 'Flooded municipal sewer lines force large sewer roaches up into kitchens' },
      { name: 'Subterranean Termite Swarmers', link: '/services/termites', note: 'Alate reproductives emerge in twilight swarms following early showers' }
    ],
    environmentalRisks: [
      'Standing stormwater in terrace gutters, construction trenches, and balcony drip saucers facilitates rapid 7-day Aedes mosquito larval cycles.',
      'Saturated soil foundations force subterranean termite alates to discard wings and initiate new colonies inside building expansion joints.',
      'Surcharge in city storm drains pushes sewer cockroaches upwards through untreated floor traps and kitchen utility drains.'
    ],
    preventionRecommendations: [
      'Weekly inspection routine: Empty, scrub, and invert balcony plant drip trays, discarded tires, and terrace water containers.',
      'Fit all bathroom, balcony, and utility floor traps with stainless steel cockroach-proof jali traps.',
      'Keep openable windows shielded with 20-mesh insect netting; turn off external porch lights at dusk if termite swarmers are observed.',
      'Inspect external plinth walls for emerging earthen mud tubes connecting wet soil to door jamb timber.'
    ],
    relatedGuide: { title: 'Where Mosquitoes Breed in Bangalore', href: '/knowledge/mosquitoes/where-they-breed' }
  },
  {
    id: 'post-monsoon',
    number: '02',
    season: 'Post-Monsoon & Autumn',
    period: 'October – November',
    climateTag: 'Cooling Evenings & Transitional Temperatures (18°C–26°C)',
    iconColor: 'text-amber-400',
    borderColor: 'border-amber-500/30',
    bgColor: 'bg-amber-500/5',
    headline: 'Indoor Rodent Ingress & Travel-Linked Bed Bug Spread',
    overview: 'As monsoon rains taper off and nighttime temperatures begin to drop across the Deccan Plateau, outdoor rodents seek warm, insulated indoor shelter. Autumn business and festive holiday travel dramatically accelerates bed bug dispersal.',
    primaryPests: [
      { name: 'Rodents (Rats & Mice)', link: '/services/rodents', note: 'Roof rats and house mice migrating into false ceilings & modular kitchens' },
      { name: 'Bed Bugs', link: '/services/bed-bugs', note: 'Cross-contamination via travel luggage, hotel stays & holiday visitors' },
      { name: 'Fleas', link: '/services/fleas', note: 'Proliferating in carpet pile layers as pet indoor resting hours increase' }
    ],
    environmentalRisks: [
      'Nighttime temperature drops force outdoor rodents to gnaw through perimeter PVC pipe gaps, seeking warmth near refrigerator compressors.',
      'Corrugated cardboard packing cartons from festive shopping sprees introduce hitchhiking roaches and bed bug nymphs into living quarters.',
      'High indoor footfall and guest stays during festival months create opportunities for passive parasitic transfers.'
    ],
    preventionRecommendations: [
      'Seal all structural perimeter pipe wall penetrations larger than 6mm using stainless steel wire mesh (coarse steel wool) and silicone mortar.',
      'Inspect hotel suitcases in the bathroom or tiled laundry area immediately upon returning from holiday travel before unpacking in bedrooms.',
      'Wash travel garments and bed linen in hot water exceeding 60°C to eliminate unnoticed nymphal hitchhikers.',
      'Maintain covered garbage bins and clear fallen garden fruits and seeds that attract foraging outdoor rats.'
    ],
    relatedGuide: { title: 'How Rodents Enter & Spread Through Buildings', href: '/knowledge/rodents/how-they-spread' }
  },
  {
    id: 'winter',
    number: '03',
    season: 'Winter Season',
    period: 'December – February',
    climateTag: 'Cool Nights (14°C–18°C) & Dry Ambient Air',
    iconColor: 'text-blue-400',
    borderColor: 'border-blue-500/30',
    bgColor: 'bg-blue-500/5',
    headline: 'Indoor Rodent Nesting, Heavy Flea Pupation & Wood Borers',
    overview: 'Bangalore winters bring crisp, dry evenings. Pests that gained entry during autumn establish permanent indoor nesting colonies near localized warmth sources, while indoor heating creates microclimates for pet fleas and timber beetles.',
    primaryPests: [
      { name: 'Indoor Rodent Nesting', link: '/services/rodents', note: 'Nesting colonies established in false ceiling voids & kitchen appliance bases' },
      { name: 'Fleas & Ticks', link: '/services/fleas', note: 'Concentrated pupation inside pet bedding, heavy wool rugs & upholstery' },
      { name: 'Wood Borers', link: '/services/wood-borer-control', note: 'Internal larval tunneling weakening furniture frames & wooden fixtures' }
    ],
    environmentalRisks: [
      'Rodents nesting inside false ceilings gnaw electrical wiring and HVAC duct insulation, posing serious structural fire hazards.',
      'Pets spending extended hours resting indoors on carpets and blankets accelerate flea egg shedding and pupal cocoon development.',
      'Low outdoor humidity leads property owners to seal windows, reducing ventilation and intensifying indoor allergen build-up.'
    ],
    preventionRecommendations: [
      'Transfer all pantry dry grains, cereal boxes, and dry pet food into rigid glass or heavy-gauge tin storage containers.',
      'High-suction vacuuming of carpets, baseboard edges, and underneath sofas twice weekly to extract dormant flea cocoons.',
      'Wash pet bedding cushions and blankets weekly at high wash cycles (>60°C).',
      'Regularly inspect wooden wardrobes and plywood cabinetry for piles of yellow flour-like wood dust (frass).'
    ],
    relatedGuide: { title: 'Flea Prevention & Carpet Care Protocol', href: '/knowledge/fleas/prevention' }
  },
  {
    id: 'summer',
    number: '04',
    season: 'Summer Season',
    period: 'March – May',
    climateTag: 'High Heat (30°C–36°C) & Pre-Monsoon Convective Showers',
    iconColor: 'text-amber-500',
    borderColor: 'border-amber-500/30',
    bgColor: 'bg-amber-500/5',
    headline: 'Brown Dog Ticks, Foraging Ant Trails & Accelerated Cockroach Metabolism',
    overview: 'Elevated ambient temperatures significantly accelerate insect metabolic rates and shorten egg incubation cycles. Dry outdoor conditions drive foraging ant colonies into indoor kitchens searching for water, while ticks proliferate rapidly in gardens.',
    primaryPests: [
      { name: 'Brown Dog Ticks', link: '/services/tick-control', note: 'Rapid reproduction cycles along compound walls, kennel woodwork & pet fur' },
      { name: 'Foraging Ants (Black & Carpenter)', link: '/services/ant-control', note: 'Invasive columns scouting kitchens for moisture, syrups & grease' },
      { name: 'High-Metabolism Cockroaches', link: '/services/cockroach-control', note: 'Shortened egg-to-adult incubation cycles in warm modular cabinets' }
    ],
    environmentalRisks: [
      'Ambient heat shortens German cockroach ootheca hatch times by up to 30%, leading to sudden population explosions.',
      'Brown dog tick eggs hatch en masse in warm exterior masonry cracks, crawling vertically up walls and fences to latch onto dogs.',
      'Outdoor soil desiccation drives ant colonies through foundation cracks directly into kitchen countertops and water filters.'
    ],
    preventionRecommendations: [
      'Ensure domestic dogs receive veterinarian-prescribed topical spot-on or oral tick preventatives without lapse.',
      'Seal exterior perimeter masonry cracks, compound wall crevices, and window sill gaps with silicone sealant.',
      'Wipe kitchen countertops and dining tables nightly with warm soapy water; eliminate sugar residue and sticky spills immediately.',
      'Promptly fix dripping faucets and weeping under-sink valves to remove indoor drinking water sources for foraging ants.'
    ],
    relatedGuide: { title: 'Tick Prevention & Kennel Hygiene Checklist', href: '/knowledge/ticks/prevention' }
  }
];

const quarterlyCalendar = [
  { quarter: 'Q1 (Jan – Mar)', season: 'Late Winter → Early Summer', highestRisk: 'Rodents & Ants', secondary: 'Fleas & Cockroaches', priorityAction: 'Pantry sealing & foundation crack caulking', serviceLink: '/services/ant-control' },
  { quarter: 'Q2 (Apr – Jun)', season: 'Summer → Pre-Monsoon', highestRisk: 'Brown Dog Ticks & Termite Swarms', secondary: 'Ants & Mosquitoes', priorityAction: 'Pet tick prevention & swarmer monitoring', serviceLink: '/services/tick-control' },
  { quarter: 'Q3 (Jul – Sep)', season: 'Peak Monsoon', highestRisk: 'Mosquitoes & Sewer Cockroaches', secondary: 'Subterranean Termites', priorityAction: 'Stagnant water removal & floor trap jalis', serviceLink: '/services/mosquitoes' },
  { quarter: 'Q4 (Oct – Dec)', season: 'Post-Monsoon → Early Winter', highestRisk: 'Rodent Ingress & Bed Bugs', secondary: 'Fleas & Wood Borers', priorityAction: 'Exterior pipe exclusion & luggage quarantine', serviceLink: '/services/rodents' }
];
---

<Layout
  title="Bangalore Seasonal Pest Guide | Quarterly Pest Activity & Calendar | SLV Pest Control"
  description="Understand how Bangalore's seasons and climate fluctuations impact pest activity. Year-round risk calendars and practical seasonal prevention tips."
  canonical="https://slvpestcontrol.com/knowledge/seasonal"
>
  <Header client:load activeItem="knowledge" />

  <main class="relative bg-[#08090b] text-white min-h-screen overflow-hidden">
    {/* Subtle Ambient Glows and Hexagonal Pattern */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[550px] bg-[radial-gradient(ellipse_at_center,_rgba(229,169,60,0.08)_0%,_rgba(10,12,16,0)_70%)]"></div>
      <div class="absolute top-[35%] -left-[200px] w-[600px] h-[600px] bg-[radial-gradient(circle,_rgba(6,182,212,0.04)_0%,_rgba(10,12,16,0)_70%)]"></div>
      <div class="absolute bottom-[20%] -right-[200px] w-[600px] h-[600px] bg-[radial-gradient(circle,_rgba(229,169,60,0.05)_0%,_rgba(10,12,16,0)_70%)]"></div>
      <div class="absolute inset-0 opacity-[0.025] slv-hex-bg"></div>
    </div>

    {/* BREADCRUMB NAVIGATION */}
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-zinc-400">
        <a href="/" class="hover:text-white transition">Home</a>
        <ChevronRight class="w-3.5 h-3.5 text-zinc-600" />
        <a href="/knowledge" class="hover:text-white transition">Knowledge Hub</a>
        <ChevronRight class="w-3.5 h-3.5 text-zinc-600" />
        <span class="text-[#F6C453] font-semibold">Seasonal Pest Guide</span>
      </nav>
    </div>

    {/* HERO SECTION */}
    <section class="relative z-10 pt-8 sm:pt-12 pb-10 border-b border-white/[0.06]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        {/* Module Badge */}
        <div class="inline-flex items-center gap-2 mb-4 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-md">
          <Calendar class="w-3.5 h-3.5 text-[#E5A93C]" />
          <span class="text-[#E5A93C] text-xs font-extrabold tracking-[0.22em] uppercase">
            Module 03 • Bangalore Climate Intelligence
          </span>
        </div>

        {/* Heading verbatim from mockup */}
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-[1.1] mb-3 font-heading">
          <span class="slv-gold-text">Seasonal</span> Pest Guide
        </h1>

        {/* Subtitle verbatim from mockup */}
        <p class="text-zinc-300 text-sm sm:text-base leading-relaxed max-w-2xl mx-auto mb-6 font-normal">
          Understand seasonal pest activity and how to stay protected.
        </p>

        {/* Four Main Navigation Pills */}
        <div class="flex flex-wrap items-center justify-center gap-2 text-xs font-semibold mb-8">
          <a
            href="/knowledge"
            class="px-3.5 py-2 rounded-xl bg-white/[0.04] border border-white/[0.1] text-zinc-300 hover:text-white hover:border-[#F6C453] transition font-bold"
          >
            1. Knowledge Hub
          </a>
          <a
            href="/knowledge/pests"
            class="px-3.5 py-2 rounded-xl bg-white/[0.04] border border-white/[0.1] text-zinc-300 hover:text-white hover:border-[#F6C453] transition font-bold"
          >
            2. Pest Library
          </a>
          <a
            href="/knowledge/treatment"
            class="px-3.5 py-2 rounded-xl bg-white/[0.04] border border-white/[0.1] text-zinc-300 hover:text-white hover:border-[#F6C453] transition font-bold"
          >
            3. Treatment &amp; Prevention
          </a>
          <a
            href="/knowledge/seasonal"
            class="px-3.5 py-2 rounded-xl bg-[#E5A93C]/15 border border-[#E5A93C]/40 text-[#F6C453] font-bold shadow-[0_0_15px_rgba(229,169,60,0.15)]"
          >
            4. Seasonal Pest Guide
          </a>
        </div>

        {/* Fast Action Buttons */}
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            href="tel:9180397822"
            class="slv-btn-primary px-5 py-2.5 text-xs sm:text-sm font-bold uppercase tracking-wider inline-flex items-center gap-2 shadow-[0_0_20px_rgba(229,169,60,0.3)]"
          >
            <Phone class="w-4 h-4 text-[#1a1202]" />
            <span>Call: 91803 97822</span>
          </a>
          <a
            href="https://wa.me/9180397822?text=Hello%20SLV%20Pest%20Control%2C%20I%20have%20questions%20about%20seasonal%20pest%20control"
            target="_blank"
            rel="noopener noreferrer"
            class="slv-btn-secondary px-5 py-2.5 text-xs sm:text-sm font-bold uppercase tracking-wider inline-flex items-center gap-2 border-emerald-500/30 text-emerald-400 hover:text-white hover:border-emerald-400 hover:bg-emerald-500/10"
          >
            <MessageCircle class="w-4 h-4 text-emerald-400" />
            <span>WhatsApp Consultation</span>
          </a>
          <a
            href="#calendar-matrix"
            class="px-4 py-2.5 rounded-xl bg-white/[0.04] border border-white/[0.1] text-xs font-bold text-zinc-300 hover:text-white hover:bg-white/[0.08] transition inline-flex items-center gap-1.5"
          >
            <span>Jump to Quarterly Matrix</span>
            <ArrowRight class="w-3.5 h-3.5 text-[#E5A93C]" />
          </a>
        </div>
      </div>
    </section>

    {/* MOCKUP SCREEN 4: 4 SEASONS CARDS ROW (1 ROW × 4 COLUMNS) */}
    <section class="relative z-10 py-10 border-b border-white/[0.06] bg-black/20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {/* 1. Summer */}
          <a
            href="#summer"
            class="slv-card rounded-2xl overflow-hidden border border-white/[0.08] hover:border-amber-400/60 transition-all flex flex-col justify-between group bg-[#0d0f14]/90"
          >
            <div class="h-36 relative overflow-hidden bg-gradient-to-br from-amber-600/30 via-orange-950/40 to-black/80 flex items-center justify-center">
              <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(245,158,11,0.25)_0%,_transparent_70%)]"></div>
              <div class="w-14 h-14 rounded-2xl bg-amber-500/20 border border-amber-500/40 flex items-center justify-center relative z-10 group-hover:scale-110 transition-transform shadow-[0_0_20px_rgba(245,158,11,0.3)]">
                <Sun class="w-7 h-7 text-amber-400" />
              </div>
            </div>
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition mb-1 font-heading flex items-center justify-between">
                  <span>Summer</span>
                  <ArrowRight class="w-4 h-4 text-amber-400 opacity-0 group-hover:opacity-100 transition-opacity" />
                </h3>
                <p class="text-xs text-zinc-300 leading-relaxed mb-4">
                  Heat and dryness increase pest activity.
                </p>
              </div>
              <div class="pt-3 border-t border-white/[0.06] flex items-center justify-between">
                <span class="text-[11px] font-mono text-amber-300 font-bold">March – May</span>
                <div class="w-8 h-8 rounded-full bg-amber-500/20 border border-amber-500/40 text-amber-400 flex items-center justify-center group-hover:bg-amber-500 group-hover:text-black transition-all">
                  <ArrowRight class="w-4 h-4 font-bold" />
                </div>
              </div>
            </div>
          </a>

          {/* 2. Monsoon */}
          <a
            href="#monsoon"
            class="slv-card rounded-2xl overflow-hidden border border-white/[0.08] hover:border-blue-400/60 transition-all flex flex-col justify-between group bg-[#0d0f14]/90"
          >
            <div class="h-36 relative overflow-hidden bg-gradient-to-br from-blue-700/30 via-cyan-950/40 to-black/80 flex items-center justify-center">
              <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(59,130,246,0.25)_0%,_transparent_70%)]"></div>
              <div class="w-14 h-14 rounded-2xl bg-blue-500/20 border border-blue-500/40 flex items-center justify-center relative z-10 group-hover:scale-110 transition-transform shadow-[0_0_20px_rgba(59,130,246,0.3)]">
                <CloudRain class="w-7 h-7 text-blue-400" />
              </div>
            </div>
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-lg font-bold text-white group-hover:text-blue-400 transition mb-1 font-heading flex items-center justify-between">
                  <span>Monsoon</span>
                  <ArrowRight class="w-4 h-4 text-blue-400 opacity-0 group-hover:opacity-100 transition-opacity" />
                </h3>
                <p class="text-xs text-zinc-300 leading-relaxed mb-4">
                  High moisture attracts many pests.
                </p>
              </div>
              <div class="pt-3 border-t border-white/[0.06] flex items-center justify-between">
                <span class="text-[11px] font-mono text-blue-300 font-bold">June – September</span>
                <div class="w-8 h-8 rounded-full bg-blue-500/20 border border-blue-500/40 text-blue-400 flex items-center justify-center group-hover:bg-blue-500 group-hover:text-white transition-all">
                  <ArrowRight class="w-4 h-4 font-bold" />
                </div>
              </div>
            </div>
          </a>

          {/* 3. Post-Monsoon */}
          <a
            href="#post-monsoon"
            class="slv-card rounded-2xl overflow-hidden border border-white/[0.08] hover:border-emerald-400/60 transition-all flex flex-col justify-between group bg-[#0d0f14]/90"
          >
            <div class="h-36 relative overflow-hidden bg-gradient-to-br from-emerald-600/30 via-teal-950/40 to-black/80 flex items-center justify-center">
              <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(16,185,129,0.25)_0%,_transparent_70%)]"></div>
              <div class="w-14 h-14 rounded-2xl bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center relative z-10 group-hover:scale-110 transition-transform shadow-[0_0_20px_rgba(16,185,129,0.3)]">
                <Leaf class="w-7 h-7 text-emerald-400" />
              </div>
            </div>
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-lg font-bold text-white group-hover:text-emerald-400 transition mb-1 font-heading flex items-center justify-between">
                  <span>Post-Monsoon</span>
                  <ArrowRight class="w-4 h-4 text-emerald-400 opacity-0 group-hover:opacity-100 transition-opacity" />
                </h3>
                <p class="text-xs text-zinc-300 leading-relaxed mb-4">
                  Peak activity for termites and ants.
                </p>
              </div>
              <div class="pt-3 border-t border-white/[0.06] flex items-center justify-between">
                <span class="text-[11px] font-mono text-emerald-300 font-bold">October – November</span>
                <div class="w-8 h-8 rounded-full bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 flex items-center justify-center group-hover:bg-emerald-500 group-hover:text-black transition-all">
                  <ArrowRight class="w-4 h-4 font-bold" />
                </div>
              </div>
            </div>
          </a>

          {/* 4. Winter */}
          <a
            href="#winter"
            class="slv-card rounded-2xl overflow-hidden border border-white/[0.08] hover:border-cyan-400/60 transition-all flex flex-col justify-between group bg-[#0d0f14]/90"
          >
            <div class="h-36 relative overflow-hidden bg-gradient-to-br from-cyan-700/30 via-slate-950/40 to-black/80 flex items-center justify-center">
              <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(6,182,212,0.25)_0%,_transparent_70%)]"></div>
              <div class="w-14 h-14 rounded-2xl bg-cyan-500/20 border border-cyan-500/40 flex items-center justify-center relative z-10 group-hover:scale-110 transition-transform shadow-[0_0_20px_rgba(6,182,212,0.3)]">
                <Snowflake class="w-7 h-7 text-cyan-400" />
              </div>
            </div>
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-lg font-bold text-white group-hover:text-cyan-400 transition mb-1 font-heading flex items-center justify-between">
                  <span>Winter</span>
                  <ArrowRight class="w-4 h-4 text-cyan-400 opacity-0 group-hover:opacity-100 transition-opacity" />
                </h3>
                <p class="text-xs text-zinc-300 leading-relaxed mb-4">
                  Indoor pest activity can increase.
                </p>
              </div>
              <div class="pt-3 border-t border-white/[0.06] flex items-center justify-between">
                <span class="text-[11px] font-mono text-cyan-300 font-bold">December – February</span>
                <div class="w-8 h-8 rounded-full bg-cyan-500/20 border border-cyan-500/40 text-cyan-400 flex items-center justify-center group-hover:bg-cyan-500 group-hover:text-black transition-all">
                  <ArrowRight class="w-4 h-4 font-bold" />
                </div>
              </div>
            </div>
          </a>
        </div>
      </div>
    </section>


    {/* MAIN CONTENT AREA */}
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">

      {/* 4 DETAILED SEASONAL MODULES */}
      <section class="space-y-10">
        <div class="text-center max-w-2xl mx-auto mb-6">
          <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-2 font-mono">
            QUARTERLY BIOLOGICAL PATTERNS
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
            Seasonal Influx Breakdown
          </h2>
          <p class="text-zinc-400 text-xs sm:text-sm mt-1">
            Temperature, moisture, and rainfall shifts directly control pest metabolism and habitat movement.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          {seasonsData.map((item) => (
            <div
              id={item.id}
              class="slv-card rounded-3xl p-6 sm:p-8 border border-white/[0.08] hover:border-[#E5A93C]/40 transition-all flex flex-col justify-between bg-[#0d0f13]/90 relative overflow-hidden group"
            >
              <div>
                {/* Header */}
                <div class="flex items-center justify-between mb-4 border-b border-white/[0.06] pb-3">
                  <div class="flex items-center gap-2.5">
                    <span class="text-xs font-mono font-bold text-[#F6C453] bg-[#E5A93C]/10 px-2 py-0.5 rounded">
                      Phase {item.number}
                    </span>
                    <h3 class="text-lg sm:text-xl font-bold text-white font-heading">
                      {item.season}
                    </h3>
                  </div>
                  <span class="text-xs font-bold text-[#FFE08A] font-mono">
                    {item.period}
                  </span>
                </div>

                {/* Climate Tag */}
                <div class="inline-flex items-center gap-1.5 mb-3 px-2.5 py-1 rounded-md bg-white/[0.03] border border-white/[0.06] text-xs text-zinc-300">
                  <Thermometer class="w-3.5 h-3.5 text-[#E5A93C]" />
                  <span>{item.climateTag}</span>
                </div>

                {/* Focus Headline */}
                <h4 class="text-sm font-bold text-white mb-2 leading-snug">
                  {item.headline}
                </h4>

                <p class="text-zinc-300 text-xs sm:text-sm leading-relaxed mb-5">
                  {item.overview}
                </p>

                {/* Primary Pests Badges */}
                <div class="mb-5">
                  <span class="text-[11px] font-bold text-[#F6C453] uppercase tracking-wider block mb-2 font-mono">
                    High-Risk Species in this Phase:
                  </span>
                  <div class="space-y-1.5">
                    {item.primaryPests.map((pest) => (
                      <div class="p-2.5 rounded-xl bg-white/[0.02] border border-white/[0.04] flex items-center justify-between text-xs">
                        <div>
                          <strong class="text-white block font-medium">{pest.name}</strong>
                          <span class="text-[11px] text-zinc-400">{pest.note}</span>
                        </div>
                        <a href={pest.link} class="text-[11px] text-[#F6C453] hover:underline font-bold shrink-0 ml-2">
                          Service →
                        </a>
                      </div>
                    ))}
                  </div>
                </div>

                {/* Environmental Risks */}
                <div class="mb-5">
                  <span class="text-[11px] font-bold text-rose-400 uppercase tracking-wider block mb-2 font-mono">
                    Environmental Drivers &amp; Risks:
                  </span>
                  <ul class="space-y-1.5 text-xs text-zinc-400 pl-4 list-disc">
                    {item.environmentalRisks.map((risk) => (
                      <li>{risk}</li>
                    ))}
                  </ul>
                </div>

                {/* Recommendations */}
                <div class="p-4 rounded-xl bg-black/40 border border-white/[0.05] text-xs mb-4">
                  <span class="text-[11px] font-bold text-emerald-400 uppercase tracking-wider block mb-2 font-mono flex items-center gap-1.5">
                    <CheckCircle2 class="w-3.5 h-3.5 text-emerald-400" />
                    <span>Recommended Preventive Actions:</span>
                  </span>
                  <ul class="space-y-1.5 text-zinc-300 pl-4 list-disc">
                    {item.preventionRecommendations.map((rec) => (
                      <li>{rec}</li>
                    ))}
                  </ul>
                </div>
              </div>

              {/* Related Guide Link */}
              <div class="pt-3 border-t border-white/[0.06] flex items-center justify-between text-xs">
                <a href={item.relatedGuide.href} class="text-[#F6C453] hover:underline font-bold flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
                  <span>Deep Dive: {item.relatedGuide.title}</span>
                  <ArrowRight class="w-3 h-3 text-[#E5A93C]" />
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* QUARTERLY CALENDAR MATRIX */}
      <section id="calendar-matrix" class="scroll-mt-36">
        <div class="slv-card rounded-3xl p-8 sm:p-12 border border-white/[0.08] bg-[#0c0d10]/90">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 pb-6 border-b border-white/[0.06]">
            <div>
              <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-1 font-mono">
                ANNUAL MANAGEMENT MATRIX
              </span>
              <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
                Bangalore Quarterly Pest Calendar
              </h2>
            </div>
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-[#FFE08A] text-xs font-bold self-start md:self-auto">
              <Calendar class="w-4 h-4" />
              <span>Year-Round Protection Blueprint</span>
            </div>
          </div>

          <p class="text-zinc-300 text-xs sm:text-sm leading-relaxed mb-6">
            Use this comparative timeline to schedule preemptive pest inspections before seasonal breeding peaks occur across Bangalore residential apartments, villas, and commercial facilities.
          </p>

          {/* Desktop Table / Mobile Cards */}
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-zinc-300 border-collapse">
              <thead>
                <tr class="border-b border-white/[0.08] text-[#F6C453] font-mono uppercase text-[11px]">
                  <th class="py-3 px-4">Period</th>
                  <th class="py-3 px-4">Climatic Phase</th>
                  <th class="py-3 px-4">Primary Risk Pests</th>
                  <th class="py-3 px-4">Secondary Pests</th>
                  <th class="py-3 px-4">Priority Action</th>
                  <th class="py-3 px-4 text-right">Service</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/[0.04]">
                {quarterlyCalendar.map((row) => (
                  <tr class="hover:bg-white/[0.02] transition">
                    <td class="py-3.5 px-4 font-bold text-white whitespace-nowrap">{row.quarter}</td>
                    <td class="py-3.5 px-4 text-zinc-400 whitespace-nowrap">{row.season}</td>
                    <td class="py-3.5 px-4 font-semibold text-rose-300">{row.highestRisk}</td>
                    <td class="py-3.5 px-4 text-zinc-400">{row.secondary}</td>
                    <td class="py-3.5 px-4 text-zinc-300">{row.priorityAction}</td>
                    <td class="py-3.5 px-4 text-right whitespace-nowrap">
                      <a href={row.serviceLink} class="text-[#F6C453] hover:underline font-bold inline-flex items-center gap-1">
                        <span>Book</span>
                        <ArrowRight class="w-3 h-3" />
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      {/* SEASONAL FAQ / ASSISTANCE CALLOUT */}
      <section class="py-6">
        <div class="bg-[#12141a] border border-[#E5A93C]/30 rounded-3xl p-8 flex flex-col md:flex-row items-center gap-6 shadow-[0_12px_40px_rgba(0,0,0,0.4)]">
          <div class="w-16 h-16 rounded-2xl bg-[#E5A93C]/10 border border-[#E5A93C]/30 flex items-center justify-center shrink-0">
            <Calendar class="w-8 h-8 text-[#E5A93C]" />
          </div>
          <div class="flex-1 text-center md:text-left">
            <h3 class="text-lg sm:text-xl font-bold text-white mb-2 font-heading">
              Need Seasonal Protection for Your Bangalore Property?
            </h3>
            <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed mb-4">
              Our Annual Maintenance Contracts (AMC) align 3 to 4 scheduled intervention treatments with Bangalore&apos;s seasonal pest influxes. Stay proactive against monsoon mosquitoes, post-monsoon rodents, and summer ticks without recurring emergency expenses.
            </p>
            <div class="flex flex-wrap items-center justify-center md:justify-start gap-3">
              <a
                href="tel:9180397822"
                class="slv-btn-primary px-5 py-2.5 text-xs font-bold uppercase tracking-wider inline-flex items-center gap-2"
              >
                <Phone class="w-3.5 h-3.5 text-[#1a1202]" />
                <span>Call: 91803 97822</span>
              </a>
              <a
                href="https://wa.me/9180397822?text=Hello%20SLV%20Pest%20Control%2C%20I%20want%20to%20inquire%20about%20an%20Annual%20Maintenance%20Contract"
                target="_blank"
                rel="noopener noreferrer"
                class="slv-btn-secondary px-5 py-2.5 text-xs font-bold uppercase tracking-wider inline-flex items-center gap-2 border-emerald-500/30 text-emerald-400 hover:text-white hover:border-emerald-400 hover:bg-emerald-500/10"
              >
                <MessageCircle class="w-3.5 h-3.5 text-emerald-400" />
                <span>WhatsApp AMC Inquiry</span>
              </a>
              <a
                href="/knowledge/pests"
                class="px-4 py-2.5 rounded-xl bg-white/[0.05] border border-white/[0.1] text-xs font-bold text-zinc-300 hover:text-white transition inline-flex items-center gap-1.5"
              >
                <span>Back to Pest Library</span>
                <ArrowRight class="w-3.5 h-3.5 text-[#E5A93C]" />
              </a>
            </div>
          </div>
        </div>
      </section>

    </div>

    {/* BOTTOM CONVERSION CTA BANNER */}
    <section class="relative z-10 py-12 sm:py-16 border-t border-white/[0.08] bg-black/40">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-3">
          Prepare Your Home Before the Next Season Hits
        </h2>
        <p class="text-zinc-400 text-xs sm:text-sm max-w-xl mx-auto mb-8">
          Preemptive seasonal pest exclusion is 3x more cost-effective than eradicating an established multi-room infestation. Schedule your Bangalore home inspection today.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            href="tel:9180397822"
            class="slv-btn-primary px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider inline-flex items-center gap-2"
          >
            <Phone class="w-4 h-4 text-[#1a1202]" />
            <span>Call Now: 91803 97822</span>
          </a>
          <a
            href="/contact"
            class="px-6 py-3 rounded-xl bg-white/[0.06] border border-white/[0.12] text-xs sm:text-sm font-bold text-white hover:bg-white/[0.12] transition"
          >
            <span>Book Online Inspection</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <FloatingActions client:load />
  <Footer />
</Layout>
