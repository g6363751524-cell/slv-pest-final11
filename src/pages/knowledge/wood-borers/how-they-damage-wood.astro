---
import Layout from '../../../layouts/Layout.astro';
import { Header } from '../../../components/Header';
import { Footer } from '../../../components/Footer';
import { FloatingActions } from '../../../components/FloatingActions';
import {
  BookOpen,
  Search,
  Eye,
  Layers,
  Sparkles,
  AlertTriangle,
  CheckCircle2,
  ArrowRight,
  Phone,
  MessageCircle,
  Mail,
  MapPin,
  ShieldCheck,
  Activity,
  Home
} from 'lucide-react';

const relatedArticles = [
  {
    title: 'Wood Borer Identification',
    desc: 'Recognize shot-holes, fine frass powder, weakened timber, and activity around furniture.',
    href: '/knowledge/wood-borers/identification'
  },
  {
    title: 'Where Wood Borers Are Found',
    desc: 'Examine common harbourages: wooden furniture, doors, window frames, flooring, and cabinets.',
    href: '/knowledge/wood-borers/where-they-are-found'
  },
  {
    title: 'Wood Borer Prevention',
    desc: 'Actionable tips: moisture management, timber maintenance, and checking newly purchased furniture.',
    href: '/knowledge/wood-borers/prevention'
  },
  {
    title: 'Wood Borer Treatment Guide',
    desc: 'Our 4-stage journey: inspection, assessment, targeted treatment, and follow-up monitoring.',
    href: '/knowledge/wood-borers/treatment-guide'
  },
  {
    title: 'Wood Borer FAQ',
    desc: 'Clear, factual answers to 13 common questions regarding costs, inspection, and furniture safety.',
    href: '/knowledge/wood-borers/faq'
  }
];

const damageStages = [
  {
    title: 'Concealed Activity Inside Wooden Material',
    desc: 'Adult female beetles lay microscopic eggs inside timber pores or end-grain fissures. Upon hatching, the larvae immediately bore into the timber, spending months or years entirely concealed beneath the surface without visible external disruption.',
    icon: Search
  },
  {
    title: 'Extensive Tunnelling Within Wood',
    desc: 'As the larvae grow, they chew meandering galleries through the starch-rich sapwood. These intersecting internal tunnels consume the internal substance of the wood, gradually transforming solid timber into an internal powdery labyrinth.',
    icon: Layers
  },
  {
    title: 'Formation of Surface Exit Holes',
    desc: 'Upon completing their pupal stage, mature beetles chew clean, round exit holes (shot-holes) to the outside surface to take flight. A single piece of furniture may accumulate dozens of new holes over consecutive breeding cycles.',
    icon: Eye
  },
  {
    title: 'Continuous Ejection of Frass / Powder',
    desc: 'Emerging beetles and moving larvae push bore-dust (frass) outward through the flight holes. This fine, flour-like powder settles in characteristic heaps beneath the infested woodwork.',
    icon: Sparkles
  },
  {
    title: 'Progressive Weakening of Affected Wood',
    desc: 'Over time, ongoing internal excavation leads to a progressive loss of timber density and structural integrity. Veneers may blister, joints loosen, and affected sections become increasingly brittle under load.',
    icon: AlertTriangle
  },
  {
    title: 'Why Early Inspection Is Useful',
    desc: 'Early diagnostic inspection detects active tunneling while infestations are localized, allowing targeted treatment before larvae disperse to adjacent doors, wardrobes, and structural elements.',
    icon: ShieldCheck
  }
];
---

<Layout
  title="How Wood Borers Damage Wood | Tunneling, Frass & Weakening | SLV Pest Control"
  description="Understand how wood borer larvae tunnel through wooden furniture and structures, creating exit holes and frass. Early inspection insights by SLV Pest Control."
  canonical="https://slvpestcontrol.com/knowledge/wood-borers/how-they-damage-wood"
>
  <Header client:load activeItem="knowledge" />

  <main class="flex-1 w-full relative overflow-hidden bg-[#090a0c]">
    {/* Architectural Glow */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 right-1/4 w-[500px] h-[500px] bg-[#E5A93C]/[0.06] rounded-full blur-[140px]"></div>
      <div class="absolute top-[40%] left-[-100px] w-[500px] h-[500px] bg-[#E5A93C]/[0.04] rounded-full blur-[160px]"></div>
    </div>

    {/* Breadcrumbs: Home > Knowledge Hub > Wood Borers > How Wood Borers Damage Wood */}
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs text-zinc-400">
        <a href="/" class="hover:text-white transition">Home</a>
        <span>&gt;</span>
        <a href="/knowledge" class="hover:text-white transition">Knowledge Hub</a>
        <span>&gt;</span>
        <a href="/services/wood-borer-control" class="hover:text-white transition">Wood Borers</a>
        <span>&gt;</span>
        <span class="text-[#F6C453] font-semibold">How Wood Borers Damage Wood</span>
      </nav>
    </div>

    {/* HERO */}
    <section class="relative z-10 pt-10 sm:pt-14 pb-12 sm:pb-16 border-b border-white/[0.06]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 mb-4 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-md">
          <BookOpen class="w-3.5 h-3.5 text-[#E5A93C]" />
          <span class="text-[#E5A93C] text-xs font-extrabold tracking-[0.2em] uppercase">
            DAMAGE MECHANICS
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-5 font-heading">
          How Wood Borers Damage <span class="slv-gold-text">Wooden Structures</span>
        </h1>

        <p class="text-zinc-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto mb-8">
          Learn how wood-boring beetle larvae tunnel through timber, why exit holes and frass appear, and how early inspection halts progressive deterioration.
        </p>

        {/* Primary CTA */}
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
          <a
            href="/services/wood-borer-control"
            class="slv-btn-primary w-full sm:w-auto px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <span>Get Wood Borer Assessment</span>
            <ArrowRight class="w-4 h-4 ml-1" />
          </a>
          <a
            href="tel:9180397822"
            class="slv-btn-secondary w-full sm:w-auto px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <Phone class="w-4 h-4 text-[#F6C453] mr-1" />
            <span>Call: 91803 97822</span>
          </a>
          <a
            href="https://wa.me/9180397822"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-md inline-flex items-center transition"
          >
            <MessageCircle class="w-4 h-4 mr-1 text-white" />
            <span>WhatsApp</span>
          </a>
        </div>
      </div>
    </section>

    {/* CONTENT SECTION */}
    <section class="relative z-10 py-14 sm:py-20 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        {/* Core Principles & Important Structural Nuance */}
        <div class="slv-card rounded-3xl p-8 sm:p-10 border border-white/[0.08] mb-12">
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-4">
            The Biology of Wood Degradation by Borers
          </h2>
          <div class="space-y-4 text-zinc-300 text-sm sm:text-base leading-relaxed">
            <p>
              Unlike termites that consume both sapwood and heartwood rapidly from the exterior, wood-boring beetles generally feed on the nutritional starch and nutrients contained within the sapwood. The outer surface often remains visually intact, while the core is progressively excavated.
            </p>
            <div class="p-4 rounded-xl bg-white/[0.03] border border-white/[0.08] text-xs sm:text-sm text-zinc-300 flex items-start gap-3">
              <AlertTriangle class="w-5 h-5 text-[#E5A93C] shrink-0 mt-0.5" />
              <span>
                <strong>Factual Realism Note:</strong> While persistent, unchecked infestations weaken affected timber over extended periods, not every wood-borer infestation causes catastrophic structural failure. In many residential instances, the damage is localized to decorative furniture, non-load-bearing plywood partitions, or superficial timber sections. Professional assessment helps evaluate the genuine extent of timber involvement.
              </span>
            </div>
          </div>
        </div>

        {/* 6 Damage Stages Grid */}
        <div class="mb-14">
          <div class="text-center max-w-2xl mx-auto mb-10">
            <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-2">DAMAGE MECHANICS</span>
            <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
              Progression of Wood Borer Activity
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {damageStages.map((stage) => {
              const Icon = stage.icon;
              return (
                <div class="slv-card rounded-2xl p-6 border border-white/[0.08] flex flex-col justify-between">
                  <div>
                    <div class="w-10 h-10 rounded-xl bg-[#E5A93C]/10 border border-[#E5A93C]/20 flex items-center justify-center text-[#E5A93C] mb-4">
                      <Icon class="w-5 h-5" />
                    </div>
                    <h3 class="text-lg font-bold text-white mb-2 font-heading">{stage.title}</h3>
                    <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed">{stage.desc}</p>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        {/* Why Early Inspection Is Vital */}
        <div class="slv-card rounded-3xl p-8 sm:p-10 border border-white/[0.08] mb-14">
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-6">
            Why Early Diagnostic Assessment Matters
          </h2>
          <div class="space-y-4 text-zinc-300 text-sm leading-relaxed">
            <p>
              Because beetle lifecycles can span between one and three years depending on indoor temperature and wood moisture, larvae may be actively tunneling long before flight holes appear:
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
              <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.05]">
                <span class="text-[#F6C453] font-bold block mb-1">1. Prevent Cross-Transfer</span>
                <span class="text-zinc-400 text-xs">Arresting activity in an infested piece prevents emerging beetles from infesting adjoining wooden furniture.</span>
              </div>
              <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.05]">
                <span class="text-[#F6C453] font-bold block mb-1">2. Preserve Aesthetics</span>
                <span class="text-zinc-400 text-xs">Treating exit holes promptly avoids widespread surface perforation of fine polished finishes.</span>
              </div>
              <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.05]">
                <span class="text-[#F6C453] font-bold block mb-1">3. Targeted Application</span>
                <span class="text-zinc-400 text-xs">Ensures specialized syringe injection is focused directly into active gallery networks.</span>
              </div>
            </div>
          </div>
        </div>

        {/* CTA Banner */}
        <div class="slv-card rounded-3xl p-8 sm:p-12 border border-[#E5A93C]/40 bg-gradient-to-b from-[#14161c] to-[#0c0d10] text-center mb-16 shadow-[0_20px_50px_rgba(0,0,0,0.8)]">
          <ShieldCheck class="w-12 h-12 text-[#E5A93C] mx-auto mb-4" />
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-3">
            Concerned About Progressive Timber Damage?
          </h2>
          <p class="text-zinc-300 text-xs sm:text-sm max-w-lg mx-auto mb-6 leading-relaxed">
            Protect your woodwork with professional diagnostic assessment and targeted syringe infusion. Pricing provided after on-site inspection.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
              href="/services/wood-borer-control"
              class="slv-btn-primary px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
            >
              <span>Get Wood Borer Assessment</span>
              <ArrowRight class="w-4 h-4 ml-1" />
            </a>
            <a
              href="tel:9180397822"
              class="slv-btn-secondary px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
            >
              <Phone class="w-4 h-4 text-[#F6C453] mr-1" />
              <span>Call: 91803 97822</span>
            </a>
            <a
              href="https://wa.me/9180397822"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-md inline-flex items-center transition"
            >
              <MessageCircle class="w-4 h-4 mr-1 text-white" />
              <span>WhatsApp Us</span>
            </a>
          </div>
        </div>

        {/* Related Knowledge Hub Articles */}
        <div>
          <div class="flex items-center gap-2 mb-6">
            <BookOpen class="w-4 h-4 text-[#E5A93C]" />
            <h2 class="text-xl font-bold text-white font-heading">
              Explore More Wood Borer Guides
            </h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {relatedArticles.map((article) => (
              <a
                href={article.href}
                class="slv-card rounded-2xl p-5 border border-white/[0.08] hover:border-[#E5A93C]/50 transition block group"
              >
                <h3 class="text-sm font-bold text-white group-hover:text-[#F6C453] transition mb-1.5 flex items-center justify-between">
                  <span>{article.title}</span>
                  <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                </h3>
                <p class="text-zinc-400 text-xs leading-relaxed">{article.desc}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* CONTACT & SERVICE DETAILS */}
    <section class="relative z-10 py-14 sm:py-18 bg-[#0c0d10]/50 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="slv-card rounded-3xl p-6 sm:p-10 border border-white/[0.08]">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs">
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Bangalore Service Office</span>
              <p class="text-white text-sm">143 Soundarya Layout, Doddabidarakallu, Bangalore 560073</p>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Phone / WhatsApp</span>
              <a href="tel:9180397822" class="text-white text-sm font-bold font-mono hover:text-[#FFE08A]">91803 97822</a>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Email Support</span>
              <a href="mailto:contact@slvpestcontrol.com" class="text-white text-sm hover:text-[#FFE08A]">contact@slvpestcontrol.com</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingActions client:load />
</Layout>
