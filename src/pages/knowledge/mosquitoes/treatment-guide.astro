---
import Layout from '../../../layouts/Layout.astro';
import { Header } from '../../../components/Header';
import { Footer } from '../../../components/Footer';
import { FloatingActions } from '../../../components/FloatingActions';
import {
  BookOpen,
  Search,
  ShieldCheck,
  CheckCircle2,
  Wind,
  Droplets,
  Layers,
  ArrowRight,
  Phone,
  MessageCircle,
  Mail,
  HelpCircle,
  TreePine,
  Building
} from 'lucide-react';

const relatedArticles = [
  {
    title: 'Mosquito Identification',
    desc: 'Recognize signs: day vs. night biters, larvae, and resting zones.',
    href: '/knowledge/mosquitoes/identification'
  },
  {
    title: 'Where Mosquitoes Breed & Hide',
    desc: 'Stagnant water, containers, drains, gardens, and shaded damp areas.',
    href: '/knowledge/mosquitoes/where-they-breed'
  },
  {
    title: 'How Mosquitoes Enter & Spread',
    desc: 'Open windows, door gaps, outdoor breeding sources, and indoor flight paths.',
    href: '/knowledge/mosquitoes/how-they-spread'
  },
  {
    title: 'Mosquito Prevention',
    desc: 'Eliminating standing water, covered tanks, physical mesh, and outdoor care.',
    href: '/knowledge/mosquitoes/prevention'
  },
  {
    title: 'Mosquito FAQ',
    desc: 'Answers to 12 practical questions on costs, preparation, breeding, and safety.',
    href: '/knowledge/mosquitoes/faq'
  }
];

const treatmentStages = [
  {
    step: '01',
    title: 'Inspection',
    desc: 'Identify mosquito activity and potential breeding areas.',
    detail: 'Our experienced technician surveys both indoor corridors and outdoor property boundaries to identify active biting swarms, daytime resting canopies, and aquatic habitats in drains, sumps, and planters.',
    icon: Search
  },
  {
    step: '02',
    title: 'Source Assessment',
    desc: 'Identify suitable breeding conditions and areas that may contribute to mosquito activity.',
    detail: 'We document stagnant water accumulation, evaluate drainage flow rates, assess surrounding construction or open-plot risks, and identify shaded vegetation harboring daytime populations.',
    icon: Droplets
  },
  {
    step: '03',
    title: 'Targeted Treatment',
    desc: 'Apply the appropriate treatment method based on the inspection and property conditions.',
    detail: 'We deploy an integrated dual-action approach: approved biological or chemical larvicides are applied to non-drainable standing water to neutralize larvae, while outdoor thermal fogging or targeted perimeter misting knocks down active adult flying mosquitoes.',
    icon: Wind
  },
  {
    step: '04',
    title: 'Follow-up & Prevention Guidance',
    desc: 'Provide practical guidance for reducing conditions that can contribute to recurring mosquito activity.',
    detail: 'The technician provides customized advice on managing balcony containers, clearing drain silt, maintaining window screens, and coordinating seasonal treatments before monsoon spikes.',
    icon: ShieldCheck
  }
];
---

<Layout
  title="Mosquito Treatment Guide | Integrated Mosquito Management | SLV Pest Control"
  description="Discover SLV Pest Control's structured 4-stage mosquito treatment approach: site inspection, source assessment, targeted larvicide and fogging, and prevention guidance."
  canonical="https://slvpestcontrol.com/knowledge/mosquitoes/treatment-guide"
>
  <Header client:load activeItem="knowledge" />

  <main class="flex-1 w-full relative overflow-hidden bg-[#090a0c]">
    {/* Architectural Background Pattern */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 right-1/4 w-[500px] h-[500px] bg-[#E5A93C]/[0.06] rounded-full blur-[140px]"></div>
      <div class="absolute top-[40%] left-[-100px] w-[500px] h-[500px] bg-[#E5A93C]/[0.04] rounded-full blur-[160px]"></div>
    </div>

    {/* Breadcrumbs: Home > Knowledge Hub > Mosquitoes > Current Page */}
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs text-zinc-400">
        <a href="/" class="hover:text-white transition">Home</a>
        <span>&gt;</span>
        <a href="/knowledge" class="hover:text-white transition">Knowledge Hub</a>
        <span>&gt;</span>
        <a href="/services/mosquito-control" class="hover:text-white transition">Mosquitoes</a>
        <span>&gt;</span>
        <span class="text-[#F6C453] font-semibold">Mosquito Treatment Guide</span>
      </nav>
    </div>

    {/* HERO */}
    <section class="relative z-10 pt-10 sm:pt-14 pb-12 sm:pb-16 border-b border-white/[0.06]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 mb-4 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-md">
          <BookOpen class="w-3.5 h-3.5 text-[#E5A93C]" />
          <span class="text-[#E5A93C] text-xs font-extrabold tracking-[0.2em] uppercase">
            INTEGRATED MANAGEMENT WORKFLOW
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-5 font-heading">
          Mosquito Treatment Guide: <span class="slv-gold-text">Professional Methodology</span>
        </h1>

        <p class="text-zinc-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto mb-8">
          A disciplined 4-stage Integrated Mosquito Management (IMM) process addressing aquatic larvae at the source and reducing adult flying populations.
        </p>

        {/* Primary CTA */}
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
          <a
            href="/services/mosquito-control"
            class="slv-btn-primary w-full sm:w-auto px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <span>View Mosquito Control</span>
            <ArrowRight class="w-4 h-4 ml-1" />
          </a>
          <a
            href="tel:9180397822"
            class="slv-btn-secondary w-full sm:w-auto px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <Phone class="w-4 h-4 text-[#F6C453] mr-1" />
            <span>Call: 91803 97822</span>
          </a>
        </div>
      </div>
    </section>

    {/* CONTENT SECTION */}
    <section class="relative z-10 py-14 sm:py-20 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        {/* Core Principles */}
        <div class="slv-card rounded-3xl p-8 sm:p-10 border border-white/[0.08] mb-12">
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-4">
            Integrated Mosquito Management (IMM) Approach
          </h2>
          <div class="space-y-4 text-zinc-300 text-sm sm:text-base leading-relaxed">
            <p>
              Relying solely on sporadic aerosol fogging does not provide sustained mosquito suppression because adult mosquitoes continually emerge from untreated stagnant water sources.
            </p>
            <p>
              SLV Pest Control utilizes an Integrated Mosquito Management framework that attacks the problem on two fronts: <strong>larval suppression</strong> (stopping the next generation from reaching maturity in water) and <strong>targeted adult knockdown</strong> (clearing flying biters from outdoor perimeters and shaded resting zones).
            </p>
          </div>
        </div>

        {/* 4 Stages Grid */}
        <div class="mb-14">
          <div class="text-center max-w-2xl mx-auto mb-10">
            <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-2">TREATMENT JOURNEY</span>
            <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
              Our 4-Stage Treatment Approach
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {treatmentStages.map((stage) => {
              const Icon = stage.icon;
              return (
                <div class="slv-card rounded-2xl p-6 sm:p-7 border border-white/[0.08] flex flex-col justify-between hover:border-[#E5A93C]/40 transition-colors">
                  <div>
                    <div class="flex items-center justify-between mb-4">
                      <span class="text-3xl font-black font-mono text-[#F6C453]">{stage.step}</span>
                      <div class="w-10 h-10 rounded-xl bg-[#E5A93C]/10 border border-[#E5A93C]/20 flex items-center justify-center text-[#E5A93C]">
                        <Icon class="w-5 h-5" />
                      </div>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-2 font-heading">{stage.title}</h3>
                    <p class="text-xs font-semibold text-[#FFE08A] mb-3">{stage.desc}</p>
                    <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed">{stage.detail}</p>
                  </div>
                  <div class="mt-6 pt-4 border-t border-white/[0.06] text-[11px] text-zinc-500 font-mono">
                    Phase {stage.step} of 04
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        {/* Larvicide & Fogging Technology */}
        <div class="slv-card rounded-3xl p-8 sm:p-10 border border-white/[0.08] mb-14">
          <h2 class="text-2xl font-black text-white font-heading mb-4">
            Dual-Action Treatment Modalities
          </h2>
          <div class="space-y-4 text-zinc-300 text-sm leading-relaxed">
            <p>
              Depending on whether the property is an independent residence, high-rise gated society, or outdoor corporate campus, treatments combine:
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
              <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.05]">
                <span class="text-[#F6C453] font-bold block mb-1">Targeted Larvicidal Application</span>
                <span class="text-zinc-400 text-xs">Direct placement of biological or insect growth regulator larvicides into drains, sumps, and standing water to prevent adult emergence.</span>
              </div>
              <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.05]">
                <span class="text-[#F6C453] font-bold block mb-1">Outdoor Thermal Fogging &amp; Misting</span>
                <span class="text-zinc-400 text-xs">Cold misting and thermal smoke fogging deployed across garden canopies, compound walls, and corridors to knock down flying adult biters.</span>
              </div>
            </div>
          </div>
        </div>

        {/* Honest Expectation Setting */}
        <div class="slv-card rounded-3xl p-8 border border-white/[0.08] mb-14 bg-white/[0.02]">
          <div class="flex items-start gap-3">
            <HelpCircle class="w-5 h-5 text-[#E5A93C] shrink-0 mt-0.5" />
            <div>
              <h3 class="text-base font-bold text-white mb-2">Factual Treatment Expectations</h3>
              <p class="text-zinc-300 text-xs sm:text-sm leading-relaxed">
                Because adult mosquitoes fly freely across open outdoor air, no pest management service can guarantee a completely bite-free outdoor environment without ongoing source reduction. Treatment duration varies depending on boundary acreage, foliage density, and the number of water drainage chambers treated. Sustainable suppression relies on regular source reduction alongside scheduled barrier treatments.
              </p>
            </div>
          </div>
        </div>

        {/* CTA Banner */}
        <div class="slv-card rounded-3xl p-8 sm:p-12 border border-[#E5A93C]/40 bg-gradient-to-b from-[#14161c] to-[#0c0d10] text-center mb-16 shadow-[0_20px_50px_rgba(0,0,0,0.8)]">
          <ShieldCheck class="w-12 h-12 text-[#E5A93C] mx-auto mb-4" />
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-3">
            Schedule a Mosquito Control Assessment
          </h2>
          <p class="text-zinc-300 text-xs sm:text-sm max-w-lg mx-auto mb-6 leading-relaxed">
            Let our experienced technicians evaluate your property layout, identify stagnant water sources, and recommend a targeted treatment plan.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
              href="/services/mosquito-control"
              class="slv-btn-primary px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
            >
              <span>View Mosquito Control</span>
              <ArrowRight class="w-4 h-4 ml-1" />
            </a>
            <a
              href="https://wa.me/9180397822"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-md inline-flex items-center transition"
            >
              <MessageCircle class="w-4 h-4 mr-1 text-white" />
              <span>WhatsApp Us</span>
            </a>
          </div>
        </div>

        {/* Related Knowledge Hub Articles */}
        <div>
          <div class="flex items-center gap-2 mb-6">
            <BookOpen class="w-4 h-4 text-[#E5A93C]" />
            <h2 class="text-xl font-bold text-white font-heading">
              Explore More Mosquito Guides
            </h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {relatedArticles.map((article) => (
              <a
                href={article.href}
                class="slv-card rounded-2xl p-5 border border-white/[0.08] hover:border-[#E5A93C]/50 transition block group"
              >
                <h3 class="text-sm font-bold text-white group-hover:text-[#F6C453] transition mb-1.5 flex items-center justify-between">
                  <span>{article.title}</span>
                  <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                </h3>
                <p class="text-zinc-400 text-xs leading-relaxed">{article.desc}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* CONTACT & SERVICE DETAILS */}
    <section class="relative z-10 py-14 sm:py-18 bg-[#0c0d10]/50 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="slv-card rounded-3xl p-6 sm:p-10 border border-white/[0.08]">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs">
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Bangalore Service Office</span>
              <p class="text-white text-sm">143 Soundarya Layout, Doddabidarakallu, Bangalore 560073</p>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Phone / WhatsApp</span>
              <a href="tel:9180397822" class="text-white text-sm font-bold font-mono hover:text-[#FFE08A]">91803 97822</a>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Email Support</span>
              <a href="mailto:contact@slvpestcontrol.com" class="text-white text-sm hover:text-[#FFE08A]">contact@slvpestcontrol.com</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingActions client:load />
</Layout>
