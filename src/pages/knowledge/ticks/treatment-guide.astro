---
import Layout from '../../../layouts/Layout.astro';
import { Header } from '../../../components/Header';
import { Footer } from '../../../components/Footer';
import { FloatingActions } from '../../../components/FloatingActions';
import {
  BookOpen,
  Search,
  ShieldCheck,
  CheckCircle2,
  Sparkles,
  Layers,
  Activity,
  ArrowRight,
  Phone,
  MessageCircle,
  Mail,
  HelpCircle,
  AlertTriangle,
  PawPrint
} from 'lucide-react';

const relatedArticles = [
  {
    title: 'Tick Identification',
    desc: 'Recognize what ticks look like, visible wall signs, and pet indicators.',
    href: '/knowledge/ticks/identification'
  },
  {
    title: 'Where Ticks Hide',
    desc: 'Inspect pet resting zones, upholstery, wall cracks, and shaded gardens.',
    href: '/knowledge/ticks/where-they-hide'
  },
  {
    title: 'How Ticks Spread',
    desc: 'Understand entry vectors through domestic pets, vegetation, and outdoor walks.',
    href: '/knowledge/ticks/how-they-spread'
  },
  {
    title: 'Tick Prevention',
    desc: 'Actionable environmental hygiene, bedding sanitation, and structural sealing.',
    href: '/knowledge/ticks/prevention'
  },
  {
    title: 'Tick FAQ',
    desc: 'Clear, factual answers to 13 common questions regarding tick management.',
    href: '/knowledge/ticks/faq'
  }
];

const treatmentStages = [
  {
    step: '01',
    title: 'Inspection',
    desc: 'Identify tick activity, likely harbourage and affected areas.',
    detail: 'A certified SLV Pest Control technician conducts an in-depth examination of the property. This includes inspecting interior baseboards, plaster wall cracks, doorframes, window surrounds, and pet resting zones, as well as exterior compound walls, shaded kennels, and garden borders to identify active infestation clusters.',
    icon: Search
  },
  {
    step: '02',
    title: 'Source Assessment',
    desc: 'Assess indoor, outdoor and animal-associated areas that may contribute to tick activity.',
    detail: 'We evaluate the broader environmental context: where pets sleep, outdoor walking corridors, proximity to neighboring unkempt vegetation, shaded compound niches, and structural gaps. This comprehensive assessment ensures that both primary and secondary harbourages are documented before formulating the treatment plan.',
    icon: Layers
  },
  {
    step: '03',
    title: 'Targeted Environmental Treatment',
    desc: 'Apply an appropriate environmental treatment approach to suitable areas based on inspection findings and property conditions.',
    detail: 'Using professional premises formulations, we treat targeted physical harbourages such as vertical wall cracks, skirting crevices, expansion joints, kennel woodwork, and exterior compound walls. Environmental treatments are applied strictly to structural surfaces and non-living premises—never directly to pets or animals.',
    icon: Activity
  },
  {
    step: '04',
    title: 'Follow-up & Prevention Guidance',
    desc: 'Provide monitoring and prevention recommendations based on the property and infestation conditions.',
    detail: 'Because tick eggs and molting stages present distinct developmental timelines, our team provides property-specific monitoring instructions. We advise property owners on post-treatment bedding laundering, habitat maintenance, and when to conduct follow-up reviews.',
    icon: ShieldCheck
  }
];
---

<Layout
  title="Tick Treatment Guide | 4-Stage Environmental Methodology | SLV Pest Control"
  description="Explore SLV Pest Control's structured 4-stage tick management approach: inspection, source assessment, targeted environmental treatment, and prevention guidance."
  canonical="https://slvpestcontrol.com/knowledge/ticks/treatment-guide"
>
  <Header client:load activeItem="knowledge" />

  <main class="flex-1 w-full relative overflow-hidden bg-[#090a0c]">
    {/* Architectural Glow */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 right-1/4 w-[500px] h-[500px] bg-[#E5A93C]/[0.06] rounded-full blur-[140px]"></div>
      <div class="absolute top-[40%] left-[-100px] w-[500px] h-[500px] bg-[#E5A93C]/[0.04] rounded-full blur-[160px]"></div>
    </div>

    {/* Breadcrumbs: Home > Knowledge Hub > Ticks > Tick Treatment Guide */}
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs text-zinc-400">
        <a href="/" class="hover:text-white transition">Home</a>
        <span>&gt;</span>
        <a href="/knowledge" class="hover:text-white transition">Knowledge Hub</a>
        <span>&gt;</span>
        <a href="/services/tick-control" class="hover:text-white transition">Ticks</a>
        <span>&gt;</span>
        <span class="text-[#F6C453] font-semibold">Tick Treatment Guide</span>
      </nav>
    </div>

    {/* HERO */}
    <section class="relative z-10 pt-10 sm:pt-14 pb-12 sm:pb-16 border-b border-white/[0.06]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 mb-4 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-md">
          <BookOpen class="w-3.5 h-3.5 text-[#E5A93C]" />
          <span class="text-[#E5A93C] text-xs font-extrabold tracking-[0.2em] uppercase">
            TREATMENT METHODOLOGY
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-5 font-heading">
          Tick Treatment Guide: <span class="slv-gold-text">4-Stage Methodology</span>
        </h1>

        <p class="text-zinc-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto mb-8">
          A disciplined, scientific approach to managing ticks in residential properties and compounds across Bangalore.
        </p>

        {/* Primary CTA */}
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
          <a
            href="/services/tick-control"
            class="slv-btn-primary w-full sm:w-auto px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <span>View Tick Control</span>
            <ArrowRight class="w-4 h-4 ml-1" />
          </a>
          <a
            href="tel:9180397822"
            class="slv-btn-secondary w-full sm:w-auto px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <Phone class="w-4 h-4 text-[#F6C453] mr-1" />
            <span>Call: 91803 97822</span>
          </a>
          <a
            href="https://wa.me/9180397822"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-md inline-flex items-center transition"
          >
            <MessageCircle class="w-4 h-4 mr-1 text-white" />
            <span>WhatsApp</span>
          </a>
        </div>
      </div>
    </section>

    {/* CONTENT SECTION */}
    <section class="relative z-10 py-14 sm:py-20 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        {/* Core Principles & Important Veterinarian Guidance */}
        <div class="slv-card rounded-3xl p-8 sm:p-10 border border-white/[0.08] mb-12">
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-4">
            Understanding Environmental Pest Control vs. Pet Healthcare
          </h2>
          <div class="space-y-4 text-zinc-300 text-sm sm:text-base leading-relaxed">
            <p>
              Effective tick management requires understanding the distinction between environmental pest control and veterinary animal care:
            </p>
            <div class="p-5 rounded-2xl bg-white/[0.03] border border-[#E5A93C]/30 text-xs sm:text-sm text-zinc-200 space-y-3">
              <div class="flex items-start gap-3">
                <AlertTriangle class="w-5 h-5 text-[#E5A93C] shrink-0 mt-0.5" />
                <div class="space-y-2">
                  <p class="font-bold text-white">Critical Boundary &amp; Veterinary Coordination Notice:</p>
                  <p>
                    <strong>Environmental pest control alone does not treat ticks on animals.</strong> SLV Pest Control provides professional environmental pest management for premises, walls, floors, compound perimeters, and surrounding structures.
                  </p>
                  <p>
                    For the treatment, prevention, or removal of ticks on domestic pets (dogs, cats), property owners must consult a qualified licensed veterinarian. We do not prescribe, supply, or administer veterinary medications, spot-ons, oral chews, or collars.
                  </p>
                  <p class="text-zinc-400">
                    Furthermore, biological pest management depends on ambient conditions, host dynamics, and structural factors. We do not make unsupported claims of guaranteed 100% elimination or permanent eradication.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* 4-Stage Breakdown */}
        <div class="mb-14">
          <div class="text-center max-w-2xl mx-auto mb-10">
            <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-2">TREATMENT PROTOCOL</span>
            <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
              Our 4-Stage Treatment Approach
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {treatmentStages.map((stage) => {
              const Icon = stage.icon;
              return (
                <div class="slv-card rounded-2xl p-6 sm:p-7 border border-white/[0.08] flex flex-col justify-between hover:border-[#E5A93C]/40 transition-colors">
                  <div>
                    <div class="flex items-center justify-between mb-4">
                      <span class="text-3xl font-black font-mono text-[#F6C453]">{stage.step}</span>
                      <div class="w-10 h-10 rounded-xl bg-[#E5A93C]/10 border border-[#E5A93C]/20 flex items-center justify-center text-[#E5A93C]">
                        <Icon class="w-5 h-5" />
                      </div>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-2 font-heading">{stage.title}</h3>
                    <p class="text-xs font-semibold text-[#FFE08A] mb-3">{stage.desc}</p>
                    <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed">{stage.detail}</p>
                  </div>
                  <div class="mt-6 pt-4 border-t border-white/[0.06] text-[11px] text-zinc-500 font-mono">
                    Stage {stage.step} of 04
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        {/* Integrated Coordination Strategy */}
        <div class="slv-card rounded-3xl p-8 sm:p-10 border border-white/[0.08] mb-14">
          <h2 class="text-2xl font-black text-white font-heading mb-4">
            Coordinating Premises Management with Pet Care
          </h2>
          <div class="space-y-4 text-zinc-300 text-sm leading-relaxed">
            <p>
              To achieve optimal results, property management and veterinary pet care should proceed in tandem:
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 pt-2">
              <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/[0.06]">
                <span class="text-[#F6C453] font-bold block mb-1">Premises Management (SLV Pest Control)</span>
                <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed">
                  Targets the environmental reservoir: vertical cracks in walls, gaps behind baseboards, expansion joints, compound boundary walls, and shaded kennel structures.
                </p>
              </div>
              <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/[0.06]">
                <span class="text-[#F6C453] font-bold block mb-1">Veterinary Care (Customer's Veterinarian)</span>
                <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed">
                  Provides veterinarian-approved on-pet treatments (topical spot-ons, oral tablets, or approved tick collars) to protect pets from incoming questing ticks during walks.
                </p>
              </div>
            </div>
          </div>
        </div>

        {/* CTA Banner */}
        <div class="slv-card rounded-3xl p-8 sm:p-12 border border-[#E5A93C]/40 bg-gradient-to-b from-[#14161c] to-[#0c0d10] text-center mb-16 shadow-[0_20px_50px_rgba(0,0,0,0.8)]">
          <ShieldCheck class="w-12 h-12 text-[#E5A93C] mx-auto mb-4" />
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-3">
            Schedule an On-Site Tick Inspection
          </h2>
          <p class="text-zinc-300 text-xs sm:text-sm max-w-lg mx-auto mb-6 leading-relaxed">
            Our technicians evaluate your premises and provide customized pricing after an on-site property inspection. Contact SLV Pest Control today.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
              href="/services/tick-control"
              class="slv-btn-primary px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
            >
              <span>View Tick Control</span>
              <ArrowRight class="w-4 h-4 ml-1" />
            </a>
            <a
              href="tel:9180397822"
              class="slv-btn-secondary px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
            >
              <Phone class="w-4 h-4 text-[#F6C453] mr-1" />
              <span>Call: 91803 97822</span>
            </a>
            <a
              href="https://wa.me/9180397822"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-md inline-flex items-center transition"
            >
              <MessageCircle class="w-4 h-4 mr-1 text-white" />
              <span>WhatsApp Us</span>
            </a>
          </div>
        </div>

        {/* Related Knowledge Hub Articles */}
        <div>
          <div class="flex items-center gap-2 mb-6">
            <BookOpen class="w-4 h-4 text-[#E5A93C]" />
            <h2 class="text-xl font-bold text-white font-heading">
              Explore More Tick Guides
            </h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {relatedArticles.map((article) => (
              <a
                href={article.href}
                class="slv-card rounded-2xl p-5 border border-white/[0.08] hover:border-[#E5A93C]/50 transition block group"
              >
                <h3 class="text-sm font-bold text-white group-hover:text-[#F6C453] transition mb-1.5 flex items-center justify-between">
                  <span>{article.title}</span>
                  <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                </h3>
                <p class="text-zinc-400 text-xs leading-relaxed">{article.desc}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* CONTACT & SERVICE DETAILS */}
    <section class="relative z-10 py-14 sm:py-18 bg-[#0c0d10]/50 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="slv-card rounded-3xl p-6 sm:p-10 border border-white/[0.08]">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs">
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Bangalore Service Office</span>
              <p class="text-white text-sm">143 Soundarya Layout, Doddabidarakallu, Bangalore 560073</p>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Phone / WhatsApp</span>
              <a href="tel:9180397822" class="text-white text-sm font-bold font-mono hover:text-[#FFE08A]">91803 97822</a>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Email Support</span>
              <a href="mailto:contact@slvpestcontrol.com" class="text-white text-sm hover:text-[#FFE08A]">contact@slvpestcontrol.com</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingActions client:load />
</Layout>
