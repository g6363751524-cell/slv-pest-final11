---
import Layout from '../../../layouts/Layout.astro';
import { Header } from '../../../components/Header';
import { Footer } from '../../../components/Footer';
import { FloatingActions } from '../../../components/FloatingActions';
import {
  BookOpen,
  Search,
  Eye,
  Layers,
  Sparkles,
  AlertTriangle,
  CheckCircle2,
  ArrowRight,
  Phone,
  MessageCircle,
  Mail,
  MapPin,
  ShieldCheck,
  Home,
  PawPrint,
  Clock,
  Sparkle
} from 'lucide-react';

const relatedArticles = [
  {
    title: 'Tick Identification',
    desc: 'Recognize what ticks look like, visible wall signs, and pet indicators.',
    href: '/knowledge/ticks/identification'
  },
  {
    title: 'Where Ticks Hide',
    desc: 'Inspect pet resting zones, upholstery, wall cracks, and shaded gardens.',
    href: '/knowledge/ticks/where-they-hide'
  },
  {
    title: 'How Ticks Spread',
    desc: 'Understand entry vectors through domestic pets, vegetation, and outdoor walks.',
    href: '/knowledge/ticks/how-they-spread'
  },
  {
    title: 'Tick Treatment Guide',
    desc: 'Our structured 4-stage environmental protocol: inspection, source assessment, treatment, and follow-up.',
    href: '/knowledge/ticks/treatment-guide'
  },
  {
    title: 'Tick FAQ',
    desc: 'Clear, factual answers to 13 common questions regarding tick management.',
    href: '/knowledge/ticks/faq'
  }
];

const preventionMeasures = [
  {
    title: 'Regularly Inspect Areas Where Pets Rest',
    desc: 'Establish a weekly routine inspecting the crevices of dog crates, sleeping mats, and kennel joints. Invert cushions and examine seams and corners where engorged ticks or eggs may be harboured.',
    icon: Home
  },
  {
    title: 'Keep Suitable Bedding Clean',
    desc: 'Launder pet blankets, cushion covers, and sleeping towels regularly in hot water (>60°C where fabrics safely permit) and tumble dry or dry thoroughly in bright sunlight to eliminate concealed larvae.',
    icon: Sparkles
  },
  {
    title: 'Maintain Outdoor Areas',
    desc: 'Keep compound lawns neatly mowed and weed-free. Clear piles of dry leaves, pruned branches, and organic clutter along perimeter compound walls to reduce shaded, humid tick micro-habitats.',
    icon: Layers
  },
  {
    title: 'Reduce Suitable Hiding Areas Where Possible',
    desc: 'Seal vertical hairline cracks in interior plaster walls, caulk gaps around wooden baseboards and door casings, and repair masonry voids in external compound boundary walls to minimize harborage sites.',
    icon: ShieldCheck
  },
  {
    title: 'Inspect Pets & Surroundings Regularly',
    desc: 'Examine dogs immediately following daily outdoor neighborhood walks, paying close attention to paws, between toes, inner ear flaps, and underbellies. Check surrounding baseboards and walls for crawling ticks.',
    icon: PawPrint
  },
  {
    title: 'Act Early When Tick Activity Is Noticed',
    desc: 'Because a single female Brown Dog Tick can deposit thousands of eggs within days, responding immediately upon spotting the first tick prevents widespread premises infestation and complex remediation.',
    icon: Clock
  }
];
---

<Layout
  title="Tick Prevention | Property Care & Environmental Hygiene | SLV Pest Control"
  description="Practical tick prevention tips for Bangalore property owners. Learn effective bedding hygiene, lawn maintenance, crack sealing, and early detection measures."
  canonical="https://slvpestcontrol.com/knowledge/ticks/prevention"
>
  <Header client:load activeItem="knowledge" />

  <main class="flex-1 w-full relative overflow-hidden bg-[#090a0c]">
    {/* Architectural Glow */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 right-1/4 w-[500px] h-[500px] bg-[#E5A93C]/[0.06] rounded-full blur-[140px]"></div>
      <div class="absolute top-[40%] left-[-100px] w-[500px] h-[500px] bg-[#E5A93C]/[0.04] rounded-full blur-[160px]"></div>
    </div>

    {/* Breadcrumbs: Home > Knowledge Hub > Ticks > Tick Prevention */}
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs text-zinc-400">
        <a href="/" class="hover:text-white transition">Home</a>
        <span>&gt;</span>
        <a href="/knowledge" class="hover:text-white transition">Knowledge Hub</a>
        <span>&gt;</span>
        <a href="/services/tick-control" class="hover:text-white transition">Ticks</a>
        <span>&gt;</span>
        <span class="text-[#F6C453] font-semibold">Tick Prevention</span>
      </nav>
    </div>

    {/* HERO */}
    <section class="relative z-10 pt-10 sm:pt-14 pb-12 sm:pb-16 border-b border-white/[0.06]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 mb-4 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-md">
          <BookOpen class="w-3.5 h-3.5 text-[#E5A93C]" />
          <span class="text-[#E5A93C] text-xs font-extrabold tracking-[0.2em] uppercase">
            PREVENTION STRATEGIES
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-5 font-heading">
          Tick Prevention: <span class="slv-gold-text">Property Care &amp; Hygiene</span>
        </h1>

        <p class="text-zinc-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto mb-8">
          Practical hygiene measures, physical habitat reduction, and regular inspection routines to help protect homes and compounds across Bangalore.
        </p>

        {/* Primary CTA */}
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
          <a
            href="/services/tick-control"
            class="slv-btn-primary w-full sm:w-auto px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <span>Tick Control</span>
            <ArrowRight class="w-4 h-4 ml-1" />
          </a>
          <a
            href="tel:9180397822"
            class="slv-btn-secondary w-full sm:w-auto px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <Phone class="w-4 h-4 text-[#F6C453] mr-1" />
            <span>Call: 91803 97822</span>
          </a>
          <a
            href="https://wa.me/9180397822"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-md inline-flex items-center transition"
          >
            <MessageCircle class="w-4 h-4 mr-1 text-white" />
            <span>WhatsApp</span>
          </a>
        </div>
      </div>
    </section>

    {/* CONTENT SECTION */}
    <section class="relative z-10 py-14 sm:py-20 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        {/* Overview */}
        <div class="slv-card rounded-3xl p-8 sm:p-10 border border-white/[0.08] mb-12">
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-4">
            A Proactive Environmental Approach
          </h2>
          <div class="space-y-4 text-zinc-300 text-sm sm:text-base leading-relaxed">
            <p>
              Preventing tick infestations requires consistent environmental maintenance that minimizes harbourage options and detects emerging activity before it spreads. In urban Bangalore climates, where ambient temperatures support year-round tick activity, proactive property care is key.
            </p>
            <div class="p-4 rounded-xl bg-white/[0.03] border border-white/[0.08] text-xs sm:text-sm text-zinc-300 flex items-start gap-3">
              <AlertTriangle class="w-5 h-5 text-[#E5A93C] shrink-0 mt-0.5" />
              <span>
                <strong>Veterinary Guidance Notice:</strong> SLV Pest Control provides environmental premises management for buildings and grounds. We do not provide veterinary medication instructions, prescription drug advice, or topical application guidance for animals. Always consult a qualified licensed veterinarian for approved tick prevention treatments on pets.
              </span>
            </div>
          </div>
        </div>

        {/* 6 Prevention Measures Grid */}
        <div class="mb-14">
          <div class="text-center max-w-2xl mx-auto mb-10">
            <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-2">ACTIONABLE CHECKLIST</span>
            <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
              Practical Prevention Steps
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {preventionMeasures.map((measure) => {
              const Icon = measure.icon;
              return (
                <div class="slv-card rounded-2xl p-6 border border-white/[0.08] flex flex-col justify-between">
                  <div>
                    <div class="w-10 h-10 rounded-xl bg-[#E5A93C]/10 border border-[#E5A93C]/20 flex items-center justify-center text-[#E5A93C] mb-4">
                      <Icon class="w-5 h-5" />
                    </div>
                    <h3 class="text-lg font-bold text-white mb-2 font-heading">{measure.title}</h3>
                    <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed">{measure.desc}</p>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        {/* Habitat Alteration Details */}
        <div class="slv-card rounded-3xl p-8 sm:p-10 border border-white/[0.08] mb-14">
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-6">
            Structural &amp; Environmental Maintenance Summary
          </h2>
          <div class="space-y-4 text-zinc-300 text-sm leading-relaxed">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/[0.06]">
                <span class="text-xs font-bold text-[#F6C453] uppercase tracking-wider block mb-1">Indoor Sealing</span>
                <h3 class="text-base font-bold text-white mb-2">Eliminate Wall &amp; Floor Crevices</h3>
                <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed">
                  Caulk gaps between skirting tiles and wall plaster. Ensure floor-to-wall expansion joints are sealed, especially in utility areas and dog resting rooms.
                </p>
              </div>
              <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/[0.06]">
                <span class="text-xs font-bold text-[#F6C453] uppercase tracking-wider block mb-1">Outdoor Maintenance</span>
                <h3 class="text-base font-bold text-white mb-2">Clear Boundary Margins</h3>
                <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed">
                  Trim overhanging vegetation along boundary walls, keep garden paths clear of dry leaf buildup, and maintain clean outdoor kennel borders.
                </p>
              </div>
            </div>
          </div>
        </div>

        {/* CTA Banner */}
        <div class="slv-card rounded-3xl p-8 sm:p-12 border border-[#E5A93C]/40 bg-gradient-to-b from-[#14161c] to-[#0c0d10] text-center mb-16 shadow-[0_20px_50px_rgba(0,0,0,0.8)]">
          <ShieldCheck class="w-12 h-12 text-[#E5A93C] mx-auto mb-4" />
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-3">
            Need Expert Environmental Tick Management?
          </h2>
          <p class="text-zinc-300 text-xs sm:text-sm max-w-lg mx-auto mb-6 leading-relaxed">
            Protect your property with targeted crack, crevice, and perimeter barrier treatments. Pricing provided after thorough on-site inspection.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
              href="/services/tick-control"
              class="slv-btn-primary px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
            >
              <span>Tick Control</span>
              <ArrowRight class="w-4 h-4 ml-1" />
            </a>
            <a
              href="tel:9180397822"
              class="slv-btn-secondary px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
            >
              <Phone class="w-4 h-4 text-[#F6C453] mr-1" />
              <span>Call: 91803 97822</span>
            </a>
            <a
              href="https://wa.me/9180397822"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-md inline-flex items-center transition"
            >
              <MessageCircle class="w-4 h-4 mr-1 text-white" />
              <span>WhatsApp Us</span>
            </a>
          </div>
        </div>

        {/* Related Knowledge Hub Articles */}
        <div>
          <div class="flex items-center gap-2 mb-6">
            <BookOpen class="w-4 h-4 text-[#E5A93C]" />
            <h2 class="text-xl font-bold text-white font-heading">
              Explore More Tick Guides
            </h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {relatedArticles.map((article) => (
              <a
                href={article.href}
                class="slv-card rounded-2xl p-5 border border-white/[0.08] hover:border-[#E5A93C]/50 transition block group"
              >
                <h3 class="text-sm font-bold text-white group-hover:text-[#F6C453] transition mb-1.5 flex items-center justify-between">
                  <span>{article.title}</span>
                  <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                </h3>
                <p class="text-zinc-400 text-xs leading-relaxed">{article.desc}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* CONTACT & SERVICE DETAILS */}
    <section class="relative z-10 py-14 sm:py-18 bg-[#0c0d10]/50 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="slv-card rounded-3xl p-6 sm:p-10 border border-white/[0.08]">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs">
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Bangalore Service Office</span>
              <p class="text-white text-sm">143 Soundarya Layout, Doddabidarakallu, Bangalore 560073</p>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Phone / WhatsApp</span>
              <a href="tel:9180397822" class="text-white text-sm font-bold font-mono hover:text-[#FFE08A]">91803 97822</a>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Email Support</span>
              <a href="mailto:contact@slvpestcontrol.com" class="text-white text-sm hover:text-[#FFE08A]">contact@slvpestcontrol.com</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingActions client:load />
</Layout>
