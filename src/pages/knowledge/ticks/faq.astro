---
import Layout from '../../../layouts/Layout.astro';
import { Header } from '../../../components/Header';
import { Footer } from '../../../components/Footer';
import { FloatingActions } from '../../../components/FloatingActions';
import {
  BookOpen,
  HelpCircle,
  ShieldCheck,
  ArrowRight,
  Phone,
  MessageCircle,
  Mail,
  MapPin,
  AlertTriangle
} from 'lucide-react';

const relatedArticles = [
  {
    title: 'Tick Identification',
    desc: 'Recognize what ticks look like, visible wall signs, and pet indicators.',
    href: '/knowledge/ticks/identification'
  },
  {
    title: 'Where Ticks Hide',
    desc: 'Inspect pet resting zones, upholstery, wall cracks, and shaded gardens.',
    href: '/knowledge/ticks/where-they-hide'
  },
  {
    title: 'How Ticks Spread',
    desc: 'Understand entry vectors through domestic pets, vegetation, and outdoor walks.',
    href: '/knowledge/ticks/how-they-spread'
  },
  {
    title: 'Tick Prevention',
    desc: 'Actionable environmental hygiene, bedding sanitation, and structural sealing.',
    href: '/knowledge/ticks/prevention'
  },
  {
    title: 'Tick Treatment Guide',
    desc: 'Our structured 4-stage environmental protocol: inspection, source assessment, treatment, and follow-up.',
    href: '/knowledge/ticks/treatment-guide'
  }
];

const faqs = [
  {
    q: 'How do I know if I have ticks around my property?',
    a: 'Common indicators include noticing live ticks crawling upward along walls, door trims, or curtain pleats; observing seed-like ticks attached to pets (around ears, neck, or paws); and discovering small tick clusters within pet crates, bedding seams, or wooden kennel joints.'
  },
  {
    q: 'Where do ticks usually hide?',
    a: 'Ticks hide in protected, dark harbourages close to where pets rest. Indoors, they shelter in pet bedding seams, behind baseboards, in vertical wall cracks, and within upholstery folds. Outdoors, they occupy shaded kennel corners, exterior compound wall crevices, and garden margins.'
  },
  {
    q: 'How do ticks enter a property?',
    a: 'Ticks are typically introduced when domestic pets pick them up from outdoor environments such as neighborhood parks, vegetated footpaths, or contact with other animals during daily walks. Once carried indoors, fed ticks drop off and establish harbourages within building cracks.'
  },
  {
    q: 'Can pets contribute to tick activity?',
    a: 'Yes. Domestic pets serve as the primary host for the Brown Dog Tick (Rhipicephalus sanguineus). When pets travel through areas with tick presence, they can unknowingly introduce ticks into the household environment.'
  },
  {
    q: 'How much does tick control cost?',
    a: 'At SLV Pest Control, pricing is provided after inspection. The investment depends on property dimensions, the extent of indoor wall crevices, pet resting areas, and whether outdoor compound perimeters, lawns, or kennels require treatment.'
  },
  {
    q: 'Is inspection required?',
    a: 'Yes. An initial on-site property inspection is essential. It enables our technician to assess the severity of infestation, locate focal harbourages both indoors and outdoors, and customize the environmental treatment approach to property conditions.'
  },
  {
    q: 'How long does tick treatment take?',
    a: 'A typical residential premises treatment takes approximately 45 to 90 minutes, depending on the number of rooms, presence of external compound walls, and the scale of pet kennel facilities.'
  },
  {
    q: 'What preparation is required?',
    a: 'Before premises treatment, clear pet bedding for separate hot laundering, move lightweight furniture slightly away from wall baseboards to allow perimeter access, and keep pets and family members safely outside the specific areas being treated during application.'
  },
  {
    q: 'What should I do after treatment?',
    a: 'Allow treated surfaces to dry completely before re-entering (typically 1 to 2 hours, as advised by the technician). Continue washing pet bedding regularly, inspect pets after walks, and follow the technician\'s environmental prevention recommendations.'
  },
  {
    q: 'Can tick activity return?',
    a: 'Yes. Tick activity can recur if pets re-encounter ticks outdoors in public parks or neighborhood grounds and carry them back indoors, or if unhatched eggs in deep unsealed masonry voids emerge. Continuous monitoring, pet checking, and environmental hygiene help minimize recurrence.'
  },
  {
    q: 'Do you treat homes and apartments?',
    a: 'Yes. SLV Pest Control provides professional tick management for independent villas, gated community apartments, paying guest accommodations, and rental properties across Bangalore.'
  },
  {
    q: 'Do you treat outdoor areas?',
    a: 'Yes. Where appropriate and indicated by inspection, we treat external compound perimeter walls, kennel structures, veranda crevices, and shaded paved borders to address outdoor harbourage reservoirs.'
  },
  {
    q: 'Should pets be checked by a veterinarian?',
    a: 'Yes, absolutely. Environmental pest control treats premises, walls, and structures—it does not treat ticks on living animals. We strongly advise pet owners to consult a qualified veterinarian for appropriate on-pet treatments and preventive health recommendations.'
  }
];
---

<Layout
  title="Tick Control FAQ | Questions & Factual Answers | SLV Pest Control"
  description="Answers to frequently asked questions about tick control in Bangalore: identification, hiding habits, inspection, costs, preparation, pets, and outdoor areas."
  canonical="https://slvpestcontrol.com/knowledge/ticks/faq"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "@id": "https://slvpestcontrol.com/knowledge/ticks/faq#faq",
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      }))
    })} />
  </Fragment>

  <Header client:load activeItem="knowledge" />

  <main class="flex-1 w-full relative overflow-hidden bg-[#090a0c]">
    {/* Architectural Glow */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 right-1/4 w-[500px] h-[500px] bg-[#E5A93C]/[0.06] rounded-full blur-[140px]"></div>
      <div class="absolute top-[40%] left-[-100px] w-[500px] h-[500px] bg-[#E5A93C]/[0.04] rounded-full blur-[160px]"></div>
    </div>

    {/* Breadcrumbs: Home > Knowledge Hub > Ticks > Tick FAQ */}
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs text-zinc-400">
        <a href="/" class="hover:text-white transition">Home</a>
        <span>&gt;</span>
        <a href="/knowledge" class="hover:text-white transition">Knowledge Hub</a>
        <span>&gt;</span>
        <a href="/services/tick-control" class="hover:text-white transition">Ticks</a>
        <span>&gt;</span>
        <span class="text-[#F6C453] font-semibold">Tick FAQ</span>
      </nav>
    </div>

    {/* HERO */}
    <section class="relative z-10 pt-10 sm:pt-14 pb-12 sm:pb-16 border-b border-white/[0.06]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 mb-4 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-md">
          <HelpCircle class="w-3.5 h-3.5 text-[#E5A93C]" />
          <span class="text-[#E5A93C] text-xs font-extrabold tracking-[0.2em] uppercase">
            FREQUENTLY ASKED QUESTIONS
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-5 font-heading">
          Frequently Asked Questions About <span class="slv-gold-text">Tick Control</span>
        </h1>

        <p class="text-zinc-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto mb-8">
          Clear, factual answers regarding tick behavior, hiding habits, property preparation, inspection protocols, and premises safety across Bangalore.
        </p>

        {/* Primary CTA */}
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
          <a
            href="/services/tick-control"
            class="slv-btn-primary w-full sm:w-auto px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <span>Get Free Inspection</span>
            <ArrowRight class="w-4 h-4 ml-1" />
          </a>
          <a
            href="tel:9180397822"
            class="slv-btn-secondary w-full sm:w-auto px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <Phone class="w-4 h-4 text-[#F6C453] mr-1" />
            <span>Call: 91803 97822</span>
          </a>
          <a
            href="https://wa.me/9180397822"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-md inline-flex items-center transition"
          >
            <MessageCircle class="w-4 h-4 mr-1 text-white" />
            <span>WhatsApp</span>
          </a>
        </div>
      </div>
    </section>

    {/* FAQS CARDS SECTION */}
    <section class="relative z-10 py-14 sm:py-20 border-b border-white/[0.06]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="space-y-4 mb-16">
          {faqs.map((faq, index) => (
            <div class="slv-card rounded-2xl p-6 sm:p-7 border border-white/[0.08] transition hover:border-[#E5A93C]/40">
              <div class="flex items-start gap-3.5 mb-2.5">
                <span class="text-xs font-mono font-bold text-[#F6C453] bg-[#E5A93C]/10 px-2 py-0.5 rounded shrink-0 mt-0.5">
                  Q{index + 1 < 10 ? `0${index + 1}` : index + 1}
                </span>
                <h2 class="text-base sm:text-lg font-bold text-white font-heading">
                  {faq.q}
                </h2>
              </div>
              <p class="text-zinc-300 text-xs sm:text-sm leading-relaxed pl-10">
                {faq.a}
              </p>
            </div>
          ))}
        </div>

        {/* CTA Banner */}
        <div class="slv-card rounded-3xl p-8 sm:p-12 border border-[#E5A93C]/40 bg-gradient-to-b from-[#14161c] to-[#0c0d10] text-center mb-16 shadow-[0_20px_50px_rgba(0,0,0,0.8)]">
          <ShieldCheck class="w-12 h-12 text-[#E5A93C] mx-auto mb-4" />
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-3">
            Have More Questions About Tick Management?
          </h2>
          <p class="text-zinc-300 text-xs sm:text-sm max-w-lg mx-auto mb-6 leading-relaxed">
            Speak directly with SLV Pest Control technicians for personalized advice or schedule an on-site property inspection. Pricing provided after inspection.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
              href="/services/tick-control"
              class="slv-btn-primary px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
            >
              <span>Get Free Inspection</span>
              <ArrowRight class="w-4 h-4 ml-1" />
            </a>
            <a
              href="tel:9180397822"
              class="slv-btn-secondary px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
            >
              <Phone class="w-4 h-4 text-[#F6C453] mr-1" />
              <span>Call: 91803 97822</span>
            </a>
            <a
              href="https://wa.me/9180397822"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-md inline-flex items-center transition"
            >
              <MessageCircle class="w-4 h-4 mr-1 text-white" />
              <span>WhatsApp Us</span>
            </a>
          </div>
        </div>

        {/* Related Knowledge Hub Articles */}
        <div>
          <div class="flex items-center gap-2 mb-6">
            <BookOpen class="w-4 h-4 text-[#E5A93C]" />
            <h2 class="text-xl font-bold text-white font-heading">
              Explore More Tick Guides
            </h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {relatedArticles.map((article) => (
              <a
                href={article.href}
                class="slv-card rounded-2xl p-5 border border-white/[0.08] hover:border-[#E5A93C]/50 transition block group"
              >
                <h3 class="text-sm font-bold text-white group-hover:text-[#F6C453] transition mb-1.5 flex items-center justify-between">
                  <span>{article.title}</span>
                  <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                </h3>
                <p class="text-zinc-400 text-xs leading-relaxed">{article.desc}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* CONTACT & SERVICE DETAILS */}
    <section class="relative z-10 py-14 sm:py-18 bg-[#0c0d10]/50 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="slv-card rounded-3xl p-6 sm:p-10 border border-white/[0.08]">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs">
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Bangalore Service Office</span>
              <p class="text-white text-sm">143 Soundarya Layout, Doddabidarakallu, Bangalore 560073</p>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Phone / WhatsApp</span>
              <a href="tel:9180397822" class="text-white text-sm font-bold font-mono hover:text-[#FFE08A]">91803 97822</a>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Email Support</span>
              <a href="mailto:contact@slvpestcontrol.com" class="text-white text-sm hover:text-[#FFE08A]">contact@slvpestcontrol.com</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingActions client:load />
</Layout>
