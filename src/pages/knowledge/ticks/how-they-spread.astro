---
import Layout from '../../../layouts/Layout.astro';
import { Header } from '../../../components/Header';
import { Footer } from '../../../components/Footer';
import { FloatingActions } from '../../../components/FloatingActions';
import {
  BookOpen,
  Search,
  Eye,
  Layers,
  Sparkles,
  AlertTriangle,
  CheckCircle2,
  ArrowRight,
  Phone,
  MessageCircle,
  Mail,
  MapPin,
  ShieldCheck,
  PawPrint,
  TreePine,
  Activity,
  Home
} from 'lucide-react';

const relatedArticles = [
  {
    title: 'Tick Identification',
    desc: 'Recognize what ticks look like, visible wall signs, and pet indicators.',
    href: '/knowledge/ticks/identification'
  },
  {
    title: 'Where Ticks Hide',
    desc: 'Inspect pet resting zones, upholstery, wall cracks, and shaded gardens.',
    href: '/knowledge/ticks/where-they-hide'
  },
  {
    title: 'Tick Prevention',
    desc: 'Actionable environmental hygiene, bedding sanitation, and structural sealing.',
    href: '/knowledge/ticks/prevention'
  },
  {
    title: 'Tick Treatment Guide',
    desc: 'Our structured 4-stage environmental protocol: inspection, source assessment, treatment, and follow-up.',
    href: '/knowledge/ticks/treatment-guide'
  },
  {
    title: 'Tick FAQ',
    desc: 'Clear, factual answers to 13 common questions regarding tick management.',
    href: '/knowledge/ticks/faq'
  }
];

const spreadMechanisms = [
  {
    title: 'Pets & Domestic Animals',
    desc: 'The primary introduction pathway into Bangalore residences. Dogs walking through outdoor paths, parks, or community grounds brush against vegetation or interact with other animals, allowing questing ticks to latch onto their fur.',
    icon: PawPrint
  },
  {
    title: 'Outdoor Environments & Grounds',
    desc: 'Open parks, vacant neighborhood plots, roadside grassy verges, and common apartment dog-walking lawns harbor ticks waiting for passing animal hosts.',
    icon: TreePine
  },
  {
    title: 'Vegetation & Questing Behavior',
    desc: 'Ticks position themselves on the tips of tall grass blades, garden weeds, and low shrub branches with outstretched forelegs. When an animal or host brushes past, the tick grasps the hair or fabric instantly.',
    icon: Activity
  },
  {
    title: 'Bedding & Animal Resting Areas',
    desc: 'Once carried indoors on a pet, engorged ticks drop off into sleeping mats, carpets, or kennel bedding. In warm indoor climates, eggs hatch and hundreds of tiny larvae disperse outward into adjoining rooms.',
    icon: Home
  },
  {
    title: 'Movement Through Infested Premises',
    desc: 'Because the Brown Dog Tick is capable of completing its lifecycle indoors, newly molted nymphs and adults crawl upward along wall cracks, doorframes, and electrical conduits to locate secondary resting spots or new hosts.',
    icon: Layers
  },
  {
    title: 'Shared Corridors & Boundary Walls',
    desc: 'In multi-unit apartment complexes or terraced villas with shared compound walls, ticks can crawl across exterior boundaries from adjoining gardens or neighbouring kennels.',
    icon: Search
  }
];
---

<Layout
  title="How Ticks Spread | Entry Pathways & Environmental Transfer | SLV Pest Control"
  description="Learn how ticks enter and spread through Bangalore homes via pets, outdoor walks, vegetation, and shared resting zones. Practical advice from SLV Pest Control."
  canonical="https://slvpestcontrol.com/knowledge/ticks/how-they-spread"
>
  <Header client:load activeItem="knowledge" />

  <main class="flex-1 w-full relative overflow-hidden bg-[#090a0c]">
    {/* Architectural Glow */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 right-1/4 w-[500px] h-[500px] bg-[#E5A93C]/[0.06] rounded-full blur-[140px]"></div>
      <div class="absolute top-[40%] left-[-100px] w-[500px] h-[500px] bg-[#E5A93C]/[0.04] rounded-full blur-[160px]"></div>
    </div>

    {/* Breadcrumbs: Home > Knowledge Hub > Ticks > How Ticks Spread */}
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs text-zinc-400">
        <a href="/" class="hover:text-white transition">Home</a>
        <span>&gt;</span>
        <a href="/knowledge" class="hover:text-white transition">Knowledge Hub</a>
        <span>&gt;</span>
        <a href="/services/tick-control" class="hover:text-white transition">Ticks</a>
        <span>&gt;</span>
        <span class="text-[#F6C453] font-semibold">How Ticks Spread</span>
      </nav>
    </div>

    {/* HERO */}
    <section class="relative z-10 pt-10 sm:pt-14 pb-12 sm:pb-16 border-b border-white/[0.06]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 mb-4 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-md">
          <BookOpen class="w-3.5 h-3.5 text-[#E5A93C]" />
          <span class="text-[#E5A93C] text-xs font-extrabold tracking-[0.2em] uppercase">
            DISPERSAL &amp; PATHWAYS
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-5 font-heading">
          How Ticks Spread &amp; <span class="slv-gold-text">Enter Properties</span>
        </h1>

        <p class="text-zinc-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto mb-8">
          Understanding the pathways by which ticks are introduced into Bangalore residences through domestic animals, outdoor exposure, and structural movement.
        </p>

        {/* Primary CTA */}
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
          <a
            href="/services/tick-control"
            class="slv-btn-primary w-full sm:w-auto px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <span>Get Tick Control</span>
            <ArrowRight class="w-4 h-4 ml-1" />
          </a>
          <a
            href="tel:9180397822"
            class="slv-btn-secondary w-full sm:w-auto px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <Phone class="w-4 h-4 text-[#F6C453] mr-1" />
            <span>Call: 91803 97822</span>
          </a>
          <a
            href="https://wa.me/9180397822"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-md inline-flex items-center transition"
          >
            <MessageCircle class="w-4 h-4 mr-1 text-white" />
            <span>WhatsApp</span>
          </a>
        </div>
      </div>
    </section>

    {/* CONTENT SECTION */}
    <section class="relative z-10 py-14 sm:py-20 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        {/* Core Concept: Introduction via Animals & Outdoor Exposure */}
        <div class="slv-card rounded-3xl p-8 sm:p-10 border border-white/[0.08] mb-12">
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-4">
            How Ticks Are Introduced Into Properties
          </h2>
          <div class="space-y-4 text-zinc-300 text-sm sm:text-base leading-relaxed">
            <p>
              Ticks do not fly or jump. Instead, they rely on direct contact with passing hosts or mechanical transfer. In residential communities across Bangalore, ticks are almost universally introduced into properties through domestic animals and outdoor environmental exposure.
            </p>
            <p>
              When a pet exercises in a park, walks along a grass verge, or enters a neighborhood with outdoor tick activity, hungry ticks transfer onto the animal’s coat. Once inside the residence, engorged ticks drop from the animal, find secluded hiding spots in baseboards or bedding, and start producing offspring.
            </p>
            <div class="p-4 rounded-xl bg-white/[0.03] border border-white/[0.08] text-xs sm:text-sm text-zinc-300 flex items-start gap-3">
              <AlertTriangle class="w-5 h-5 text-[#E5A93C] shrink-0 mt-0.5" />
              <span>
                <strong>Factual Scope Note:</strong> This guide addresses physical and environmental transfer mechanisms of ticks within properties. We do not provide medical diagnosis or disease transmission claims. Pet health management should always be coordinated directly with a licensed veterinarian.
              </span>
            </div>
          </div>
        </div>

        {/* 6 Spread Mechanisms Grid */}
        <div class="mb-14">
          <div class="text-center max-w-2xl mx-auto mb-10">
            <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-2">TRANSFER PATHWAYS</span>
            <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
              Primary Pathways of Spread
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {spreadMechanisms.map((mech) => {
              const Icon = mech.icon;
              return (
                <div class="slv-card rounded-2xl p-6 border border-white/[0.08] flex flex-col justify-between">
                  <div>
                    <div class="w-10 h-10 rounded-xl bg-[#E5A93C]/10 border border-[#E5A93C]/20 flex items-center justify-center text-[#E5A93C] mb-4">
                      <Icon class="w-5 h-5" />
                    </div>
                    <h3 class="text-lg font-bold text-white mb-2 font-heading">{mech.title}</h3>
                    <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed">{mech.desc}</p>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        {/* Indoor Dispersal Mechanics */}
        <div class="slv-card rounded-3xl p-8 sm:p-10 border border-white/[0.08] mb-14">
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-6">
            The Indoor Dispersal Cycle of Brown Dog Ticks
          </h2>
          <div class="space-y-4 text-zinc-300 text-sm leading-relaxed">
            <p>
              Unlike many outdoor tick species that require continuous soil moisture, the Brown Dog Tick (<em>Rhipicephalus sanguineus</em>) is uniquely equipped to establish reproducing colonies entirely within dry building structures:
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
              <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.05]">
                <span class="text-[#F6C453] font-bold block mb-1">1. Host Drop-off</span>
                <span class="text-zinc-400 text-xs">Fed ticks detach from the host pet and seek low hiding spaces in rugs and baseboards.</span>
              </div>
              <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.05]">
                <span class="text-[#F6C453] font-bold block mb-1">2. Upward Migration</span>
                <span class="text-zinc-400 text-xs">Ticks crawl upward along plaster walls and door trims to find secluded crevices for molting or oviposition.</span>
              </div>
              <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.05]">
                <span class="text-[#F6C453] font-bold block mb-1">3. Re-infestation</span>
                <span class="text-zinc-400 text-xs">New generations emerge from structural cracks and seek the pet when it returns to rest.</span>
              </div>
            </div>
          </div>
        </div>

        {/* CTA Banner */}
        <div class="slv-card rounded-3xl p-8 sm:p-12 border border-[#E5A93C]/40 bg-gradient-to-b from-[#14161c] to-[#0c0d10] text-center mb-16 shadow-[0_20px_50px_rgba(0,0,0,0.8)]">
          <ShieldCheck class="w-12 h-12 text-[#E5A93C] mx-auto mb-4" />
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-3">
            Break the Cycle of Environmental Tick Spread
          </h2>
          <p class="text-zinc-300 text-xs sm:text-sm max-w-lg mx-auto mb-6 leading-relaxed">
            Targeted premises management disrupts environmental harbourage zones in walls and resting spots. Request an on-site property inspection today.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
              href="/services/tick-control"
              class="slv-btn-primary px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
            >
              <span>Get Tick Control</span>
              <ArrowRight class="w-4 h-4 ml-1" />
            </a>
            <a
              href="tel:9180397822"
              class="slv-btn-secondary px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
            >
              <Phone class="w-4 h-4 text-[#F6C453] mr-1" />
              <span>Call: 91803 97822</span>
            </a>
            <a
              href="https://wa.me/9180397822"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-md inline-flex items-center transition"
            >
              <MessageCircle class="w-4 h-4 mr-1 text-white" />
              <span>WhatsApp Us</span>
            </a>
          </div>
        </div>

        {/* Related Knowledge Hub Articles */}
        <div>
          <div class="flex items-center gap-2 mb-6">
            <BookOpen class="w-4 h-4 text-[#E5A93C]" />
            <h2 class="text-xl font-bold text-white font-heading">
              Explore More Tick Guides
            </h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {relatedArticles.map((article) => (
              <a
                href={article.href}
                class="slv-card rounded-2xl p-5 border border-white/[0.08] hover:border-[#E5A93C]/50 transition block group"
              >
                <h3 class="text-sm font-bold text-white group-hover:text-[#F6C453] transition mb-1.5 flex items-center justify-between">
                  <span>{article.title}</span>
                  <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                </h3>
                <p class="text-zinc-400 text-xs leading-relaxed">{article.desc}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* CONTACT & SERVICE DETAILS */}
    <section class="relative z-10 py-14 sm:py-18 bg-[#0c0d10]/50 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="slv-card rounded-3xl p-6 sm:p-10 border border-white/[0.08]">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs">
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Bangalore Service Office</span>
              <p class="text-white text-sm">143 Soundarya Layout, Doddabidarakallu, Bangalore 560073</p>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Phone / WhatsApp</span>
              <a href="tel:9180397822" class="text-white text-sm font-bold font-mono hover:text-[#FFE08A]">91803 97822</a>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Email Support</span>
              <a href="mailto:contact@slvpestcontrol.com" class="text-white text-sm hover:text-[#FFE08A]">contact@slvpestcontrol.com</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingActions client:load />
</Layout>
