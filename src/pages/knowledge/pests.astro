---
import Layout from '../../layouts/Layout.astro';
import { Header } from '../../components/Header';
import { Footer } from '../../components/Footer';
import { FloatingActions } from '../../components/FloatingActions';
import { PestLibraryFilter } from '../../components/PestLibraryFilter';
import {
  Bug,
  BookOpen,
  ArrowRight,
  Phone,
  MessageCircle,
  ShieldCheck,
  Search,
  AlertTriangle,
  HelpCircle,
  CheckCircle2,
  ExternalLink,
  ChevronRight,
  FileText
} from 'lucide-react';
---

<Layout
  title="Bangalore Pest Library | Comprehensive Identification & Profiles | SLV Pest Control"
  description="Explore detailed biological profiles, early warning signs, infestation hotspots, and targeted treatment pathways for 10 common pests across Bangalore."
>
  <Header client:load activeItem="knowledge" />

  <main class="relative bg-[#08090b] text-white min-h-screen overflow-hidden">
    {/* Subtle Ambient Glows and Hexagonal Pattern */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[550px] bg-[radial-gradient(ellipse_at_center,_rgba(229,169,60,0.08)_0%,_rgba(10,12,16,0)_70%)]"></div>
      <div class="absolute top-[30%] -left-[200px] w-[600px] h-[600px] bg-[radial-gradient(circle,_rgba(6,182,212,0.04)_0%,_rgba(10,12,16,0)_70%)]"></div>
      <div class="absolute bottom-[20%] -right-[200px] w-[600px] h-[600px] bg-[radial-gradient(circle,_rgba(229,169,60,0.05)_0%,_rgba(10,12,16,0)_70%)]"></div>
      <div class="absolute inset-0 opacity-[0.025] slv-hex-bg"></div>
    </div>

    {/* BREADCRUMB NAVIGATION */}
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
      <nav class="flex items-center gap-2 text-xs text-zinc-400">
        <a href="/" class="hover:text-white transition">Home</a>
        <ChevronRight class="w-3.5 h-3.5 text-zinc-600" />
        <a href="/knowledge" class="hover:text-white transition">Knowledge Hub</a>
        <ChevronRight class="w-3.5 h-3.5 text-zinc-600" />
        <span class="text-[#F6C453] font-semibold">Pest Library</span>
      </nav>
    </div>

    {/* HERO SECTION */}
    <section class="relative z-10 pt-8 sm:pt-12 pb-10 border-b border-white/[0.06]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        {/* Module Badge */}
        <div class="inline-flex items-center gap-2 mb-4 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-md">
          <Bug class="w-3.5 h-3.5 text-[#E5A93C]" />
          <span class="text-[#E5A93C] text-xs font-extrabold tracking-[0.22em] uppercase">
            Module 01 • Biological Field Directory
          </span>
        </div>

        {/* Heading verbatim from mockup */}
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-[1.1] mb-3 font-heading">
          <span class="slv-gold-text">Pest</span> Library
        </h1>

        {/* Subtitle verbatim from mockup */}
        <p class="text-zinc-300 text-sm sm:text-base leading-relaxed max-w-2xl mx-auto mb-6 font-normal">
          Identify common pests, learn about their signs, habitats and risks.
        </p>

        {/* Four Main Educational Hub Navigation Pills */}
        <div class="flex flex-wrap items-center justify-center gap-2 text-xs font-semibold mb-8">
          <a
            href="/knowledge"
            class="px-3.5 py-2 rounded-xl bg-white/[0.04] border border-white/[0.1] text-zinc-300 hover:text-white hover:border-[#F6C453] transition font-bold"
          >
            1. Knowledge Hub
          </a>
          <a
            href="/knowledge/pests"
            class="px-3.5 py-2 rounded-xl bg-[#E5A93C]/15 border border-[#E5A93C]/40 text-[#F6C453] font-bold shadow-[0_0_15px_rgba(229,169,60,0.15)]"
          >
            2. Pest Library
          </a>
          <a
            href="/knowledge/treatment"
            class="px-3.5 py-2 rounded-xl bg-white/[0.04] border border-white/[0.1] text-zinc-300 hover:text-white hover:border-[#F6C453] transition font-bold"
          >
            3. Treatment &amp; Prevention
          </a>
          <a
            href="/knowledge/seasonal"
            class="px-3.5 py-2 rounded-xl bg-white/[0.04] border border-white/[0.1] text-zinc-300 hover:text-white hover:border-[#F6C453] transition font-bold"
          >
            4. Seasonal Pest Guide
          </a>
        </div>

        {/* Fast Action Buttons */}
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            href="tel:9180397822"
            class="slv-btn-primary px-5 py-2.5 text-xs sm:text-sm font-bold uppercase tracking-wider inline-flex items-center gap-2 shadow-[0_0_20px_rgba(229,169,60,0.3)]"
          >
            <Phone class="w-4 h-4 text-[#1a1202]" />
            <span>Call: 91803 97822</span>
          </a>
          <a
            href="https://wa.me/9180397822?text=Hello%20SLV%20Pest%20Control%2C%20I%20need%20help%20identifying%20a%20pest%20in%20my%20home"
            target="_blank"
            rel="noopener noreferrer"
            class="slv-btn-secondary px-5 py-2.5 text-xs sm:text-sm font-bold uppercase tracking-wider inline-flex items-center gap-2 border-emerald-500/30 text-emerald-400 hover:text-white hover:border-emerald-400 hover:bg-emerald-500/10"
          >
            <MessageCircle class="w-4 h-4 text-emerald-400" />
            <span>Send Pest Photo on WhatsApp</span>
          </a>
          <a
            href="/knowledge/treatment"
            class="px-4 py-2.5 rounded-xl bg-white/[0.04] border border-white/[0.1] text-xs font-bold text-zinc-300 hover:text-white hover:bg-white/[0.08] transition inline-flex items-center gap-1.5"
          >
            <span>Next: Treatment &amp; Prevention</span>
            <ArrowRight class="w-3.5 h-3.5 text-[#E5A93C]" />
          </a>
        </div>
      </div>
    </section>

    {/* MOCKUP 8 CORE PEST CARDS GRID (2 ROWS × 4 COLUMNS) */}
    <section class="relative z-10 py-12 border-b border-white/[0.06] bg-black/20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
          {/* 1. Cockroach */}
          <a
            href="/services/cockroach-control"
            class="slv-card rounded-2xl p-5 border border-white/[0.08] hover:border-amber-400/60 transition-all flex flex-col items-center text-center justify-between group bg-[#0e1014]/90 relative overflow-hidden"
          >
            <div class="w-16 h-16 mb-3 relative flex items-center justify-center">
              <div class="absolute inset-0 bg-gradient-to-br from-[#FFE08A]/15 to-[#D99A18]/25 border border-[#E5A93C]/40 rotate-45 rounded-xl group-hover:rotate-90 transition-transform duration-500"></div>
              <img src="/cockroach-icon.png" alt="Cockroach" data-image-component="true" class="w-10 h-10 object-contain relative z-10" />
            </div>
            <div>
              <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-[#F6C453] transition mb-1 font-heading">
                Cockroach
              </h3>
              <p class="text-[11px] text-zinc-400 font-mono tracking-wide mb-4">
                Signs • Habitat • Risks
              </p>
            </div>
            <div class="w-8 h-8 rounded-full bg-amber-500/20 border border-amber-500/40 text-amber-400 flex items-center justify-center group-hover:bg-amber-500 group-hover:text-black transition-all">
              <ArrowRight class="w-4 h-4 font-bold" />
            </div>
          </a>

          {/* 2. Termite */}
          <a
            href="/services/termites"
            class="slv-card rounded-2xl p-5 border border-white/[0.08] hover:border-emerald-400/60 transition-all flex flex-col items-center text-center justify-between group bg-[#0e1014]/90 relative overflow-hidden"
          >
            <div class="w-16 h-16 mb-3 relative flex items-center justify-center">
              <div class="absolute inset-0 bg-gradient-to-br from-emerald-400/15 to-teal-500/25 border border-emerald-400/40 rotate-45 rounded-xl group-hover:rotate-90 transition-transform duration-500"></div>
              <img src="/beetle-banner.png" alt="Termite" data-image-component="true" class="w-10 h-10 object-contain relative z-10" />
            </div>
            <div>
              <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-emerald-400 transition mb-1 font-heading">
                Termite
              </h3>
              <p class="text-[11px] text-zinc-400 font-mono tracking-wide mb-4">
                Signs • Habitat • Risks
              </p>
            </div>
            <div class="w-8 h-8 rounded-full bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 flex items-center justify-center group-hover:bg-emerald-500 group-hover:text-black transition-all">
              <ArrowRight class="w-4 h-4 font-bold" />
            </div>
          </a>

          {/* 3. Bed Bug */}
          <a
            href="/services/bed-bugs"
            class="slv-card rounded-2xl p-5 border border-white/[0.08] hover:border-orange-400/60 transition-all flex flex-col items-center text-center justify-between group bg-[#0e1014]/90 relative overflow-hidden"
          >
            <div class="w-16 h-16 mb-3 relative flex items-center justify-center">
              <div class="absolute inset-0 bg-gradient-to-br from-orange-400/15 to-red-500/25 border border-orange-400/40 rotate-45 rounded-xl group-hover:rotate-90 transition-transform duration-500"></div>
              <img src="/bedbug.png" alt="Bed Bug" data-image-component="true" class="w-10 h-10 object-contain relative z-10" />
            </div>
            <div>
              <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-orange-400 transition mb-1 font-heading">
                Bed Bug
              </h3>
              <p class="text-[11px] text-zinc-400 font-mono tracking-wide mb-4">
                Signs • Habitat • Risks
              </p>
            </div>
            <div class="w-8 h-8 rounded-full bg-orange-500/20 border border-orange-500/40 text-orange-400 flex items-center justify-center group-hover:bg-orange-500 group-hover:text-black transition-all">
              <ArrowRight class="w-4 h-4 font-bold" />
            </div>
          </a>

          {/* 4. Ant */}
          <a
            href="/knowledge/pests/ants"
            class="slv-card rounded-2xl p-5 border border-white/[0.08] hover:border-rose-400/60 transition-all flex flex-col items-center text-center justify-between group bg-[#0e1014]/90 relative overflow-hidden"
          >
            <div class="w-16 h-16 mb-3 relative flex items-center justify-center">
              <div class="absolute inset-0 bg-gradient-to-br from-rose-400/15 to-amber-500/25 border border-rose-400/40 rotate-45 rounded-xl group-hover:rotate-90 transition-transform duration-500"></div>
              <img src="/ant-icon.png" alt="Ant" data-image-component="true" class="w-10 h-10 object-contain relative z-10" />
            </div>
            <div>
              <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-rose-400 transition mb-1 font-heading">
                Ant
              </h3>
              <p class="text-[11px] text-zinc-400 font-mono tracking-wide mb-4">
                Signs • Habitat • Risks
              </p>
            </div>
            <div class="w-8 h-8 rounded-full bg-rose-500/20 border border-rose-500/40 text-rose-400 flex items-center justify-center group-hover:bg-rose-500 group-hover:text-black transition-all">
              <ArrowRight class="w-4 h-4 font-bold" />
            </div>
          </a>

          {/* 5. Mosquito */}
          <a
            href="/services/mosquitoes"
            class="slv-card rounded-2xl p-5 border border-white/[0.08] hover:border-cyan-400/60 transition-all flex flex-col items-center text-center justify-between group bg-[#0e1014]/90 relative overflow-hidden"
          >
            <div class="w-16 h-16 mb-3 relative flex items-center justify-center">
              <div class="absolute inset-0 bg-gradient-to-br from-cyan-400/15 to-blue-500/25 border border-cyan-400/40 rotate-45 rounded-xl group-hover:rotate-90 transition-transform duration-500"></div>
              <img src="/fly-banner.png" alt="Mosquito" data-image-component="true" class="w-10 h-10 object-contain relative z-10" />
            </div>
            <div>
              <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-cyan-400 transition mb-1 font-heading">
                Mosquito
              </h3>
              <p class="text-[11px] text-zinc-400 font-mono tracking-wide mb-4">
                Signs • Habitat • Risks
              </p>
            </div>
            <div class="w-8 h-8 rounded-full bg-cyan-500/20 border border-cyan-500/40 text-cyan-400 flex items-center justify-center group-hover:bg-cyan-500 group-hover:text-black transition-all">
              <ArrowRight class="w-4 h-4 font-bold" />
            </div>
          </a>

          {/* 6. Rodent */}
          <a
            href="/services/rodents"
            class="slv-card rounded-2xl p-5 border border-white/[0.08] hover:border-blue-400/60 transition-all flex flex-col items-center text-center justify-between group bg-[#0e1014]/90 relative overflow-hidden"
          >
            <div class="w-16 h-16 mb-3 relative flex items-center justify-center">
              <div class="absolute inset-0 bg-gradient-to-br from-blue-400/15 to-indigo-500/25 border border-blue-400/40 rotate-45 rounded-xl group-hover:rotate-90 transition-transform duration-500"></div>
              <img src="/rat-icon.png" alt="Rodent" data-image-component="true" class="w-10 h-10 object-contain relative z-10" />
            </div>
            <div>
              <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-blue-400 transition mb-1 font-heading">
                Rodent
              </h3>
              <p class="text-[11px] text-zinc-400 font-mono tracking-wide mb-4">
                Signs • Habitat • Risks
              </p>
            </div>
            <div class="w-8 h-8 rounded-full bg-blue-500/20 border border-blue-500/40 text-blue-400 flex items-center justify-center group-hover:bg-blue-500 group-hover:text-black transition-all">
              <ArrowRight class="w-4 h-4 font-bold" />
            </div>
          </a>

          {/* 7. Flies */}
          <a
            href="/services/fly-control"
            class="slv-card rounded-2xl p-5 border border-white/[0.08] hover:border-zinc-400/60 transition-all flex flex-col items-center text-center justify-between group bg-[#0e1014]/90 relative overflow-hidden"
          >
            <div class="w-16 h-16 mb-3 relative flex items-center justify-center">
              <div class="absolute inset-0 bg-gradient-to-br from-zinc-400/15 to-slate-500/25 border border-zinc-400/40 rotate-45 rounded-xl group-hover:rotate-90 transition-transform duration-500"></div>
              <img src="/fly-banner.png" alt="Flies" data-image-component="true" class="w-10 h-10 object-contain relative z-10" />
            </div>
            <div>
              <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-zinc-300 transition mb-1 font-heading">
                Flies
              </h3>
              <p class="text-[11px] text-zinc-400 font-mono tracking-wide mb-4">
                Signs • Habitat • Risks
              </p>
            </div>
            <div class="w-8 h-8 rounded-full bg-zinc-500/20 border border-zinc-500/40 text-zinc-300 flex items-center justify-center group-hover:bg-zinc-300 group-hover:text-black transition-all">
              <ArrowRight class="w-4 h-4 font-bold" />
            </div>
          </a>

          {/* 8. Ticks & Fleas */}
          <a
            href="/services/tick-control"
            class="slv-card rounded-2xl p-5 border border-white/[0.08] hover:border-rose-400/60 transition-all flex flex-col items-center text-center justify-between group bg-[#0e1014]/90 relative overflow-hidden"
          >
            <div class="w-16 h-16 mb-3 relative flex items-center justify-center">
              <div class="absolute inset-0 bg-gradient-to-br from-rose-500/15 to-red-600/25 border border-rose-500/40 rotate-45 rounded-xl group-hover:rotate-90 transition-transform duration-500"></div>
              <img src="/tick-icon.png" alt="Ticks & Fleas" data-image-component="true" class="w-10 h-10 object-contain relative z-10" />
            </div>
            <div>
              <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-rose-400 transition mb-1 font-heading">
                Ticks &amp; Fleas
              </h3>
              <p class="text-[11px] text-zinc-400 font-mono tracking-wide mb-4">
                Signs • Habitat • Risks
              </p>
            </div>
            <div class="w-8 h-8 rounded-full bg-rose-500/20 border border-rose-500/40 text-rose-400 flex items-center justify-center group-hover:bg-rose-500 group-hover:text-black transition-all">
              <ArrowRight class="w-4 h-4 font-bold" />
            </div>
          </a>
        </div>
      </div>
    </section>

    {/* MAIN DIRECTORY FILTER & PROFILES */}
    <section class="relative z-10 py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-2 font-mono">
            COMPREHENSIVE SPECIES DIRECTORY
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
            Detailed Diagnostic Profiles
          </h2>
          <p class="text-zinc-400 text-xs sm:text-sm mt-1">
            Search or filter by biological category to view identification marks, Bangalore zones, harborage spots, and health risks.
          </p>
        </div>
        <PestLibraryFilter client:load />
      </div>
    </section>

    {/* DIAGNOSTIC COMPARISON MATRIX */}
    <section class="relative z-10 py-12 border-t border-white/[0.06] bg-black/30">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-2">
            DIAGNOSTIC MATRIX
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
            Common Pest Confusion in Bangalore
          </h2>
          <p class="text-zinc-400 text-xs sm:text-sm mt-2">
            Property owners frequently misdiagnose early infestations. Use this comparative criteria before choosing a treatment.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {/* Comparison 1: Bed Bugs vs Fleas */}
          <div class="bg-[#0e1117] border border-white/[0.08] rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4 border-b border-white/[0.06] pb-3">
              <h3 class="text-base font-bold text-white font-heading">
                Bed Bugs vs. Fleas
              </h3>
              <span class="text-[10px] font-mono text-[#E5A93C] uppercase bg-[#E5A93C]/10 px-2 py-0.5 rounded">
                Parasite Comparison
              </span>
            </div>
            <div class="grid grid-cols-2 gap-4 text-xs">
              <div class="bg-black/30 p-3.5 rounded-xl border border-white/[0.04]">
                <strong class="text-[#F6C453] block text-sm mb-1 font-heading">Bed Bugs</strong>
                <ul class="space-y-1.5 text-zinc-300">
                  <li>• Cannot jump or fly; crawls slowly.</li>
                  <li>• Bites clustered on torso, arms, neck.</li>
                  <li>• Stays within 6ft of human beds.</li>
                  <li>• Leaves rusty blood specks on sheets.</li>
                </ul>
              </div>
              <div class="bg-black/30 p-3.5 rounded-xl border border-white/[0.04]">
                <strong class="text-cyan-400 block text-sm mb-1 font-heading">Fleas</strong>
                <ul class="space-y-1.5 text-zinc-300">
                  <li>• Powerful jumpers (up to 20cm).</li>
                  <li>• Bites concentrated on ankles and feet.</li>
                  <li>• Resides in carpet fibers &amp; pet beds.</li>
                  <li>• Leaves black pepper &ldquo;flea dirt&rdquo; in pet fur.</li>
                </ul>
              </div>
            </div>
          </div>

          {/* Comparison 2: Termites vs Carpenter Ants */}
          <div class="bg-[#0e1117] border border-white/[0.08] rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4 border-b border-white/[0.06] pb-3">
              <h3 class="text-base font-bold text-white font-heading">
                Termites vs. Carpenter Ants
              </h3>
              <span class="text-[10px] font-mono text-cyan-400 uppercase bg-cyan-400/10 px-2 py-0.5 rounded">
                Wood-Inhabiting
              </span>
            </div>
            <div class="grid grid-cols-2 gap-4 text-xs">
              <div class="bg-black/30 p-3.5 rounded-xl border border-white/[0.04]">
                <strong class="text-red-400 block text-sm mb-1 font-heading">Subterranean Termites</strong>
                <ul class="space-y-1.5 text-zinc-300">
                  <li>• Consumes cellulose; leaves wood hollow.</li>
                  <li>• Builds brown earthen mud shelter tubes.</li>
                  <li>• Straight antennae; equal wings on swarmers.</li>
                  <li>• Does NOT produce coarse wood shavings.</li>
                </ul>
              </div>
              <div class="bg-black/30 p-3.5 rounded-xl border border-white/[0.04]">
                <strong class="text-amber-300 block text-sm mb-1 font-heading">Carpenter Ants</strong>
                <ul class="space-y-1.5 text-zinc-300">
                  <li>• Excavates wood for nesting; does not eat it.</li>
                  <li>• Piles visible coarse sawdust (frass) below holes.</li>
                  <li>• Elbowed antennae with pinched waist.</li>
                  <li>• Forages openly across kitchen floors.</li>
                </ul>
              </div>
            </div>
          </div>

          {/* Comparison 3: German vs American Cockroach */}
          <div class="bg-[#0e1117] border border-white/[0.08] rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4 border-b border-white/[0.06] pb-3">
              <h3 class="text-base font-bold text-white font-heading">
                German vs. American Cockroach
              </h3>
              <span class="text-[10px] font-mono text-emerald-400 uppercase bg-emerald-400/10 px-2 py-0.5 rounded">
                Cockroach Species
              </span>
            </div>
            <div class="grid grid-cols-2 gap-4 text-xs">
              <div class="bg-black/30 p-3.5 rounded-xl border border-white/[0.04]">
                <strong class="text-amber-400 block text-sm mb-1 font-heading">German Cockroach</strong>
                <ul class="space-y-1.5 text-zinc-300">
                  <li>• Small (12–15mm); light tan with 2 dark stripes.</li>
                  <li>• Lives strictly indoors (kitchen cabinets &amp; appliances).</li>
                  <li>• Fast reproduction cycle; carries egg case.</li>
                  <li>• Requires targeted gel baiting, not sprays.</li>
                </ul>
              </div>
              <div class="bg-black/30 p-3.5 rounded-xl border border-white/[0.04]">
                <strong class="text-amber-600 block text-sm mb-1 font-heading">American Cockroach</strong>
                <ul class="space-y-1.5 text-zinc-300">
                  <li>• Large (35–45mm); glossy reddish-brown.</li>
                  <li>• Originates from sewers, drain pipes, sumps.</li>
                  <li>• Can glide across rooms when startled.</li>
                  <li>• Requires drain trapping &amp; perimeter residual barrier.</li>
                </ul>
              </div>
            </div>
          </div>

          {/* Comparison 4: Rats vs Mice */}
          <div class="bg-[#0e1117] border border-white/[0.08] rounded-2xl p-6">
