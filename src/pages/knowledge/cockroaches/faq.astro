---
import Layout from '../../../layouts/Layout.astro';
import { Header } from '../../../components/Header';
import { Footer } from '../../../components/Footer';
import { FloatingActions } from '../../../components/FloatingActions';
import {
  BookOpen,
  HelpCircle,
  ShieldCheck,
  ArrowRight,
  Phone,
  MessageCircle,
  Mail,
  MapPin,
  UtensilsCrossed
} from 'lucide-react';

const relatedArticles = [
  {
    title: 'Cockroach Identification',
    desc: 'Recognize signs, droppings, egg cases, and distinctive odors.',
    href: '/knowledge/cockroaches/identification'
  },
  {
    title: 'Where Cockroaches Hide',
    desc: 'Discover the top hiding spots in kitchens, drains, and appliances.',
    href: '/knowledge/cockroaches/where-they-hide'
  },
  {
    title: 'How Cockroaches Enter & Spread',
    desc: 'Understand entry pathways through groceries, drains, and building voids.',
    href: '/knowledge/cockroaches/how-they-spread'
  },
  {
    title: 'Cockroach Prevention',
    desc: 'Practical hygiene, moisture reduction, and structural exclusion tips.',
    href: '/knowledge/cockroaches/prevention'
  },
  {
    title: 'Cockroach Treatment Guide',
    desc: 'Professional 4-stage IPM approach from inspection to targeted gel baiting.',
    href: '/knowledge/cockroaches/treatment-guide'
  }
];

const faqs = [
  {
    q: 'How do I know if I have cockroaches?',
    a: 'Key signs include spotting live insects (especially at night when switching on kitchen lights), finding small black droppings resembling ground black pepper, discovering pill-shaped brown egg cases (oothecae) behind appliances or in cabinet hinges, and noticing an oily, musty odour in closed cupboards.'
  },
  {
    q: 'Where do cockroaches usually hide?',
    a: 'Cockroaches hide in dark, warm, and humid micro-environments close to food and water. Common harbourages include modular kitchen cabinet hinges, under-sink plumbing cabinets, refrigerator motor compressors, behind microwaves, under cooking hobs, around drain jali traps, and within pantry food boxes.'
  },
  {
    q: 'Why do cockroaches keep coming back?',
    a: 'Cockroaches often return because: (1) unhatched egg cases survive initial surface sprays and emerge weeks later, (2) new insects hitchhike indoors in grocery delivery cartons, egg crates, or vegetable bags, (3) plumbing drains and shared building shafts allow migration from adjoining flats, or (4) persistent grease and moisture sustain incoming foragers. Sustained prevention and targeted IPM are essential.'
  },
  {
    q: 'How much does cockroach control cost?',
    a: 'Cockroach control at SLV Pest Control starts from ₹599 for standard residential kitchens. The exact price depends on property type (1 BHK, 2 BHK, 3 BHK, villa, PG, or commercial restaurant), square footage, and the severity of the infestation determined during the initial assessment.'
  },
  {
    q: 'Is inspection required?',
    a: 'Yes. An initial inspection enables the technician to accurately identify the specific species (German vs. American), pinpoint primary nesting hotspots, detect plumbing or entry vulnerabilities, and formulate the appropriate treatment approach for your space.'
  },
  {
    q: 'How should I prepare before treatment?',
    a: 'For modern odorless gel baiting, extensive preparation is minimal compared to legacy spraying. You do not need to empty all kitchen crockery. Simply wipe down heavy surface grease, clear excess clutter under the sink, keep baseboards accessible, and inform the technician of suspected activity zones.'
  },
  {
    q: 'How long does treatment take?',
    a: 'A typical residential kitchen and utility treatment takes approximately 30 to 45 minutes depending on the property layout, number of bathrooms, and kitchen dimensions. Commercial kitchens or large catering facilities require additional time based on overall square footage.'
  },
  {
    q: 'When can I return to the treated area?',
    a: 'Because our primary residential method utilizes targeted, odorless, non-staining gel baits placed discreetly into crack recesses, you do not need to vacate your home during or after gel application. If supplementary liquid perimeter barrier treatments are applied to drains or utility ducts, a brief drying window of 30 to 60 minutes may be recommended by the technician.'
  },
  {
    q: 'What should I do after treatment?',
    a: 'Keep the tiny gel bait dots undisturbed and do not wipe them away during routine cleaning. Maintain clean countertops, store food in airtight containers, wipe kitchen sinks dry overnight, and dispose of garbage in sealed bins daily. Avoid using store-bought aerosol sprays over the gel baits, as repellents prevent cockroaches from feeding on the bait.'
  },
  {
    q: 'Do you treat apartments and PGs?',
    a: 'Yes. SLV Pest Control provides specialized cockroach control services across Bangalore for private apartments, gated community high-rises, paying guest (PG) accommodations, student hostels, and rental flats with property-appropriate safety protocols.'
  },
  {
    q: 'Do you treat restaurants and commercial spaces?',
    a: 'Yes. We provide scheduled commercial pest management services for cloud kitchens, restaurants, bakeries, corporate cafeterias, food processing units, and retail outlets, complying with commercial sanitation standards.'
  }
];
---

<Layout
  title="Cockroach Control FAQ | Questions & Answers | SLV Pest Control"
  description="Answers to frequently asked questions about cockroach control in Bangalore: identification, hiding spots, pricing (₹599 starting), preparation, safety, and commercial spaces."
  canonical="https://slvpestcontrol.com/knowledge/cockroaches/faq"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "@id": "https://slvpestcontrol.com/knowledge/cockroaches/faq#faq",
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      }))
    })} />
  </Fragment>

  <Header client:load activeItem="knowledge" />

  <main class="flex-1 w-full relative overflow-hidden bg-[#090a0c]">
    {/* Architectural Background Pattern */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 right-1/4 w-[500px] h-[500px] bg-[#E5A93C]/[0.06] rounded-full blur-[140px]"></div>
      <div class="absolute top-[40%] left-[-100px] w-[500px] h-[500px] bg-[#E5A93C]/[0.04] rounded-full blur-[160px]"></div>
    </div>

    {/* Breadcrumbs: Home > Knowledge Hub > Cockroaches > Current Page */}
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs text-zinc-400">
        <a href="/" class="hover:text-white transition">Home</a>
        <span>&gt;</span>
        <a href="/knowledge" class="hover:text-white transition">Knowledge Hub</a>
        <span>&gt;</span>
        <a href="/services/cockroach-control" class="hover:text-white transition">Cockroaches</a>
        <span>&gt;</span>
        <span class="text-[#F6C453] font-semibold">Cockroach FAQ</span>
      </nav>
    </div>

    {/* HERO */}
    <section class="relative z-10 pt-10 sm:pt-14 pb-12 sm:pb-16 border-b border-white/[0.06]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 mb-4 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-md">
          <HelpCircle class="w-3.5 h-3.5 text-[#E5A93C]" />
          <span class="text-[#E5A93C] text-xs font-extrabold tracking-[0.2em] uppercase">
            FREQUENTLY ASKED QUESTIONS
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-5 font-heading">
          Frequently Asked Questions About <span class="slv-gold-text">Cockroach Control</span>
        </h1>

        <p class="text-zinc-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto mb-8">
          Clear, factual answers regarding cockroach behavior, odorless gel treatments, costs, safety, and property preparation.
        </p>

        {/* Primary CTA */}
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
          <a
            href="/services/cockroach-control"
            class="slv-btn-primary w-full sm:w-auto px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <span>Get Free Inspection</span>
            <ArrowRight class="w-4 h-4 ml-1" />
          </a>
          <a
            href="tel:9180397822"
            class="slv-btn-secondary w-full sm:w-auto px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <Phone class="w-4 h-4 text-[#F6C453] mr-1" />
            <span>Call: 91803 97822</span>
          </a>
        </div>
      </div>
    </section>

    {/* FAQS ACCORDION / CARD SECTION */}
    <section class="relative z-10 py-14 sm:py-20 border-b border-white/[0.06]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="space-y-4 mb-16">
          {faqs.map((faq, index) => (
            <div class="slv-card rounded-2xl p-6 sm:p-7 border border-white/[0.08] transition hover:border-[#E5A93C]/40">
              <div class="flex items-start gap-3.5 mb-2.5">
                <span class="text-xs font-mono font-bold text-[#F6C453] bg-[#E5A93C]/10 px-2 py-0.5 rounded shrink-0 mt-0.5">
                  Q{index + 1 < 10 ? `0${index + 1}` : index + 1}
                </span>
                <h2 class="text-base sm:text-lg font-bold text-white font-heading">
                  {faq.q}
                </h2>
              </div>
              <p class="text-zinc-300 text-xs sm:text-sm leading-relaxed pl-10">
                {faq.a}
              </p>
            </div>
          ))}
        </div>

        {/* CTA Banner */}
        <div class="slv-card rounded-3xl p-8 sm:p-12 border border-[#E5A93C]/40 bg-gradient-to-b from-[#14161c] to-[#0c0d10] text-center mb-16 shadow-[0_20px_50px_rgba(0,0,0,0.8)]">
          <ShieldCheck class="w-12 h-12 text-[#E5A93C] mx-auto mb-4" />
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-3">
            Have More Questions About Cockroach Treatment?
          </h2>
          <p class="text-zinc-300 text-xs sm:text-sm max-w-lg mx-auto mb-6 leading-relaxed">
            Speak directly with SLV Pest Control technicians for personalized advice or schedule an on-site property inspection. Starting ₹599.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
              href="/services/cockroach-control"
              class="slv-btn-primary px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
            >
              <span>Get Free Inspection</span>
              <ArrowRight class="w-4 h-4 ml-1" />
            </a>
            <a
              href="https://wa.me/9180397822"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-md inline-flex items-center transition"
            >
              <MessageCircle class="w-4 h-4 mr-1 text-white" />
              <span>WhatsApp Us</span>
            </a>
          </div>
        </div>

        {/* Related Knowledge Hub Articles */}
        <div>
          <div class="flex items-center gap-2 mb-6">
            <BookOpen class="w-4 h-4 text-[#E5A93C]" />
            <h2 class="text-xl font-bold text-white font-heading">
              Explore More Cockroach Guides
            </h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {relatedArticles.map((article) => (
              <a
                href={article.href}
                class="slv-card rounded-2xl p-5 border border-white/[0.08] hover:border-[#E5A93C]/50 transition block group"
              >
                <h3 class="text-sm font-bold text-white group-hover:text-[#F6C453] transition mb-1.5 flex items-center justify-between">
                  <span>{article.title}</span>
                  <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                </h3>
                <p class="text-zinc-400 text-xs leading-relaxed">{article.desc}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* CONTACT & SERVICE DETAILS */}
    <section class="relative z-10 py-14 sm:py-18 bg-[#0c0d10]/50 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="slv-card rounded-3xl p-6 sm:p-10 border border-white/[0.08]">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs">
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Bangalore Service Office</span>
              <p class="text-white text-sm">143 Soundarya Layout, Doddabidarakallu, Bangalore 560073</p>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Phone / WhatsApp</span>
              <a href="tel:9180397822" class="text-white text-sm font-bold font-mono hover:text-[#FFE08A]">91803 97822</a>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Email Support</span>
              <a href="mailto:contact@slvpestcontrol.com" class="text-white text-sm hover:text-[#FFE08A]">contact@slvpestcontrol.com</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingActions client:load />
</Layout>
