---
import Layout from '../../../layouts/Layout.astro';
import { Header } from '../../../components/Header';
import { Footer } from '../../../components/Footer';
import { FloatingActions } from '../../../components/FloatingActions';
import {
  BookOpen,
  Search,
  Layers,
  Sparkles,
  ArrowRight,
  Phone,
  MessageCircle,
  Mail,
  MapPin,
  UtensilsCrossed,
  ShieldCheck,
  DoorOpen,
  Waves,
  Box,
  Flame
} from 'lucide-react';

const relatedArticles = [
  {
    title: 'Cockroach Identification',
    desc: 'Recognize signs, droppings, egg cases, and distinctive odors.',
    href: '/knowledge/cockroaches/identification'
  },
  {
    title: 'How Cockroaches Enter & Spread',
    desc: 'Understand entry pathways through groceries, drains, and building voids.',
    href: '/knowledge/cockroaches/how-they-spread'
  },
  {
    title: 'Cockroach Prevention',
    desc: 'Practical hygiene, moisture reduction, and structural exclusion tips.',
    href: '/knowledge/cockroaches/prevention'
  },
  {
    title: 'Cockroach Treatment Guide',
    desc: 'Professional 4-stage IPM approach from inspection to targeted gel baiting.',
    href: '/knowledge/cockroaches/treatment-guide'
  },
  {
    title: 'Cockroach FAQ',
    desc: '11 practical questions and answers regarding cockroach control.',
    href: '/knowledge/cockroaches/faq'
  }
];

const harbourageZones = [
  {
    title: 'Kitchen Cabinets & Modular Hinges',
    desc: 'Cabinet hinges provide the tightest, darkest micro-gaps inside modular kitchens. Cockroaches nest in the screw holes, corners, and underside shelf lips where warmth and residual cooking grease accumulate.',
    icon: DoorOpen
  },
  {
    title: 'Under-Sink Plumbing & P-Traps',
    desc: 'Under-sink areas combine darkness with constant humidity from plumbing pipe joints, trap moisture, and pipe wall wall-sleeves. Unsealed gaps around plumbing penetrations allow easy movement between walls.',
    icon: Waves
  },
  {
    title: 'Floor Drains & Inspection Traps',
    desc: 'Kitchen wash area floor drains, utility sinks, and bathroom drains serve as direct entry conduits for sewer-dwelling American cockroaches, particularly during dry seasons when drain water seals evaporate.',
    icon: Search
  },
  {
    title: 'Behind Heat-Generating Appliances',
    desc: 'The warm motor compressors behind refrigerators, microwaves, dishwashers, ovens, and water purifiers (RO units) generate ideal temperatures (25°C–32°C) for rapid egg hatching and nymph development.',
    icon: Flame
  },
  {
    title: 'Cracks, Crevices & Tile Grout',
    desc: 'Loose tile grout, skirting gaps, baseboard crevices, and unsealed junctions between kitchen granite countertops and wall tiles offer daytime refuges right next to food prep areas.',
    icon: Layers
  },
  {
    title: 'Dark & Damp Utility Shafts',
    desc: 'Multi-unit building plumbing ducts, vertical drainage chases, and basement utility rooms provide protected passages connecting adjacent flats and floors in Bangalore apartment blocks.',
    icon: Box
  },
  {
    title: 'Food Storage & Pantry Packaging',
    desc: 'Cardboard grocery boxes, cereal boxes, paper sacks, and unsealed flour bins in pantries provide food and shelter, while the corrugated grooves in cardboard serve as prime ootheca laying zones.',
    icon: UtensilsCrossed
  }
];
---

<Layout
  title="Where Cockroaches Hide | Kitchen & Home Harborage Areas | SLV Pest Control"
  description="Discover the primary hiding spots of cockroaches in Bangalore homes and kitchens: cabinet hinges, under-sink plumbing, drains, appliance motors, and pantries."
  canonical="https://slvpestcontrol.com/knowledge/cockroaches/where-they-hide"
>
  <Header client:load activeItem="knowledge" />

  <main class="flex-1 w-full relative overflow-hidden bg-[#090a0c]">
    {/* Architectural Background Pattern */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 right-1/4 w-[500px] h-[500px] bg-[#E5A93C]/[0.06] rounded-full blur-[140px]"></div>
      <div class="absolute top-[40%] left-[-100px] w-[500px] h-[500px] bg-[#E5A93C]/[0.04] rounded-full blur-[160px]"></div>
    </div>

    {/* Breadcrumbs: Home > Knowledge Hub > Cockroaches > Current Page */}
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs text-zinc-400">
        <a href="/" class="hover:text-white transition">Home</a>
        <span>&gt;</span>
        <a href="/knowledge" class="hover:text-white transition">Knowledge Hub</a>
        <span>&gt;</span>
        <a href="/services/cockroach-control" class="hover:text-white transition">Cockroaches</a>
        <span>&gt;</span>
        <span class="text-[#F6C453] font-semibold">Where Cockroaches Hide</span>
      </nav>
    </div>

    {/* HERO */}
    <section class="relative z-10 pt-10 sm:pt-14 pb-12 sm:pb-16 border-b border-white/[0.06]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 mb-4 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-md">
          <BookOpen class="w-3.5 h-3.5 text-[#E5A93C]" />
          <span class="text-[#E5A93C] text-xs font-extrabold tracking-[0.2em] uppercase">
            HARBOURAGE ANALYSIS
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-5 font-heading">
          Where Cockroaches Hide: <span class="slv-gold-text">Common Harbourage Areas</span>
        </h1>

        <p class="text-zinc-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto mb-8">
          Detailed guide to common nesting and harbourage zones in residential kitchens, commercial pantries, and multi-unit buildings.
        </p>

        {/* Primary CTA */}
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
          <a
            href="/services/cockroach-control"
            class="slv-btn-primary w-full sm:w-auto px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <span>Get Cockroach Inspection</span>
            <ArrowRight class="w-4 h-4 ml-1" />
          </a>
          <a
            href="tel:9180397822"
            class="slv-btn-secondary w-full sm:w-auto px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <Phone class="w-4 h-4 text-[#F6C453] mr-1" />
            <span>Call: 91803 97822</span>
          </a>
        </div>
      </div>
    </section>

    {/* CONTENT SECTION */}
    <section class="relative z-10 py-14 sm:py-20 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        {/* Why Cockroaches Cluster */}
        <div class="slv-card rounded-3xl p-8 sm:p-10 border border-white/[0.08] mb-12">
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-4">
            Why Cockroaches Seek Specific Harbourage Points
          </h2>
          <div class="space-y-4 text-zinc-300 text-sm sm:text-base leading-relaxed">
            <p>
              Cockroaches exhibit <em>thigmotaxis</em>—a behavioral preference for tight, enclosed spaces where their dorsal (top) and ventral (bottom) body surfaces remain in direct physical contact with adjoining surfaces. A tight gap of 3 to 5 mm between a cabinet wall and a metal hinge offers them a sensation of physical security, protection from air currents, and seclusion from daylight.
            </p>
            <p>
              Additionally, they secrete aggregation pheromones in their feces and cuticular waxes, signaling to other individuals that a specific harbourage zone is safe, dark, and sheltered. Over time, these designated zones become localized breeding hubs.
            </p>
          </div>
        </div>

        {/* Top 7 Harbourage Zones */}
        <div class="mb-14">
          <div class="text-center max-w-2xl mx-auto mb-10">
            <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-2">PRIMARY REFUGES</span>
            <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
              7 Key Harbourage Zones in Bangalore Properties
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {harbourageZones.map((zone) => {
              const Icon = zone.icon;
              return (
                <div class="slv-card rounded-2xl p-6 border border-white/[0.08] flex flex-col justify-between">
                  <div>
                    <div class="w-10 h-10 rounded-xl bg-[#E5A93C]/10 border border-[#E5A93C]/20 flex items-center justify-center text-[#E5A93C] mb-4">
                      <Icon class="w-5 h-5" />
                    </div>
                    <h3 class="text-lg font-bold text-white mb-2 font-heading">{zone.title}</h3>
                    <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed">{zone.desc}</p>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        {/* Practical Inspection Tip */}
        <div class="slv-card rounded-3xl p-8 sm:p-10 border border-white/[0.08] mb-14">
          <h2 class="text-2xl font-black text-white font-heading mb-4">
            How Professional Technicians Inspect Harbourage Zones
          </h2>
          <div class="space-y-3 text-zinc-300 text-xs sm:text-sm leading-relaxed">
            <p>
              During an SLV Pest Control inspection, technicians do not simply spray visible surfaces. Instead, they systematically illuminate and examine:
            </p>
            <ul class="space-y-2 pl-4 list-disc text-zinc-400">
              <li>Inside modular drawer sliders and behind soft-close hydraulic dampers.</li>
              <li>The reverse cavity behind built-in refrigerator motor compartments.</li>
              <li>Underside crevices beneath kitchen granite countertops and sinks.</li>
              <li>Unsealed electrical outlet faceplates located directly above cooking slabs.</li>
              <li>Floor drain jali traps in utility balconies and washrooms.</li>
            </ul>
          </div>
        </div>

        {/* CTA Banner */}
        <div class="slv-card rounded-3xl p-8 sm:p-12 border border-[#E5A93C]/40 bg-gradient-to-b from-[#14161c] to-[#0c0d10] text-center mb-16 shadow-[0_20px_50px_rgba(0,0,0,0.8)]">
          <ShieldCheck class="w-12 h-12 text-[#E5A93C] mx-auto mb-4" />
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-3">
            Suspect Hidden Cockroaches in Your Kitchen?
          </h2>
          <p class="text-zinc-300 text-xs sm:text-sm max-w-lg mx-auto mb-6 leading-relaxed">
            Our technicians map out hidden harbourage points and place targeted odorless gel bait directly where insects shelter. Starting ₹599.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
              href="/services/cockroach-control"
              class="slv-btn-primary px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
            >
              <span>Get Cockroach Inspection</span>
              <ArrowRight class="w-4 h-4 ml-1" />
            </a>
            <a
              href="https://wa.me/9180397822"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-md inline-flex items-center transition"
            >
              <MessageCircle class="w-4 h-4 mr-1 text-white" />
              <span>WhatsApp Us</span>
            </a>
          </div>
        </div>

        {/* Related Knowledge Hub Articles */}
        <div>
          <div class="flex items-center gap-2 mb-6">
            <BookOpen class="w-4 h-4 text-[#E5A93C]" />
            <h2 class="text-xl font-bold text-white font-heading">
              Explore More Cockroach Guides
            </h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {relatedArticles.map((article) => (
              <a
                href={article.href}
                class="slv-card rounded-2xl p-5 border border-white/[0.08] hover:border-[#E5A93C]/50 transition block group"
              >
                <h3 class="text-sm font-bold text-white group-hover:text-[#F6C453] transition mb-1.5 flex items-center justify-between">
                  <span>{article.title}</span>
                  <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                </h3>
                <p class="text-zinc-400 text-xs leading-relaxed">{article.desc}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* CONTACT & SERVICE DETAILS */}
    <section class="relative z-10 py-14 sm:py-18 bg-[#0c0d10]/50 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="slv-card rounded-3xl p-6 sm:p-10 border border-white/[0.08]">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs">
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Bangalore Service Office</span>
              <p class="text-white text-sm">143 Soundarya Layout, Doddabidarakallu, Bangalore 560073</p>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Phone / WhatsApp</span>
              <a href="tel:9180397822" class="text-white text-sm font-bold font-mono hover:text-[#FFE08A]">91803 97822</a>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Email Support</span>
              <a href="mailto:contact@slvpestcontrol.com" class="text-white text-sm hover:text-[#FFE08A]">contact@slvpestcontrol.com</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingActions client:load />
</Layout>
