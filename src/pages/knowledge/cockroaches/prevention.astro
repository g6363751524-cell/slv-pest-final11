---
import Layout from '../../../layouts/Layout.astro';
import { Header } from '../../../components/Header';
import { Footer } from '../../../components/Footer';
import { FloatingActions } from '../../../components/FloatingActions';
import {
  BookOpen,
  Search,
  ShieldCheck,
  CheckCircle2,
  Sparkles,
  Droplets,
  Wrench,
  Trash2,
  Box,
  Layers,
  Clock,
  ArrowRight,
  Phone,
  MessageCircle,
  Mail,
  UtensilsCrossed
} from 'lucide-react';

const relatedArticles = [
  {
    title: 'Cockroach Identification',
    desc: 'Recognize signs, droppings, egg cases, and distinctive odors.',
    href: '/knowledge/cockroaches/identification'
  },
  {
    title: 'Where Cockroaches Hide',
    desc: 'Discover the top hiding spots in kitchens, drains, and appliances.',
    href: '/knowledge/cockroaches/where-they-hide'
  },
  {
    title: 'How Cockroaches Enter & Spread',
    desc: 'Understand entry pathways through groceries, drains, and building voids.',
    href: '/knowledge/cockroaches/how-they-spread'
  },
  {
    title: 'Cockroach Treatment Guide',
    desc: 'Professional 4-stage IPM approach from inspection to targeted gel baiting.',
    href: '/knowledge/cockroaches/treatment-guide'
  },
  {
    title: 'Cockroach FAQ',
    desc: '11 practical questions and answers regarding cockroach control.',
    href: '/knowledge/cockroaches/faq'
  }
];

const preventionSteps = [
  {
    title: 'Keep Food Sealed in Airtight Containers',
    desc: 'Store grains, pulses, flour, sugar, and opened snacks in glass or rigid plastic airtight containers. Cockroaches easily chew through thin polythene wrappers and cardboard cartons.',
    icon: UtensilsCrossed
  },
  {
    title: 'Clean Food Preparation Areas Daily',
    desc: 'Wipe kitchen counters, stove tops, and splashbacks every night. Clean greasy film and food spills behind cooking hobs, microwaves, and toaster trays where grease attracts foraging insects.',
    icon: Sparkles
  },
  {
    title: 'Reduce Moisture in Sinks & Bathrooms',
    desc: 'Cockroaches can survive for weeks without food, but they need water within 7 days. Wipe kitchen sinks dry before retiring for the night and ensure wash basins do not hold standing water.',
    icon: Droplets
  },
  {
    title: 'Fix Plumbing Leaks & Dripping Faucets',
    desc: 'Repair dripping taps, leaking under-sink P-traps, and damp wall seepages. Persistent plumbing dampness creates optimal microclimates for egg incubation.',
    icon: Wrench
  },
  {
    title: 'Keep Living & Storage Areas Uncluttered',
    desc: 'Discard unnecessary cardboard shipping boxes, stacks of old newspapers, and paper bags immediately. Cockroaches feed on cardboard glue and hide within corrugated flutes.',
    icon: Box
  },
  {
    title: 'Seal Structural Cracks & Entry Gaps',
    desc: 'Apply silicone caulk along gaps between granite countertops and backsplash tiles. Seal baseboard crevices, pipe wall penetrations, and install door sweeps along exterior thresholds.',
    icon: Layers
  },
  {
    title: 'Dispose of Waste in Covered Bins Nightly',
    desc: 'Use trash bins with tightly fitting lids. Never leave open food garbage bags indoors overnight. Empty kitchen trash into society disposal chutes daily.',
    icon: Trash2
  },
  {
    title: 'Act Early When Activity Is Noticed',
    desc: 'A single female German cockroach and her offspring can produce thousands of individuals within months. Addressing activity at the first sign prevents structural colonization.',
    icon: Clock
  }
];
---

<Layout
  title="Cockroach Prevention Guide | Practical Sanitation & Exclusion | SLV Pest Control"
  description="Comprehensive cockroach prevention checklist for Bangalore kitchens and homes. Practical sanitation, moisture elimination, sealing entry points, and clutter removal."
  canonical="https://slvpestcontrol.com/knowledge/cockroaches/prevention"
>
  <Header client:load activeItem="knowledge" />

  <main class="flex-1 w-full relative overflow-hidden bg-[#090a0c]">
    {/* Architectural Background Pattern */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 right-1/4 w-[500px] h-[500px] bg-[#E5A93C]/[0.06] rounded-full blur-[140px]"></div>
      <div class="absolute top-[40%] left-[-100px] w-[500px] h-[500px] bg-[#E5A93C]/[0.04] rounded-full blur-[160px]"></div>
    </div>

    {/* Breadcrumbs: Home > Knowledge Hub > Cockroaches > Current Page */}
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs text-zinc-400">
        <a href="/" class="hover:text-white transition">Home</a>
        <span>&gt;</span>
        <a href="/knowledge" class="hover:text-white transition">Knowledge Hub</a>
        <span>&gt;</span>
        <a href="/services/cockroach-control" class="hover:text-white transition">Cockroaches</a>
        <span>&gt;</span>
        <span class="text-[#F6C453] font-semibold">Cockroach Prevention</span>
      </nav>
    </div>

    {/* HERO */}
    <section class="relative z-10 pt-10 sm:pt-14 pb-12 sm:pb-16 border-b border-white/[0.06]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 mb-4 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-md">
          <BookOpen class="w-3.5 h-3.5 text-[#E5A93C]" />
          <span class="text-[#E5A93C] text-xs font-extrabold tracking-[0.2em] uppercase">
            HYGIENE &amp; EXCLUSION GUIDE
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-5 font-heading">
          Cockroach Prevention: <span class="slv-gold-text">Practical Steps for Homes &amp; Spaces</span>
        </h1>

        <p class="text-zinc-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto mb-8">
          Actionable sanitation protocols, moisture management, and physical barrier strategies to safeguard your living and working environments.
        </p>

        {/* Primary CTA */}
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
          <a
            href="/services/cockroach-control"
            class="slv-btn-primary w-full sm:w-auto px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <span>Cockroach Control</span>
            <ArrowRight class="w-4 h-4 ml-1" />
          </a>
          <a
            href="tel:9180397822"
            class="slv-btn-secondary w-full sm:w-auto px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <Phone class="w-4 h-4 text-[#F6C453] mr-1" />
            <span>Call: 91803 97822</span>
          </a>
        </div>
      </div>
    </section>

    {/* CONTENT SECTION */}
    <section class="relative z-10 py-14 sm:py-20 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        {/* Core Principles */}
        <div class="slv-card rounded-3xl p-8 sm:p-10 border border-white/[0.08] mb-12">
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-4">
            The Three Pillars of Cockroach Exclusion
          </h2>
          <div class="space-y-4 text-zinc-300 text-sm sm:text-base leading-relaxed">
            <p>
              Cockroaches thrive only when three essential survival requirements are met: <strong>food sources</strong>, <strong>available moisture</strong>, and <strong>secluded harbourage</strong>. Eliminating any one of these factors drastically reduces a property’s vulnerability to long-term colonization.
            </p>
            <p>
              While professional gel baiting addresses active resident populations, incorporating proactive hygiene and exclusion habits ensures that new hitchhiking insects cannot find the nourishment or refuge needed to establish breeding colonies.
            </p>
          </div>
        </div>

        {/* 8-Point Prevention Checklist */}
        <div class="mb-14">
          <div class="text-center max-w-2xl mx-auto mb-10">
            <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-2">CHECKLIST</span>
            <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
              8 Practical Prevention Actions
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {preventionSteps.map((step) => {
              const Icon = step.icon;
              return (
                <div class="slv-card rounded-2xl p-6 border border-white/[0.08] flex flex-col justify-between">
                  <div>
                    <div class="w-10 h-10 rounded-xl bg-[#E5A93C]/10 border border-[#E5A93C]/20 flex items-center justify-center text-[#E5A93C] mb-4">
                      <Icon class="w-5 h-5" />
                    </div>
                    <h3 class="text-lg font-bold text-white mb-2 font-heading">{step.title}</h3>
                    <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed">{step.desc}</p>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        {/* Sanitation vs Professional Treatment */}
        <div class="slv-card rounded-3xl p-8 sm:p-10 border border-white/[0.08] mb-14">
          <h2 class="text-2xl font-black text-white font-heading mb-4">
            Why Sanitation Alone Cannot Eliminate an Existing Infestation
          </h2>
          <div class="space-y-3 text-zinc-300 text-sm leading-relaxed">
            <p>
              While rigorous cleaning removes surface food crumbs, it cannot eliminate cockroaches already sheltering deep inside electrical appliance motors, modular cabinet joints, or drainage lines. In fact, adult German cockroaches can survive on grease microscopic traces, bookbinding starch, or even shed skin residues.
            </p>
            <p>
              Sanitation works best as a symbiotic complement to professional IPM treatment: keeping alternative food sources minimized ensures foraging cockroaches rapidly consume the specialized gel baits applied by our technicians.
            </p>
          </div>
        </div>

        {/* CTA Banner */}
        <div class="slv-card rounded-3xl p-8 sm:p-12 border border-[#E5A93C]/40 bg-gradient-to-b from-[#14161c] to-[#0c0d10] text-center mb-16 shadow-[0_20px_50px_rgba(0,0,0,0.8)]">
          <ShieldCheck class="w-12 h-12 text-[#E5A93C] mx-auto mb-4" />
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-3">
            Need Professional Cockroach Control Support?
          </h2>
          <p class="text-zinc-300 text-xs sm:text-sm max-w-lg mx-auto mb-6 leading-relaxed">
            Combine preventative habits with precision odorless gel baiting and perimeter barrier treatments. Starting ₹599.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
              href="/services/cockroach-control"
              class="slv-btn-primary px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
            >
              <span>Cockroach Control</span>
              <ArrowRight class="w-4 h-4 ml-1" />
            </a>
            <a
              href="https://wa.me/9180397822"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-md inline-flex items-center transition"
            >
              <MessageCircle class="w-4 h-4 mr-1 text-white" />
              <span>WhatsApp Us</span>
            </a>
          </div>
        </div>

        {/* Related Knowledge Hub Articles */}
        <div>
          <div class="flex items-center gap-2 mb-6">
            <BookOpen class="w-4 h-4 text-[#E5A93C]" />
            <h2 class="text-xl font-bold text-white font-heading">
              Explore More Cockroach Guides
            </h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {relatedArticles.map((article) => (
              <a
                href={article.href}
                class="slv-card rounded-2xl p-5 border border-white/[0.08] hover:border-[#E5A93C]/50 transition block group"
              >
                <h3 class="text-sm font-bold text-white group-hover:text-[#F6C453] transition mb-1.5 flex items-center justify-between">
                  <span>{article.title}</span>
                  <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                </h3>
                <p class="text-zinc-400 text-xs leading-relaxed">{article.desc}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* CONTACT & SERVICE DETAILS */}
    <section class="relative z-10 py-14 sm:py-18 bg-[#0c0d10]/50 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="slv-card rounded-3xl p-6 sm:p-10 border border-white/[0.08]">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs">
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Bangalore Service Office</span>
              <p class="text-white text-sm">143 Soundarya Layout, Doddabidarakallu, Bangalore 560073</p>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Phone / WhatsApp</span>
              <a href="tel:9180397822" class="text-white text-sm font-bold font-mono hover:text-[#FFE08A]">91803 97822</a>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Email Support</span>
              <a href="mailto:contact@slvpestcontrol.com" class="text-white text-sm hover:text-[#FFE08A]">contact@slvpestcontrol.com</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingActions client:load />
</Layout>
