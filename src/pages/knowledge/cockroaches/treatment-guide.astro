---
import Layout from '../../../layouts/Layout.astro';
import { Header } from '../../../components/Header';
import { Footer } from '../../../components/Footer';
import { FloatingActions } from '../../../components/FloatingActions';
import {
  BookOpen,
  Search,
  ShieldCheck,
  CheckCircle2,
  Sparkles,
  Layers,
  Activity,
  ArrowRight,
  Phone,
  MessageCircle,
  Mail,
  Flame,
  HelpCircle
} from 'lucide-react';

const relatedArticles = [
  {
    title: 'Cockroach Identification',
    desc: 'Recognize signs, droppings, egg cases, and distinctive odors.',
    href: '/knowledge/cockroaches/identification'
  },
  {
    title: 'Where Cockroaches Hide',
    desc: 'Discover the top hiding spots in kitchens, drains, and appliances.',
    href: '/knowledge/cockroaches/where-they-hide'
  },
  {
    title: 'How Cockroaches Enter & Spread',
    desc: 'Understand entry pathways through groceries, drains, and building voids.',
    href: '/knowledge/cockroaches/how-they-spread'
  },
  {
    title: 'Cockroach Prevention',
    desc: 'Practical hygiene, moisture reduction, and structural exclusion tips.',
    href: '/knowledge/cockroaches/prevention'
  },
  {
    title: 'Cockroach FAQ',
    desc: '11 practical questions and answers regarding cockroach control.',
    href: '/knowledge/cockroaches/faq'
  }
];

const treatmentStages = [
  {
    step: '01',
    title: 'Inspection & Activity Mapping',
    desc: 'Identify activity and likely harbourage areas across the property.',
    detail: 'A certified SLV Pest Control technician conducts a thorough visual and diagnostic assessment of kitchen cabinetry, appliances, drain traps, plumbing sleeves, and storage areas. The inspection determines the species involved (German vs. American), pinpointing focal harbourage zones and the infestation severity level.',
    icon: Search
  },
  {
    step: '02',
    title: 'Targeted Treatment',
    desc: 'Treat suitable areas according to the inspection findings and property conditions.',
    detail: 'Treatment is tailored specifically to your premises. We utilize professional-grade, odorless gel baiting placed precisely in secluded cracks, crevices, hinges, and appliance motor housings away from food-contact surfaces. Where appropriate for perimeter or drainage control, targeted non-repellent residual barrier applications are applied along entry thresholds and plumbing ducts.',
    icon: Layers
  },
  {
    step: '03',
    title: 'Monitoring & Follow-up',
    desc: 'Monitor activity and provide appropriate follow-up guidance.',
    detail: 'Because cockroach eggs (oothecae) hatch within 2 to 4 weeks depending on ambient humidity, ongoing monitoring is essential. Our team provides structured guidelines to observe nymph emergence, evaluate bait consumption, and schedule follow-up assistance as required by property conditions.',
    icon: Activity
  },
  {
    step: '04',
    title: 'Prevention Guidance',
    desc: 'Provide practical recommendations to help reduce future activity.',
    detail: 'Following treatment, the technician delivers property-specific advice on moisture mitigation, structural caulking, waste management, and delivery parcel inspection to help minimize the risk of re-introduction from external vectors.',
    icon: ShieldCheck
  }
];
---

<Layout
  title="Cockroach Treatment Guide | Professional IPM Methodology | SLV Pest Control"
  description="Discover SLV Pest Control's structured 4-stage cockroach treatment protocol: forensic inspection, precision odorless gel baiting, monitoring, and prevention guidance."
  canonical="https://slvpestcontrol.com/knowledge/cockroaches/treatment-guide"
>
  <Header client:load activeItem="knowledge" />

  <main class="flex-1 w-full relative overflow-hidden bg-[#090a0c]">
    {/* Architectural Background Pattern */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 right-1/4 w-[500px] h-[500px] bg-[#E5A93C]/[0.06] rounded-full blur-[140px]"></div>
      <div class="absolute top-[40%] left-[-100px] w-[500px] h-[500px] bg-[#E5A93C]/[0.04] rounded-full blur-[160px]"></div>
    </div>

    {/* Breadcrumbs: Home > Knowledge Hub > Cockroaches > Current Page */}
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs text-zinc-400">
        <a href="/" class="hover:text-white transition">Home</a>
        <span>&gt;</span>
        <a href="/knowledge" class="hover:text-white transition">Knowledge Hub</a>
        <span>&gt;</span>
        <a href="/services/cockroach-control" class="hover:text-white transition">Cockroaches</a>
        <span>&gt;</span>
        <span class="text-[#F6C453] font-semibold">Cockroach Treatment Guide</span>
      </nav>
    </div>

    {/* HERO */}
    <section class="relative z-10 pt-10 sm:pt-14 pb-12 sm:pb-16 border-b border-white/[0.06]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 mb-4 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-md">
          <BookOpen class="w-3.5 h-3.5 text-[#E5A93C]" />
          <span class="text-[#E5A93C] text-xs font-extrabold tracking-[0.2em] uppercase">
            TREATMENT METHODOLOGY
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-5 font-heading">
          Cockroach Treatment Guide: <span class="slv-gold-text">Professional Methodology</span>
        </h1>

        <p class="text-zinc-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto mb-8">
          A disciplined, scientific Integrated Pest Management (IPM) approach combining forensic inspection, precision odorless gel baiting, and sustained monitoring.
        </p>

        {/* Primary CTA */}
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
          <a
            href="/services/cockroach-control"
            class="slv-btn-primary w-full sm:w-auto px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <span>View Cockroach Control</span>
            <ArrowRight class="w-4 h-4 ml-1" />
          </a>
          <a
            href="tel:9180397822"
            class="slv-btn-secondary w-full sm:w-auto px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <Phone class="w-4 h-4 text-[#F6C453] mr-1" />
            <span>Call: 91803 97822</span>
          </a>
        </div>
      </div>
    </section>

    {/* CONTENT SECTION */}
    <section class="relative z-10 py-14 sm:py-20 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        {/* Why Disciplined Process Matters */}
        <div class="slv-card rounded-3xl p-8 sm:p-10 border border-white/[0.08] mb-12">
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-4">
            Why Generic Sprays Fail Against Cockroaches
          </h2>
          <div class="space-y-4 text-zinc-300 text-sm sm:text-base leading-relaxed">
            <p>
              Over-the-counter pesticide sprays only kill the small percentage of foraging insects exposed to direct misting. Because the active ingredients in household sprays are irritating repellents, they trigger a biological scatter response, driving surviving cockroaches deeper into wall cavities, false ceilings, and adjoining rooms.
            </p>
            <p>
              SLV Pest Control employs an Integrated Pest Management (IPM) strategy centered on targeted, odorless gel baits and non-repellent formulations. Cockroaches feed on the palatable bait, return safely to their harbourage, and transfer the active ingredient through grooming and social sharing—effectively controlling the population at its source without contaminating living spaces.
            </p>
          </div>
        </div>

        {/* 4-Stage Breakdown */}
        <div class="mb-14">
          <div class="text-center max-w-2xl mx-auto mb-10">
            <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-2">IPM WORKFLOW</span>
            <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
              Our 4-Stage Treatment Protocol
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {treatmentStages.map((stage) => {
              const Icon = stage.icon;
              return (
                <div class="slv-card rounded-2xl p-6 sm:p-7 border border-white/[0.08] flex flex-col justify-between hover:border-[#E5A93C]/40 transition-colors">
                  <div>
                    <div class="flex items-center justify-between mb-4">
                      <span class="text-3xl font-black font-mono text-[#F6C453]">{stage.step}</span>
                      <div class="w-10 h-10 rounded-xl bg-[#E5A93C]/10 border border-[#E5A93C]/20 flex items-center justify-center text-[#E5A93C]">
                        <Icon class="w-5 h-5" />
                      </div>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-2 font-heading">{stage.title}</h3>
                    <p class="text-xs font-semibold text-[#FFE08A] mb-3">{stage.desc}</p>
                    <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed">{stage.detail}</p>
                  </div>
                  <div class="mt-6 pt-4 border-t border-white/[0.06] text-[11px] text-zinc-500 font-mono">
                    Phase {stage.step} of 04
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        {/* Science of Gel Baiting */}
        <div class="slv-card rounded-3xl p-8 sm:p-10 border border-white/[0.08] mb-14">
          <h2 class="text-2xl font-black text-white font-heading mb-4">
            How Odorless Gel Baiting Works
          </h2>
          <div class="space-y-4 text-zinc-300 text-sm leading-relaxed">
            <p>
              Cockroach gel baits contain complex food attractants (sugars, proteins, lipids) paired with slow-acting active ingredients. When applied as tiny dot matrices (the size of a peppercorn) in secluded hinges and crack recesses:
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
              <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.05]">
                <span class="text-[#F6C453] font-bold block mb-1">1. High Palatability</span>
                <span class="text-zinc-400 text-xs">Attracts foraging nymphs and adults away from competing food residues.</span>
              </div>
              <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.05]">
                <span class="text-[#F6C453] font-bold block mb-1">2. Delayed Action</span>
                <span class="text-zinc-400 text-xs">Allows the insect sufficient time to return undisturbed to its deep harbourage.</span>
              </div>
              <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.05]">
                <span class="text-[#F6C453] font-bold block mb-1">3. Horizontal Transfer</span>
                <span class="text-zinc-400 text-xs">Shared within the nest through coprophagy and necrophagy, targeting hidden nymphs.</span>
              </div>
            </div>
          </div>
        </div>

        {/* Honest Expectation Setting */}
        <div class="slv-card rounded-3xl p-8 border border-white/[0.08] mb-14 bg-white/[0.02]">
          <div class="flex items-start gap-3">
            <HelpCircle class="w-5 h-5 text-[#E5A93C] shrink-0 mt-0.5" />
            <div>
              <h3 class="text-base font-bold text-white mb-2">Practical Treatment Expectations</h3>
              <p class="text-zinc-300 text-xs sm:text-sm leading-relaxed">
                Because eggs enclosed in oothecae are biologically impervious to chemical contact, single-day elimination does not reflect biological reality. Complete management requires allowing sufficient time for existing egg capsules to hatch and for newly emerged nymphs to contact the active gel placements. Professional pest control relies on sustained IPM principles, not unrealistic guarantees.
              </p>
            </div>
          </div>
        </div>

        {/* CTA Banner */}
        <div class="slv-card rounded-3xl p-8 sm:p-12 border border-[#E5A93C]/40 bg-gradient-to-b from-[#14161c] to-[#0c0d10] text-center mb-16 shadow-[0_20px_50px_rgba(0,0,0,0.8)]">
          <ShieldCheck class="w-12 h-12 text-[#E5A93C] mx-auto mb-4" />
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-3">
            Ready to Schedule Professional Cockroach Control?
          </h2>
          <p class="text-zinc-300 text-xs sm:text-sm max-w-lg mx-auto mb-6 leading-relaxed">
            Protect your kitchen and living spaces with odorless gel baiting and thorough diagnostic inspection. Starting from ₹599.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
              href="/services/cockroach-control"
              class="slv-btn-primary px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
            >
              <span>View Cockroach Control</span>
              <ArrowRight class="w-4 h-4 ml-1" />
            </a>
            <a
              href="https://wa.me/9180397822"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-md inline-flex items-center transition"
            >
              <MessageCircle class="w-4 h-4 mr-1 text-white" />
              <span>WhatsApp Us</span>
            </a>
          </div>
        </div>

        {/* Related Knowledge Hub Articles */}
        <div>
          <div class="flex items-center gap-2 mb-6">
            <BookOpen class="w-4 h-4 text-[#E5A93C]" />
            <h2 class="text-xl font-bold text-white font-heading">
              Explore More Cockroach Guides
            </h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {relatedArticles.map((article) => (
              <a
                href={article.href}
                class="slv-card rounded-2xl p-5 border border-white/[0.08] hover:border-[#E5A93C]/50 transition block group"
              >
                <h3 class="text-sm font-bold text-white group-hover:text-[#F6C453] transition mb-1.5 flex items-center justify-between">
                  <span>{article.title}</span>
                  <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                </h3>
                <p class="text-zinc-400 text-xs leading-relaxed">{article.desc}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* CONTACT & SERVICE DETAILS */}
    <section class="relative z-10 py-14 sm:py-18 bg-[#0c0d10]/50 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="slv-card rounded-3xl p-6 sm:p-10 border border-white/[0.08]">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs">
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Bangalore Service Office</span>
              <p class="text-white text-sm">143 Soundarya Layout, Doddabidarakallu, Bangalore 560073</p>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Phone / WhatsApp</span>
              <a href="tel:9180397822" class="text-white text-sm font-bold font-mono hover:text-[#FFE08A]">91803 97822</a>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Email Support</span>
              <a href="mailto:contact@slvpestcontrol.com" class="text-white text-sm hover:text-[#FFE08A]">contact@slvpestcontrol.com</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingActions client:load />
</Layout>
