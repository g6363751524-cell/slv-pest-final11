---
import Layout from '../../../layouts/Layout.astro';
import { Header } from '../../../components/Header';
import { Footer } from '../../../components/Footer';
import { FloatingActions } from '../../../components/FloatingActions';
import {
  BookOpen,
  Search,
  Eye,
  Layers,
  AlertTriangle,
  ArrowRight,
  Phone,
  MessageCircle,
  Mail,
  ShieldCheck,
  DoorOpen,
  Waves,
  Building
} from 'lucide-react';

const relatedArticles = [
  {
    title: 'Where Termites Are Found',
    desc: 'Foundations, wooden door frames, floor joints, and concealed spaces.',
    href: '/knowledge/termites/where-they-are-found'
  },
  {
    title: 'How Termites Spread',
    desc: 'Movement through soil, foundation openings, and structural pathways.',
    href: '/knowledge/termites/how-they-spread'
  },
  {
    title: 'Termite Prevention',
    desc: 'Practical moisture mitigation, wood-to-soil reduction, and sealing.',
    href: '/knowledge/termites/prevention'
  },
  {
    title: 'Termite Treatment Guide',
    desc: 'The 4-stage journey: inspection, assessment, targeted treatment, and monitoring.',
    href: '/knowledge/termites/treatment-guide'
  },
  {
    title: 'Termite FAQ',
    desc: 'Factual answers regarding costs, signs, preparation, and apartments.',
    href: '/knowledge/termites/faq'
  }
];

const identificationSigns = [
  {
    title: 'Mud Shelter Tubes on Walls & Skirting',
    desc: 'Subterranean termites build pencil-thick earthen tunnels out of soil, wood particles, and salivary secretions. These mud tubes run along foundation walls, baseboards, door frames, and brickwork to maintain internal moisture and shield workers from drying air currents.',
    icon: Waves
  },
  {
    title: 'Hollow-Sounding Wooden Fixtures',
    desc: 'Termites consume timber from the inside out, preserving an exterior veneer of paint or laminate. When tapped firmly with the handle of a screwdriver, infested door frames, skirting, or wardrobe panels sound paper-thin, dull, or distinctly hollow.',
    icon: Layers
  },
  {
    title: 'Discarded Swarmer Wings (Alates)',
    desc: 'During warm, humid monsoon evenings in Bangalore, reproductive winged termites (swarmers or alates) emerge in mating flights. Shortly after landing, they shed their wings, leaving piles of identical translucent wings on windowsills, balconies, and near light fixtures.',
    icon: AlertTriangle
  },
  {
    title: 'Tight-Fitting Doors & Warped Window Frames',
    desc: 'As subterranean colonies tunnel through wooden jambs and frames, their metabolic moisture and soil packing cause the timber to swell. Doors and windows that suddenly become difficult to close or latch can indicate concealed activity.',
    icon: DoorOpen
  },
  {
    title: 'Blistering or Bubbling Paint & Wallpaper',
    desc: 'Active termite galleries directly behind plasterboard or painted wood can cause surface coatings to blister, sag, or present faint rippling lines resembling minor water damage.',
    icon: Eye
  },
  {
    title: 'Earthy Debris & Pinholes in Wall Plaster',
    desc: 'Tiny pinhole punctures in drywall or masonry joint mortar often plugged with dark brown soil fragments indicate exploratory termite foraging behind interior finishes.',
    icon: Search
  }
];
---

<Layout
  title="Termite Identification | Signs, Mud Tubes & Hollow Wood | SLV Pest Control"
  description="Learn how to identify subterranean termite activity in Bangalore properties. Recognize key signs: earthen mud tubes, hollow woodwork, discarded swarmer wings, and structural damage."
  canonical="https://slvpestcontrol.com/knowledge/termites/identification"
>
  <Header client:load activeItem="knowledge" />

  <main class="flex-1 w-full relative overflow-hidden bg-[#090a0c]">
    {/* Architectural Background Pattern */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 right-1/4 w-[500px] h-[500px] bg-[#E5A93C]/[0.06] rounded-full blur-[140px]"></div>
      <div class="absolute top-[40%] left-[-100px] w-[500px] h-[500px] bg-[#E5A93C]/[0.04] rounded-full blur-[160px]"></div>
    </div>

    {/* Breadcrumbs: Home > Knowledge Hub > Termites > Current Page */}
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs text-zinc-400">
        <a href="/" class="hover:text-white transition">Home</a>
        <span>&gt;</span>
        <a href="/knowledge" class="hover:text-white transition">Knowledge Hub</a>
        <span>&gt;</span>
        <a href="/services/termite-control" class="hover:text-white transition">Termites</a>
        <span>&gt;</span>
        <span class="text-[#F6C453] font-semibold">Termite Identification</span>
      </nav>
    </div>

    {/* HERO */}
    <section class="relative z-10 pt-10 sm:pt-14 pb-12 sm:pb-16 border-b border-white/[0.06]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 mb-4 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-md">
          <BookOpen class="w-3.5 h-3.5 text-[#E5A93C]" />
          <span class="text-[#E5A93C] text-xs font-extrabold tracking-[0.2em] uppercase">
            TERMITE KNOWLEDGE HUB
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-5 font-heading">
          Termite Identification in <span class="slv-gold-text">Bangalore</span>
        </h1>

        <p class="text-zinc-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto mb-8">
          Recognize early physical indicators of subterranean termite activity in your home, apartment, or commercial property before structural damage escalates.
        </p>

        {/* Primary CTA */}
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
          <a
            href="/services/termite-control"
            class="slv-btn-primary w-full sm:w-auto px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <span>Termite Inspection</span>
            <ArrowRight class="w-4 h-4 ml-1" />
          </a>
          <a
            href="tel:9180397822"
            class="slv-btn-secondary w-full sm:w-auto px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <Phone class="w-4 h-4 text-[#F6C453] mr-1" />
            <span>Call: 91803 97822</span>
          </a>
        </div>
      </div>
    </section>

    {/* CONTENT SECTION */}
    <section class="relative z-10 py-14 sm:py-20 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        {/* Overview Card */}
        <div class="slv-card rounded-3xl p-8 sm:p-10 border border-white/[0.08] mb-12">
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-4">
            Understanding Subterranean Termite Behavior
          </h2>
          <div class="space-y-4 text-zinc-300 text-sm sm:text-base leading-relaxed">
            <p>
              In Bangalore and southern India, subterranean termites (predominantly species belonging to the genera <em>Coptotermes</em> and <em>Odontotermes</em>) live in large colonies deep beneath the soil. Unlike drywood termites that live solely inside timber, subterranean termites require continuous contact with ground soil or sustained structural moisture to survive.
            </p>
            <p>
              Because workers and soldiers are blind and desiccate quickly when exposed to dry air, they never forage out in the open. Instead, they construct concealed earthen mud galleries through masonry cracks, plumbing sleeves, and expansion joints to access wooden fixtures, door jambs, and cabinetry.
            </p>
          </div>
        </div>

        {/* 6 Signs Grid */}
        <div class="mb-14">
          <div class="text-center max-w-2xl mx-auto mb-10">
            <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-2">DIAGNOSTIC SIGNS</span>
            <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
              Primary Signs of Termite Activity
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {identificationSigns.map((sign) => {
              const Icon = sign.icon;
              return (
                <div class="slv-card rounded-2xl p-6 border border-white/[0.08] flex flex-col justify-between">
                  <div>
                    <div class="w-10 h-10 rounded-xl bg-[#E5A93C]/10 border border-[#E5A93C]/20 flex items-center justify-center text-[#E5A93C] mb-4">
                      <Icon class="w-5 h-5" />
                    </div>
                    <h3 class="text-lg font-bold text-white mb-2 font-heading">{sign.title}</h3>
                    <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed">{sign.desc}</p>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        {/* Termites vs Flying Ants Comparison */}
        <div class="slv-card rounded-3xl p-8 sm:p-10 border border-white/[0.08] mb-14">
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-6">
            Termite Swarmers vs. Flying Ants: Key Distinctions
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/[0.06]">
              <span class="text-xs font-bold text-[#F6C453] uppercase tracking-wider block mb-1">Wood-Destroying Insect</span>
              <h3 class="text-lg font-bold text-white mb-2">Termite Swarmer (Alate)</h3>
              <ul class="space-y-2 text-zinc-400 text-xs sm:text-sm pl-4 list-disc">
                <li><strong>Waist:</strong> Thick, uniform waist with no pinched constriction.</li>
                <li><strong>Antennae:</strong> Straight and beaded resembling tiny pearls.</li>
                <li><strong>Wings:</strong> Four wings of equal size and shape, twice the length of the body.</li>
                <li><strong>Wings Shed:</strong> Shed readily shortly after landing.</li>
              </ul>
            </div>

            <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/[0.06]">
              <span class="text-xs font-bold text-[#F6C453] uppercase tracking-wider block mb-1">Common Nuisance Insect</span>
              <h3 class="text-lg font-bold text-white mb-2">Flying Ant (Carpenter / Black Ant)</h3>
              <ul class="space-y-2 text-zinc-400 text-xs sm:text-sm pl-4 list-disc">
                <li><strong>Waist:</strong> Distinctly pinched, narrow waist (pedicel).</li>
                <li><strong>Antennae:</strong> Bent or elbowed at a noticeable angle.</li>
                <li><strong>Wings:</strong> Front wings distinctly larger than hind wings.</li>
                <li><strong>Wings Shed:</strong> Remain firmly attached much longer.</li>
              </ul>
            </div>
          </div>
        </div>

        {/* CTA Banner */}
        <div class="slv-card rounded-3xl p-8 sm:p-12 border border-[#E5A93C]/40 bg-gradient-to-b from-[#14161c] to-[#0c0d10] text-center mb-16 shadow-[0_20px_50px_rgba(0,0,0,0.8)]">
          <ShieldCheck class="w-12 h-12 text-[#E5A93C] mx-auto mb-4" />
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-3">
            Concerned About Termite Activity in Your Wooden Fixtures?
          </h2>
          <p class="text-zinc-300 text-xs sm:text-sm max-w-lg mx-auto mb-6 leading-relaxed">
            Schedule an on-site property inspection by SLV Pest Control technicians to confirm activity and evaluate structural pathways. Pricing confirmed after inspection.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
              href="/services/termite-control"
              class="slv-btn-primary px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
            >
              <span>Termite Inspection</span>
              <ArrowRight class="w-4 h-4 ml-1" />
            </a>
            <a
              href="https://wa.me/9180397822"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-md inline-flex items-center transition"
            >
              <MessageCircle class="w-4 h-4 mr-1 text-white" />
              <span>WhatsApp Us</span>
            </a>
          </div>
        </div>

        {/* Related Knowledge Hub Articles */}
        <div>
          <div class="flex items-center gap-2 mb-6">
            <BookOpen class="w-4 h-4 text-[#E5A93C]" />
            <h2 class="text-xl font-bold text-white font-heading">
              Explore More Termite Guides
            </h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {relatedArticles.map((article) => (
              <a
                href={article.href}
                class="slv-card rounded-2xl p-5 border border-white/[0.08] hover:border-[#E5A93C]/50 transition block group"
              >
                <h3 class="text-sm font-bold text-white group-hover:text-[#F6C453] transition mb-1.5 flex items-center justify-between">
                  <span>{article.title}</span>
                  <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                </h3>
                <p class="text-zinc-400 text-xs leading-relaxed">{article.desc}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* CONTACT & SERVICE DETAILS */}
    <section class="relative z-10 py-14 sm:py-18 bg-[#0c0d10]/50 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="slv-card rounded-3xl p-6 sm:p-10 border border-white/[0.08]">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs">
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Bangalore Service Office</span>
              <p class="text-white text-sm">143 Soundarya Layout, Doddabidarakallu, Bangalore 560073</p>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Phone / WhatsApp</span>
              <a href="tel:9180397822" class="text-white text-sm font-bold font-mono hover:text-[#FFE08A]">91803 97822</a>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Email Support</span>
              <a href="mailto:contact@slvpestcontrol.com" class="text-white text-sm hover:text-[#FFE08A]">contact@slvpestcontrol.com</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingActions client:load />
</Layout>
