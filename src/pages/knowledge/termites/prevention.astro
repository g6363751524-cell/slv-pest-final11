---
import Layout from '../../../layouts/Layout.astro';
import { Header } from '../../../components/Header';
import { Footer } from '../../../components/Footer';
import { FloatingActions } from '../../../components/FloatingActions';
import {
  BookOpen,
  Search,
  ShieldCheck,
  CheckCircle2,
  Droplets,
  Layers,
  Wrench,
  Clock,
  ArrowRight,
  Phone,
  MessageCircle,
  Mail,
  Home,
  Building,
  TreePine
} from 'lucide-react';

const relatedArticles = [
  {
    title: 'Termite Identification',
    desc: 'Recognize signs: mud tubes, hollow woodwork, and discarded wings.',
    href: '/knowledge/termites/identification'
  },
  {
    title: 'Where Termites Are Found',
    desc: 'Foundations, wooden door frames, floor joints, and concealed spaces.',
    href: '/knowledge/termites/where-they-are-found'
  },
  {
    title: 'How Termites Spread',
    desc: 'Movement through soil, foundation openings, and structural pathways.',
    href: '/knowledge/termites/how-they-spread'
  },
  {
    title: 'Termite Treatment Guide',
    desc: 'The 4-stage journey: inspection, assessment, targeted treatment, and monitoring.',
    href: '/knowledge/termites/treatment-guide'
  },
  {
    title: 'Termite FAQ',
    desc: 'Factual answers regarding costs, signs, preparation, and apartments.',
    href: '/knowledge/termites/faq'
  }
];

const preventionMeasures = [
  {
    title: 'Address Structural Moisture Problems',
    desc: 'Fix under-sink pipe drips, resolve bathroom tile seepages, and divert rainwater downspouts at least 1–2 meters away from plinth masonry. Moisture-laden soil directly adjacent to foundations creates an ideal subterranean breeding environment.',
    icon: Droplets
  },
  {
    title: 'Inspect Wooden Structures Routinely',
    desc: 'Periodically tap door jambs, wardrobe base plinths, and skirting boards with a hard tool handle. Check for soft spots, subtle paint blistering, or hollow reverberations behind decorative paneling.',
    icon: Search
  },
  {
    title: 'Eliminate Direct Wood-to-Soil Ground Contact',
    desc: 'Ensure wooden door frames, pergolas, and decorative fence posts do not rest directly in garden dirt. Maintain a physical concrete gap or metal shoe barrier between outdoor soil and structural timber.',
    icon: TreePine
  },
  {
    title: 'Seal Foundation Cracks & Utility Openings',
    desc: 'Caulk hairline cracks in external foundation plaster with elastomeric sealants. Seal expansion gaps around electrical conduit penetrations and plumbing sleeves passing through concrete slabs.',
    icon: Wrench
  },
  {
    title: 'Keep Garden Mulch & Stored Timber Away',
    desc: 'Avoid stacking scrap firewood, discarded cardboard, or cellulose-rich landscaping mulch directly against exterior building walls. Stored timber against walls provides a direct bridge bypassing foundation barriers.',
    icon: Layers
  },
  {
    title: 'Check Properties Periodically Across Seasons',
    desc: 'Conduct dedicated inspections twice yearly—particularly before the pre-monsoon rains (April/May) and following the monsoon swarming period (September/October)—to detect emerging shelter tubes.',
    icon: Building
  },
  {
    title: 'Act Early When Initial Signs Appear',
    desc: 'The cost and complexity of termite management correlate directly with infestation age. Calling for professional assessment at the first sighting of mud tubes prevents extensive woodwork replacement.',
    icon: Clock
  }
];
---

<Layout
  title="Termite Prevention Guide | Moisture, Wood Clearance & Sealing | SLV Pest Control"
  description="Practical subterranean termite prevention measures for Bangalore properties: eliminate moisture, inspect woodwork, avoid wood-to-soil contact, and seal foundation cracks."
  canonical="https://slvpestcontrol.com/knowledge/termites/prevention"
>
  <Header client:load activeItem="knowledge" />

  <main class="flex-1 w-full relative overflow-hidden bg-[#090a0c]">
    {/* Architectural Background Pattern */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 right-1/4 w-[500px] h-[500px] bg-[#E5A93C]/[0.06] rounded-full blur-[140px]"></div>
      <div class="absolute top-[40%] left-[-100px] w-[500px] h-[500px] bg-[#E5A93C]/[0.04] rounded-full blur-[160px]"></div>
    </div>

    {/* Breadcrumbs: Home > Knowledge Hub > Termites > Current Page */}
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs text-zinc-400">
        <a href="/" class="hover:text-white transition">Home</a>
        <span>&gt;</span>
        <a href="/knowledge" class="hover:text-white transition">Knowledge Hub</a>
        <span>&gt;</span>
        <a href="/services/termite-control" class="hover:text-white transition">Termites</a>
        <span>&gt;</span>
        <span class="text-[#F6C453] font-semibold">Termite Prevention</span>
      </nav>
    </div>

    {/* HERO */}
    <section class="relative z-10 pt-10 sm:pt-14 pb-12 sm:pb-16 border-b border-white/[0.06]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 mb-4 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-md">
          <BookOpen class="w-3.5 h-3.5 text-[#E5A93C]" />
          <span class="text-[#E5A93C] text-xs font-extrabold tracking-[0.2em] uppercase">
            STRUCTURAL DEFENSE STRATEGIES
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-5 font-heading">
          Termite Prevention: <span class="slv-gold-text">Practical Steps for Properties</span>
        </h1>

        <p class="text-zinc-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto mb-8">
          Realistic, actionable maintenance and exclusion habits to reduce moisture attraction and protect residential and commercial structures.
        </p>

        {/* Primary CTA */}
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
          <a
            href="/services/termite-control"
            class="slv-btn-primary w-full sm:w-auto px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <span>Termite Treatment</span>
            <ArrowRight class="w-4 h-4 ml-1" />
          </a>
          <a
            href="tel:9180397822"
            class="slv-btn-secondary w-full sm:w-auto px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <Phone class="w-4 h-4 text-[#F6C453] mr-1" />
            <span>Call: 91803 97822</span>
          </a>
        </div>
      </div>
    </section>

    {/* CONTENT SECTION */}
    <section class="relative z-10 py-14 sm:py-20 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        {/* Why Prevention Matters */}
        <div class="slv-card rounded-3xl p-8 sm:p-10 border border-white/[0.08] mb-12">
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-4">
            Proactive Exclusion vs. Expensive Remediation
          </h2>
          <div class="space-y-4 text-zinc-300 text-sm sm:text-base leading-relaxed">
            <p>
              Subterranean termites cause billions in property damage globally each year. Because early excavation takes place completely out of sight inside door frames, sub-floor screeds, and interior cabinets, significant structural weakening often precedes outward visual symptoms.
            </p>
            <p>
              Proactive preventative maintenance focuses on eliminating the two environmental conditions termites need to breach buildings: <strong>excess moisture near foundations</strong> and <strong>uninhibited physical pathways between ground soil and interior woodwork</strong>.
            </p>
          </div>
        </div>

        {/* 7 Prevention Measures Grid */}
        <div class="mb-14">
          <div class="text-center max-w-2xl mx-auto mb-10">
            <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-2">PRACTICAL DEFENSE</span>
            <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
              7 Actionable Prevention Measures
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {preventionMeasures.map((measure) => {
              const Icon = measure.icon;
              return (
                <div class="slv-card rounded-2xl p-6 border border-white/[0.08] flex flex-col justify-between">
                  <div>
                    <div class="w-10 h-10 rounded-xl bg-[#E5A93C]/10 border border-[#E5A93C]/20 flex items-center justify-center text-[#E5A93C] mb-4">
                      <Icon class="w-5 h-5" />
                    </div>
                    <h3 class="text-lg font-bold text-white mb-2 font-heading">{measure.title}</h3>
                    <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed">{measure.desc}</p>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        {/* Maintenance Reality Check */}
        <div class="slv-card rounded-3xl p-8 sm:p-10 border border-white/[0.08] mb-14">
          <h2 class="text-2xl font-black text-white font-heading mb-4">
            Can Prevention Replace Professional Chemical Barrier Treatment?
          </h2>
          <div class="space-y-4 text-zinc-300 text-sm leading-relaxed">
            <p>
              While good property hygiene, sealing, and drainage control reduce environmental attraction, they cannot repel an active subterranean colony that has already established foraging galleries beneath a concrete foundation slab.
            </p>
            <p>
              Once termites have penetrated the plinth or entered interior door frames, physical maintenance must be paired with professional drill-and-infusion termiticide barrier treatment. Professional treatment establishes a chemical zone in the masonry that disrupts colony communication and prevents re-infestation.
            </p>
          </div>
        </div>

        {/* CTA Banner */}
        <div class="slv-card rounded-3xl p-8 sm:p-12 border border-[#E5A93C]/40 bg-gradient-to-b from-[#14161c] to-[#0c0d10] text-center mb-16 shadow-[0_20px_50px_rgba(0,0,0,0.8)]">
          <ShieldCheck class="w-12 h-12 text-[#E5A93C] mx-auto mb-4" />
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-3">
            Need Expert Termite Evaluation for Your Property?
          </h2>
          <p class="text-zinc-300 text-xs sm:text-sm max-w-lg mx-auto mb-6 leading-relaxed">
            Schedule an on-site property inspection with SLV Pest Control technicians to assess foundation vulnerabilities and receive upfront quotation after inspection.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
              href="/services/termite-control"
              class="slv-btn-primary px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
            >
              <span>Termite Treatment</span>
              <ArrowRight class="w-4 h-4 ml-1" />
            </a>
            <a
              href="https://wa.me/9180397822"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-md inline-flex items-center transition"
            >
              <MessageCircle class="w-4 h-4 mr-1 text-white" />
              <span>WhatsApp Us</span>
            </a>
          </div>
        </div>

        {/* Related Knowledge Hub Articles */}
        <div>
          <div class="flex items-center gap-2 mb-6">
            <BookOpen class="w-4 h-4 text-[#E5A93C]" />
            <h2 class="text-xl font-bold text-white font-heading">
              Explore More Termite Guides
            </h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {relatedArticles.map((article) => (
              <a
                href={article.href}
                class="slv-card rounded-2xl p-5 border border-white/[0.08] hover:border-[#E5A93C]/50 transition block group"
              >
                <h3 class="text-sm font-bold text-white group-hover:text-[#F6C453] transition mb-1.5 flex items-center justify-between">
                  <span>{article.title}</span>
                  <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                </h3>
                <p class="text-zinc-400 text-xs leading-relaxed">{article.desc}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* CONTACT & SERVICE DETAILS */}
    <section class="relative z-10 py-14 sm:py-18 bg-[#0c0d10]/50 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="slv-card rounded-3xl p-6 sm:p-10 border border-white/[0.08]">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs">
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Bangalore Service Office</span>
              <p class="text-white text-sm">143 Soundarya Layout, Doddabidarakallu, Bangalore 560073</p>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Phone / WhatsApp</span>
              <a href="tel:9180397822" class="text-white text-sm font-bold font-mono hover:text-[#FFE08A]">91803 97822</a>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Email Support</span>
              <a href="mailto:contact@slvpestcontrol.com" class="text-white text-sm hover:text-[#FFE08A]">contact@slvpestcontrol.com</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingActions client:load />
</Layout>
