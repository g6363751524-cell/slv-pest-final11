---
import Layout from '../../../layouts/Layout.astro';
import { Header } from '../../../components/Header';
import { Footer } from '../../../components/Footer';
import { FloatingActions } from '../../../components/FloatingActions';
import {
  BookOpen,
  HelpCircle,
  ShieldCheck,
  ArrowRight,
  Phone,
  MessageCircle,
  Mail,
  MapPin,
  Building
} from 'lucide-react';

const relatedArticles = [
  {
    title: 'Termite Identification',
    desc: 'Recognize signs: mud tubes, hollow woodwork, and discarded wings.',
    href: '/knowledge/termites/identification'
  },
  {
    title: 'Where Termites Are Found',
    desc: 'Foundations, wooden door frames, floor joints, and concealed spaces.',
    href: '/knowledge/termites/where-they-are-found'
  },
  {
    title: 'How Termites Spread',
    desc: 'Movement through soil, foundation openings, and structural pathways.',
    href: '/knowledge/termites/how-they-spread'
  },
  {
    title: 'Termite Prevention',
    desc: 'Practical moisture mitigation, wood-to-soil reduction, and sealing.',
    href: '/knowledge/termites/prevention'
  },
  {
    title: 'Termite Treatment Guide',
    desc: 'The 4-stage journey: inspection, assessment, targeted treatment, and monitoring.',
    href: '/knowledge/termites/treatment-guide'
  }
];

const faqs = [
  {
    q: 'How do I know if my property has termites?',
    a: 'Key signs include earthen mud shelter tubes extending along walls or door jambs, wooden frames sounding paper-thin or hollow when tapped, discarded swarmer wings on windowsills during monsoon evenings, tight-fitting doors caused by swollen timber, and subtle blistering of wall paint.'
  },
  {
    q: 'What are the common signs of termites?',
    a: 'Common indicators include: (1) brown mud tubes across masonry surfaces, (2) hollow, brittle woodwork with intact paint veneers, (3) piles of shed translucent wings near exterior openings, (4) fine soil particles plugged into drywall pinholes, and (5) sagging or jammed wooden fixtures.'
  },
  {
    q: 'Where do termites usually occur?',
    a: 'Subterranean termites originate in ground soil and enter properties through foundation plinth joints, flooring expansion gaps, plumbing wall penetrations, and electrical conduits. Once inside, they typically colonize door frames, skirting boards, built-in wardrobes, modular kitchen cabinetry, and false ceiling timber battens.'
  },
  {
    q: 'Can termites damage a property?',
    a: 'Yes. Subterranean termites consume cellulose—the primary structural polymer in natural wood, plywood, and paper-faced drywall. Left unaddressed, colonies can hollow out structural door frames, compromise kitchen cabinetry, damage wooden flooring underlay, and chew through electrical wiring insulation within conduits.'
  },
  {
    q: 'How much does termite treatment cost?',
    a: 'Termite treatment pricing is determined after an on-site property inspection. Because cost depends on the linear footage of masonry to be treated, woodwork volume, construction design, and property layout, an inspection is required to provide an accurate, transparent quotation.'
  },
  {
    q: 'Why is inspection required?',
    a: 'An on-site inspection allows the technician to confirm whether activity is active or dormant, identify subterranean entry pathways through foundation masonry, assess woodwork damage depth, and formulate the appropriate drill-and-infusion barrier protocol for your specific property layout.'
  },
  {
    q: 'How long does termite treatment take?',
    a: 'Treatment duration depends on the property dimensions, number of door frames and affected rooms, and linear feet of drilling required. A typical residential apartment treatment usually takes several hours, while large independent villas or multi-story commercial facilities require more time as evaluated during inspection.'
  },
  {
    q: 'Is treatment suitable for apartments?',
    a: 'Yes. Termites frequently travel up central plumbing stacks and expansion joints into upper-floor apartments. Our drill-and-infusion techniques are specifically calibrated for apartment skirting boards and door frames, using low-noise equipment and aesthetic color-matched hole sealing.'
  },
  {
    q: 'Can existing termite activity return?',
    a: 'While professional non-repellent chemical barriers establish a resilient protective zone in treated masonry, termites can potentially find new untreated entry cracks if subsequent structural modifications occur or if external soil conditions shift. Following proper post-treatment maintenance and scheduling periodic inspections helps ensure ongoing property defense.'
  },
  {
    q: 'What preparation is required?',
    a: 'Key preparation steps include moving loose furniture approximately 2 to 3 feet away from walls and skirting boards to provide technician access, clearing items from the base of wardrobes and under-sink cabinets, and identifying areas where previous activity was noticed.'
  },
  {
    q: 'What should I do after treatment?',
    a: 'Allow treated drilled holes and sealant to dry completely. Avoid washing skirting boards with excessive standing water immediately following service, resolve any persistent plumbing leaks that contribute to structural dampness, and follow the technician’s post-service monitoring guidelines.'
  },
  {
    q: 'Do you provide follow-up and monitoring?',
    a: 'Yes. SLV Pest Control provides structured follow-up and monitoring guidance according to your specific service agreement terms to evaluate chemical barrier performance and verify that structural activity has been successfully arrested.'
  }
];
---

<Layout
  title="Termite Control FAQ | Questions & Answers | SLV Pest Control"
  description="Answers to frequently asked questions about termite control in Bangalore: signs, structural damage, pricing after inspection, preparation, duration, apartments, and monitoring."
  canonical="https://slvpestcontrol.com/knowledge/termites/faq"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "@id": "https://slvpestcontrol.com/knowledge/termites/faq#faq",
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      }))
    })} />
  </Fragment>

  <Header client:load activeItem="knowledge" />

  <main class="flex-1 w-full relative overflow-hidden bg-[#090a0c]">
    {/* Architectural Background Pattern */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 right-1/4 w-[500px] h-[500px] bg-[#E5A93C]/[0.06] rounded-full blur-[140px]"></div>
      <div class="absolute top-[40%] left-[-100px] w-[500px] h-[500px] bg-[#E5A93C]/[0.04] rounded-full blur-[160px]"></div>
    </div>

    {/* Breadcrumbs: Home > Knowledge Hub > Termites > Current Page */}
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs text-zinc-400">
        <a href="/" class="hover:text-white transition">Home</a>
        <span>&gt;</span>
        <a href="/knowledge" class="hover:text-white transition">Knowledge Hub</a>
        <span>&gt;</span>
        <a href="/services/termite-control" class="hover:text-white transition">Termites</a>
        <span>&gt;</span>
        <span class="text-[#F6C453] font-semibold">Termite FAQ</span>
      </nav>
    </div>

    {/* HERO */}
    <section class="relative z-10 pt-10 sm:pt-14 pb-12 sm:pb-16 border-b border-white/[0.06]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 mb-4 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-md">
          <HelpCircle class="w-3.5 h-3.5 text-[#E5A93C]" />
          <span class="text-[#E5A93C] text-xs font-extrabold tracking-[0.2em] uppercase">
            FREQUENTLY ASKED QUESTIONS
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-5 font-heading">
          Frequently Asked Questions About <span class="slv-gold-text">Termite Treatment</span>
        </h1>

        <p class="text-zinc-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto mb-8">
          Clear, factual answers regarding subterranean termite identification, structural damage, inspection-based pricing, preparation, and barrier treatments.
        </p>

        {/* Primary CTA */}
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
          <a
            href="/services/termite-control"
            class="slv-btn-primary w-full sm:w-auto px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <span>Get Free Inspection</span>
            <ArrowRight class="w-4 h-4 ml-1" />
          </a>
          <a
            href="tel:9180397822"
            class="slv-btn-secondary w-full sm:w-auto px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
          >
            <Phone class="w-4 h-4 text-[#F6C453] mr-1" />
            <span>Call: 91803 97822</span>
          </a>
        </div>
      </div>
    </section>

    {/* FAQS ACCORDION / CARD SECTION */}
    <section class="relative z-10 py-14 sm:py-20 border-b border-white/[0.06]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="space-y-4 mb-16">
          {faqs.map((faq, index) => (
            <div class="slv-card rounded-2xl p-6 sm:p-7 border border-white/[0.08] transition hover:border-[#E5A93C]/40">
              <div class="flex items-start gap-3.5 mb-2.5">
                <span class="text-xs font-mono font-bold text-[#F6C453] bg-[#E5A93C]/10 px-2 py-0.5 rounded shrink-0 mt-0.5">
                  Q{index + 1 < 10 ? `0${index + 1}` : index + 1}
                </span>
                <h2 class="text-base sm:text-lg font-bold text-white font-heading">
                  {faq.q}
                </h2>
              </div>
              <p class="text-zinc-300 text-xs sm:text-sm leading-relaxed pl-10">
                {faq.a}
              </p>
            </div>
          ))}
        </div>

        {/* CTA Banner */}
        <div class="slv-card rounded-3xl p-8 sm:p-12 border border-[#E5A93C]/40 bg-gradient-to-b from-[#14161c] to-[#0c0d10] text-center mb-16 shadow-[0_20px_50px_rgba(0,0,0,0.8)]">
          <ShieldCheck class="w-12 h-12 text-[#E5A93C] mx-auto mb-4" />
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-3">
            Have Questions About Termite Infestation in Your Property?
          </h2>
          <p class="text-zinc-300 text-xs sm:text-sm max-w-lg mx-auto mb-6 leading-relaxed">
            Speak directly with SLV Pest Control technicians or book an on-site property inspection. Accurate pricing is confirmed after assessing running linear feet.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
              href="/services/termite-control"
              class="slv-btn-primary px-7 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider"
            >
              <span>Get Free Inspection</span>
              <ArrowRight class="w-4 h-4 ml-1" />
            </a>
            <a
              href="https://wa.me/9180397822"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-md inline-flex items-center transition"
            >
              <MessageCircle class="w-4 h-4 mr-1 text-white" />
              <span>WhatsApp Us</span>
            </a>
          </div>
        </div>

        {/* Related Knowledge Hub Articles */}
        <div>
          <div class="flex items-center gap-2 mb-6">
            <BookOpen class="w-4 h-4 text-[#E5A93C]" />
            <h2 class="text-xl font-bold text-white font-heading">
              Explore More Termite Guides
            </h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {relatedArticles.map((article) => (
              <a
                href={article.href}
                class="slv-card rounded-2xl p-5 border border-white/[0.08] hover:border-[#E5A93C]/50 transition block group"
              >
                <h3 class="text-sm font-bold text-white group-hover:text-[#F6C453] transition mb-1.5 flex items-center justify-between">
                  <span>{article.title}</span>
                  <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                </h3>
                <p class="text-zinc-400 text-xs leading-relaxed">{article.desc}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* CONTACT & SERVICE DETAILS */}
    <section class="relative z-10 py-14 sm:py-18 bg-[#0c0d10]/50 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="slv-card rounded-3xl p-6 sm:p-10 border border-white/[0.08]">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs">
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Bangalore Service Office</span>
              <p class="text-white text-sm">143 Soundarya Layout, Doddabidarakallu, Bangalore 560073</p>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Phone / WhatsApp</span>
              <a href="tel:9180397822" class="text-white text-sm font-bold font-mono hover:text-[#FFE08A]">91803 97822</a>
            </div>
            <div>
              <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider block mb-1">Email Support</span>
              <a href="mailto:contact@slvpestcontrol.com" class="text-white text-sm hover:text-[#FFE08A]">contact@slvpestcontrol.com</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingActions client:load />
</Layout>
