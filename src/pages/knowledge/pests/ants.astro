---
import Layout from '../../../layouts/Layout.astro';
import { Header } from '../../../components/Header';
import { Footer } from '../../../components/Footer';
import { FloatingActions } from '../../../components/FloatingActions';
import {
  ChevronRight,
  BookOpen,
  Search,
  Eye,
  AlertTriangle,
  CheckCircle2,
  ArrowRight,
  Phone,
  MessageCircle,
  ShieldCheck,
  Activity,
  Droplets,
  Layers,
  Sparkles,
  MapPin,
  Clock,
  Flame,
  Bug,
  Home,
  UtensilsCrossed,
  ShieldAlert,
  HelpCircle,
  Calendar,
  Compass,
  FileText
} from 'lucide-react';

// Breadcrumb structured items
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Knowledge Hub', href: '/knowledge' },
  { label: 'Pest Library', href: '/knowledge/pests' },
  { label: 'Ants', href: '/knowledge/pests/ants', current: true }
];

// Quick information metrics
const quickStats = [
  {
    label: 'Primary Habitats',
    value: 'Kitchens & Wall Cavities',
    detail: 'Pantries, under sinks, window trim & foundation voids',
    icon: Home
  },
  {
    label: 'Peak Activity',
    value: 'Summer & Post-Monsoon',
    detail: 'Surging during dry heat (seeking water) and rain floods',
    icon: Calendar
  },
  {
    label: 'Infestation Risk',
    value: 'Moderate to High',
    detail: 'Food contamination, pheromone trails & budding nests',
    icon: ShieldAlert
  },
  {
    label: 'Control Protocol',
    value: 'Targeted Gel Baiting',
    detail: 'Non-repellent matrix transfer eliminating the queen',
    icon: ShieldCheck
  }
];

// Section navigation links
const navSections = [
  { id: 'overview', label: 'Overview' },
  { id: 'types-of-ants', label: 'Types of Ants' },
  { id: 'signs-of-infestation', label: 'Signs of Infestation' },
  { id: 'where-they-hide', label: 'Where They Hide' },
  { id: 'risks-problems', label: 'Risks & Problems' },
  { id: 'prevention-tips', label: 'Prevention Tips' },
  { id: 'treatment-options', label: 'Treatment Options' },
  { id: 'faqs', label: 'FAQs' }
];

// 4 Common Ant Species
const antSpecies = [
  {
    name: 'Sugar Ants (Black House Ant)',
    scientific: 'Ochetellus glaber / Tapinoma sessile',
    size: '2.5 – 3.0 mm',
    color: 'Glossy dark brown to jet black',
    behavior: 'Highly attracted to sweet foods, syrups, honey, ripe fruit, and kitchen grease residues. Follows disciplined foraging trails.',
    habitats: 'Kitchen pantries, gaps behind wall tiles, under microwave bases, and window sill gaps.',
    riskBadge: 'Pantry Invader',
    badgeColor: 'text-amber-400 border-amber-400/30 bg-amber-400/10'
  },
  {
    name: 'Carpenter Ants',
    scientific: 'Camponotus compressus',
    size: '6.0 – 15.0 mm',
    color: 'Matte black or dark reddish-black',
    behavior: 'Equipped with powerful chewing mandibles; excavates nesting galleries into damp, decaying timber without ingesting cellulose.',
    habitats: 'Moist door frames, roof rafters, decaying tree branches near walls, and bathroom ceiling voids.',
    riskBadge: 'Wood Cavity Excavator',
    badgeColor: 'text-orange-400 border-orange-400/30 bg-orange-400/10'
  },
  {
    name: 'Pharaoh Ants',
    scientific: 'Monomorium pharaonis',
    size: '1.5 – 2.0 mm',
    color: 'Translucent yellow to light orange-brown',
    behavior: 'Multi-queen species. Extremely sensitive to repellent sprays; chemical disturbance triggers rapid colony budding into dozens of satellite nests.',
    habitats: 'Electrical conduits, heated appliance motors, switchboard voids, and sterile commercial kitchen shafts.',
    riskBadge: 'Budding Risk',
    badgeColor: 'text-yellow-400 border-yellow-400/30 bg-yellow-400/10'
  },
  {
    name: 'Fire Ants',
    scientific: 'Solenopsis geminata',
    size: '3.0 – 6.0 mm',
    color: 'Reddish-brown with darker copper abdomen',
    behavior: 'Highly territorial and aggressive when disturbed; delivers repeated burning alkaloid stings resulting in itchy, sterile pustules.',
    habitats: 'Outdoor soil mounds, paved walkway borders, electrical junction boxes, and garden perimeter turf.',
    riskBadge: 'Stinging Risk',
    badgeColor: 'text-rose-400 border-rose-400/30 bg-rose-400/10'
  }
];

// Signs of Infestation
const infestationSigns = [
  {
    title: 'Pheromone Trail Highways',
    description: 'Disciplined, unbroken lines of worker ants traveling systematically across countertops, splashbacks, baseboards, and window casings along established hydrocarbon scent pathways.',
    tag: 'Primary Early Indicator'
  },
  {
    title: 'Food Swarming & Contamination',
    description: 'Rapid concentration of dozens to hundreds of worker ants within unsealed sugar containers, pet food bowls, fruit baskets, bread bins, and kitchen sink grease traps.',
    tag: 'Active Foraging'
  },
  {
    title: 'Nesting Debris & Soil Mounds',
    description: 'Small deposits of fine excavated soil granules, insect parts, or fine sawdust-like frass (from carpenter ants) accumulating beneath skirting boards and masonry fissures.',
    tag: 'Structural Harbor'
  },
  {
    title: 'Clustering at Structural Entries',
    description: 'Frequent clusters of scout ants emerging from behind electrical switchplates, plumbing conduit wall penetrations, window weatherstripping, and balcony floor joins.',
    tag: 'Perimeter Breach'
  }
];

// Where Ants Hide
const hidingLocations = [
  {
    title: 'Kitchen Cabinets & Food-Storage Areas',
    points: [
      'Cavities beneath low kitchen kickboards and drawer glide brackets',
      'Warm compressor compartments behind refrigerators and dishwashers',
      'Unsealed gaps around under-sink water purifier and drainage pipes',
      'Pantry corner joins where spilled grains and sugar dust accumulate'
    ]
  },
  {
    title: 'Wall Cracks & Structural Voids',
    points: [
      'Expansion joints and hairline fissures in masonry plasterwork',
      'Internal wall cavities providing protected routes between rooms',
      'Hollow back boxes behind electrical switches and junction sockets',
      'Suspended false ceiling framework above kitchens and bathrooms'
    ]
  },
  {
    title: 'Window & Door Frameworks',
    points: [
      'Worn rubber weatherstripping and perished perimeter silicone seals',
      'Hollow gaps between aluminum or wooden door jambs and brickwork',
      'Exterior window sill ledges connecting to adjacent garden vegetation',
      'Sliding balcony track drainage channels collecting moisture'
    ]
  },
  {
    title: 'Gardens & Building Foundation Perimeters',
    points: [
      'Soil interfaces directly adjoining exterior building foundation plinths',
      'Gaps beneath concrete walkway pavers and decorative landscaping stones',
      'Tree branches and creeping ornamental vines touching exterior walls',
      'Moist soil beneath air conditioner outdoor drain pipe outlets'
    ]
  }
];

// Risks & Problems
const risksList = [
  {
    title: 'Food Contamination & Spoilage',
    desc: 'Ants forage across waste chutes, exterior soil, and sink drains before walking over kitchen prep counters, transferring mechanical bacteria and spoiling pantry supplies.'
  },
  {
    title: 'Persistent Domestic Disruption',
    desc: 'Once chemical pheromone trails are deposited, scouting workers repeatedly recruit thousands of nestmates, turning meal preparation and dining into daily frustration.'
  },
  {
    title: 'Appliance & Electrical Vulnerabilities',
    desc: 'Species such as Pharaoh and Fire ants frequently harbor inside the warm relay compartments of air conditioners, inverters, and switchboards, causing contact corrosion and electrical shorts.'
  },
  {
    title: 'Timber Cavity Excavation',
    desc: 'Carpenter ants do not ingest cellulose, but hollow out smooth galleries inside moisture-compromised structural timber, weakened window framing, and wooden fascia boards.'
  },
  {
    title: 'Painful Stings & Allergic Reactions',
    desc: 'Fire ant stings inject solenopsin alkaloid venom that produces immediate intense burning sensations, localized swelling, and itchy pustules that risk secondary skin infections in children and pets.'
  }
];

// Prevention Tips
const preventionChecklist = [
  {
    step: '01',
    title: 'Hermetic Food Storage Discipline',
    desc: 'Transfer dry staples, sugar, flours, honey, and cereal into airtight glass or heavy-duty snap-lock acrylic containers. Never store open bags held only with rubber bands.'
  },
  {
    step: '02',
    title: 'Immediate Residue Elimination',
    desc: 'Wipe countertops with vinegar or mild detergent after every cooking session to neutralize sugar drips and grease. Pheromone trails are stripped when surfaces are cleaned thoroughly.'
  },
  {
    step: '03',
    title: 'Eliminate Excess Moisture Sources',
    desc: 'Repair leaking tap valves, address under-sink drain sweating, and ensure kitchen sponges and drying mats air out completely. Ants frequently invade properties primarily seeking water.'
  },
  {
    step: '04',
    title: 'Seal Structural Entry Points',
    desc: 'Apply silicone caulk along gaps between countertops and tiled splashbacks, around window sills, and across wall penetrations for gas pipes and water filtration tubes.'
  },
  {
    step: '05',
    title: 'Sanitize Waste & Pet Dining Zones',
    desc: 'Provide tightly sealed waste bins with foot-operated lids. Clean pet food bowls promptly after meals, or place feeding bowls on shallow water-moat saucers to deter foraging scouts.'
  }
];

// Treatment Methodology
const treatmentSteps = [
  {
    phase: 'Stage 1',
    title: 'Diagnostic Inspection & Species Identification',
    desc: 'Technicians accurately identify the exact ant species before applying any treatments. This step is crucial because multi-queen species like Pharaoh ants must never be sprayed with repellents.'
  },
  {
    phase: 'Stage 2',
    title: 'Precision Micro-Droplet Colony Baiting',
    desc: 'Strategic placement of specialized, slow-acting matrix bait droplets containing attractants matched to current colony nutritional demands (sugar vs protein phases).'
  },
  {
    phase: 'Stage 3',
    title: 'Trophallaxis Transfer to the Queen',
    desc: 'Foraging worker ants consume the non-repellent formulation and carry it back into the heart of concealed nests, feeding the queen, larvae, and nursery workers via mouth-to-mouth sharing.'
  },
  {
    phase: 'Stage 4',
    title: 'Botanical Barrier & Crevice Sealing',
    desc: 'Application of eco-sensitive botanical actives along exterior foundation thresholds and pipe wall joints to establish long-term perimeter defense without indoor toxic odors.'
  }
];

// FAQs
const faqs = [
  {
    q: 'Why are ants suddenly infesting my kitchen in Bangalore?',
    a: 'Ants are driven indoors primarily by weather extremes: during prolonged dry heatwaves, colonies send out scout foragers searching for water and moist food sources. Conversely, heavy monsoon downpours flood subterranean soil nests, forcing entire colonies to seek dry shelter within cavity walls and elevated kitchen kickboards.'
  },
  {
    q: 'Why did over-the-counter insecticide sprays make my ant problem worse?',
    a: 'Consumer aerosol sprays kill only the visible 5–10% of worker ants on the surface. When repellent chemicals are sprayed, especially on species like Pharaoh ants, the concealed colony perceives danger and immediately initiates "budding"—the surviving queens and nurse ants scatter in multiple directions, creating several new separate nests throughout your home.'
  },
  {
    q: 'How long does professional ant baiting take to eliminate an entire colony?',
    a: 'Targeted gel baiting typically produces noticeable reduction within 48 to 72 hours, with complete colony collapse occurring in 7 to 14 days. The slow-acting active ingredient is deliberately designed not to kill foragers immediately so they have adequate time to return and feed the egg-laying queen.'
  },
  {
    q: 'Are SLV Pest Control treatments safe for children, seniors, and pets?',
    a: 'Yes. Our specialized ant management relies on food-grade matrix gel baits placed in precise micro-droplets within concealed cracks, hinges, and under-counter recesses inaccessible to children and pets. No broadcast aerosol fogging or heavy chemical smells are used inside your living spaces.'
  },
  {
    q: 'Can carpenter ants damage the structure of my house like termites?',
    a: 'While carpenter ants do not eat cellulose for nutritional value like subterranean termites, they do excavate smooth nesting galleries inside damp or soft timber. Over time, extensive nesting in window frames, door headers, or structural roof trusses can weaken wooden members, requiring timber repairs.'
  },
  {
    q: 'When should I stop DIY attempts and call a certified technician?',
    a: 'If you notice ants re-emerging continuously after repeated cleanings, trails entering multiple rooms, flying winged ants (swarmers) emerging from walls, or suspect Pharaoh or Carpenter ants, professional intervention is recommended to eliminate the hidden breeding source.'
  }
];

// Related Articles for Sidebar
const relatedArticles = [
  {
    title: 'Where Ants Hide & Nest Indoors',
    desc: 'Discover nesting zones in cracks, wall voids, under sinks, and exterior perimeters.',
    href: '/knowledge/ants/where-they-hide',
    icon: Home
  },
  {
    title: 'How Ants Enter & Spread',
    desc: 'Understand entry through exterior gaps, utility conduits, and scent-guided expansion.',
    href: '/knowledge/ants/how-they-spread',
    icon: Compass
  },
  {
    title: 'Ant Prevention & Food Storage',
    desc: 'Actionable sanitation protocols, moisture control, and structural sealing habits.',
    href: '/knowledge/ants/prevention',
    icon: ShieldCheck
  },
  {
    title: 'Ant Treatment Methodology Guide',
    desc: 'Our systematic 4-stage management protocol: inspection, baiting, and barrier defense.',
    href: '/knowledge/ants/treatment-guide',
    icon: Activity
  },
  {
    title: 'Complete Ant FAQ Guide',
    desc: 'In-depth answers to 12 common homeowner questions about species, baits, and safety.',
    href: '/knowledge/ants/faq',
    icon: HelpCircle
  }
];
---

<Layout
  title="Ants Guide | Identification, Habitats, Risks & Control | SLV Pest Control"
  description="Comprehensive Bangalore homeowner and facility guide to identifying ant species, locating concealed nesting chambers, preventing food contamination, and scientific colony elimination."
  canonical="https://slvpestcontrol.com/knowledge/pests/ants"
>
  <Header client:load activeItem="knowledge" />

  <main class="flex-1 w-full relative overflow-hidden bg-[#090a0c]">
    {/* Subtle Ambient Background Lighting */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 right-1/4 w-96 h-96 bg-[#FFE08A]/[0.025] rounded-full blur-[140px]"></div>
      <div class="absolute top-[40%] -left-32 w-96 h-96 bg-[#D99A18]/[0.02] rounded-full blur-[160px]"></div>
      <div class="absolute bottom-1/4 right-10 w-96 h-96 bg-[#FFE08A]/[0.015] rounded-full blur-[150px]"></div>
    </div>

    {/* BREADCRUMB NAVIGATION */}
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-2">
      <nav aria-label="Breadcrumb" class="flex items-center flex-wrap gap-1.5 text-xs text-zinc-400 font-medium">
        {breadcrumbs.map((crumb, idx) => (
          <div class="flex items-center gap-1.5">
            {idx > 0 && <ChevronRight class="w-3.5 h-3.5 text-zinc-600 shrink-0" />}
            {crumb.current ? (
              <span class="text-[#F6C453] font-semibold" aria-current="page">{crumb.label}</span>
            ) : (
              <a href={crumb.href} class="hover:text-white transition-colors duration-200">
                {crumb.label}
              </a>
            )}
          </div>
        ))}
      </nav>
    </div>

    {/* HERO SECTION WITH CLEAN MODERN KITCHEN BACKGROUND */}
    <section class="relative z-10 pt-6 sm:pt-10 pb-12 sm:pb-16 border-b border-white/[0.06] overflow-hidden">
      {/* Background with clean modern kitchen interior and dark glass overlay */}
      <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
        <img
          src="/clean-kitchen-interior.jpg"
          alt="Modern hygienic kitchen interior background"
          data-image-component="true"
          loading="eager"
          class="w-full h-full object-cover object-center opacity-15 filter blur-[1px] scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-[#090a0c]/80 via-[#090a0c]/95 to-[#090a0c]"></div>
        <div class="absolute inset-0 slv-hex-bg opacity-[0.03]"></div>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl">
          {/* Category Tag */}
          <div class="inline-flex items-center gap-2 mb-4 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-md">
            <Bug class="w-3.5 h-3.5 text-[#E5A93C]" />
            <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase">
              Pest Library · Crawling Insects
            </span>
          </div>

          {/* Heading */}
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-4 font-heading leading-tight">
            Ants
            <span class="block text-transparent bg-clip-text bg-gradient-to-r from-[#FFE08A] via-[#F6C453] to-[#D99A18] text-xl sm:text-2xl md:text-3xl font-semibold mt-1">
              Identification, Habitats, Hygiene Risks & Targeted Control
            </span>
          </h1>

          {/* Concise Description */}
          <p class="text-zinc-300 text-sm sm:text-base leading-relaxed mb-6 font-normal max-w-3xl">
            A comprehensive scientific and practical guide to identifying ant species, locating concealed nesting chambers, preventing food contamination, and executing targeted non-repellent colony treatments in Bangalore residential and commercial properties.
          </p>

          {/* Quick-Navigation Highlights */}
          <div class="flex items-center flex-wrap gap-2 mb-8">
            <span class="text-xs text-zinc-400 font-semibold mr-1">Quick Jump:</span>
            <a
              href="#types-of-ants"
              class="px-3 py-1.5 rounded-full text-xs font-medium text-zinc-300 bg-white/[0.05] border border-white/[0.1] hover:text-[#F6C453] hover:border-[#E5A93C]/40 hover:bg-white/[0.08] transition-all"
            >
              Ant Types
            </a>
            <a
              href="#where-they-hide"
              class="px-3 py-1.5 rounded-full text-xs font-medium text-zinc-300 bg-white/[0.05] border border-white/[0.1] hover:text-[#F6C453] hover:border-[#E5A93C]/40 hover:bg-white/[0.08] transition-all"
            >
              Hiding Places
            </a>
            <a
              href="#risks-problems"
              class="px-3 py-1.5 rounded-full text-xs font-medium text-zinc-300 bg-white/[0.05] border border-white/[0.1] hover:text-[#F6C453] hover:border-[#E5A93C]/40 hover:bg-white/[0.08] transition-all"
            >
              Risks
            </a>
            <a
              href="#prevention-tips"
              class="px-3 py-1.5 rounded-full text-xs font-medium text-zinc-300 bg-white/[0.05] border border-white/[0.1] hover:text-[#F6C453] hover:border-[#E5A93C]/40 hover:bg-white/[0.08] transition-all"
            >
              Prevention
            </a>
            <a
              href="#treatment-options"
              class="px-3 py-1.5 rounded-full text-xs font-medium text-zinc-300 bg-white/[0.05] border border-white/[0.1] hover:text-[#F6C453] hover:border-[#E5A93C]/40 hover:bg-white/[0.08] transition-all"
            >
              Treatment
            </a>
          </div>
        </div>

        {/* GLASS-EFFECT QUICK INFORMATION PANEL */}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
          {quickStats.map((stat) => {
            const Icon = stat.icon;
            return (
              <div class="slv-card rounded-2xl p-4 sm:p-5 border border-white/[0.08] bg-[#0e1014]/80 backdrop-blur-md relative overflow-hidden group hover:border-[#E5A93C]/30 transition-all duration-300">
                <div class="flex items-center gap-3 mb-2">
                  <div class="w-8 h-8 rounded-lg bg-amber-500/10 border border-amber-500/20 text-[#E5A93C] flex items-center justify-center shrink-0">
                    <Icon class="w-4 h-4" />
                  </div>
                  <span class="text-[11px] uppercase tracking-wider text-zinc-400 font-semibold">{stat.label}</span>
                </div>
                <div class="text-base font-bold text-white mb-1 group-hover:text-[#F6C453] transition-colors">{stat.value}</div>
                <div class="text-xs text-zinc-400 leading-relaxed">{stat.detail}</div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* RESPONSIVE STICKY SECTION NAVIGATION BAR */}
    <nav
      aria-label="Section Navigation"
      class="sticky top-[68px] sm:top-[76px] z-30 bg-[#090a0c]/92 backdrop-blur-xl border-b border-white/[0.08] shadow-[0_10px_30px_rgba(0,0,0,0.5)]"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-1 sm:gap-2 overflow-x-auto py-3 no-scrollbar scroll-smooth">
          {navSections.map((sec) => (
            <a
              href={`#${sec.id}`}
              class="px-3.5 py-1.5 rounded-lg text-xs font-semibold text-zinc-300 hover:text-white hover:bg-white/[0.06] whitespace-nowrap transition-colors border border-transparent hover:border-white/[0.08] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#E5A93C]"
            >
              {sec.label}
            </a>
          ))}
        </div>
      </div>
    </nav>

    {/* MAIN CONTENT AREA WITH 2-COLUMN LAYOUT (EDUCATIONAL SECTIONS + RIGHT SIDEBAR) */}
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
      <div class="lg:grid lg:grid-cols-12 lg:gap-10 items-start">
        {/* LEFT / PRIMARY EDUCATIONAL CONTENT COLUMN (8 COLS) */}
        <div class="lg:col-span-8 space-y-14 sm:space-y-18">
          {/* 1. OVERVIEW */}
          <section id="overview" class="scroll-mt-36">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs font-bold text-[#E5A93C] tracking-wider uppercase">Section 01</span>
              <span class="text-zinc-600">·</span>
              <span class="text-xs text-zinc-400">Biological Insights</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mb-4 font-heading">
              Overview: Understanding Ant Colony Behavior
            </h2>
            <div class="prose prose-invert max-w-none text-zinc-300 text-sm sm:text-base leading-relaxed space-y-4">
              <p>
                Ants belong to the insect family <em class="text-zinc-200">Formicidae</em> and are among the most persistent eusocial organisms on Earth. Inside homes and commercial properties, they operate in tightly organized social castes comprised of one or more reproductive queens, specialized soldiers, and countless sterile worker ants that forage continuously.
              </p>
              <p>
                Unlike solitary insects, ants communicate through chemical compounds called <strong class="text-white">hydrocarbon trail pheromones</strong>. When an individual scout discovers a microscopic drop of syrup or an unsealed grain of rice, it deposits a scent path on its return journey. This path alerts and directs hundreds of nestmates along an uninterrupted highway across kitchen tiles, splashbacks, and interior wall voids.
              </p>
              <div class="p-4 sm:p-5 rounded-2xl bg-white/[0.03] border border-white/[0.08] backdrop-blur-sm mt-4">
                <h3 class="text-sm font-bold text-white mb-2 flex items-center gap-2">
                  <Search class="w-4 h-4 text-[#E5A93C]" />
                  Why Early Identification Matters
                </h3>
                <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed mb-3">
                  Eliminating an ant infestation requires addressing the hidden queen inside the primary nesting chamber. Simply crushing visible foragers or spraying over-the-counter surface aerosols often scatters the colony into defensive satellite buddings, rapidly multiplying the number of active harborages.
                </p>
                <div class="flex items-center flex-wrap gap-3 pt-2 border-t border-white/[0.06] text-xs">
                  <a href="/knowledge/ants/identification" class="text-[#F6C453] hover:underline font-semibold inline-flex items-center gap-1">
                    Read Diagnostic Identification Guide <ArrowRight class="w-3.5 h-3.5" />
                  </a>
                  <span class="text-zinc-600">·</span>
                  <a href="/knowledge/ants/how-they-spread" class="text-zinc-300 hover:text-white font-medium inline-flex items-center gap-1">
                    How Ants Spread Across Buildings <ArrowRight class="w-3.5 h-3.5" />
                  </a>
                </div>
              </div>
            </div>
          </section>

          {/* 2. TYPES OF ANTS */}
          <section id="types-of-ants" class="scroll-mt-36">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs font-bold text-[#E5A93C] tracking-wider uppercase">Section 02</span>
              <span class="text-zinc-600">·</span>
              <span class="text-xs text-zinc-400">Species Differentiation</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mb-3 font-heading">
              Common Types of Ants
            </h2>
            <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed mb-6">
              Identifying the specific ant species infesting a property is critical: bait preferences, foraging radius, and sensitivity to treatments vary drastically by species.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {antSpecies.map((species) => (
                <div class="slv-card rounded-2xl p-5 border border-white/[0.08] bg-[#0e1014]/90 backdrop-blur-md relative overflow-hidden flex flex-col justify-between group hover:border-[#E5A93C]/40 transition-all duration-300">
                  <div>
