---
import Layout from '../../layouts/Layout.astro';
import { Header } from '../../components/Header';
import { Footer } from '../../components/Footer';
import { FloatingActions } from '../../components/FloatingActions';
import { ContactForm } from '../../components/ContactForm';
import ServiceAreasSection from '../../components/ServiceAreasSection.astro';
import {
  ShieldAlert,
  ShieldCheck,
  CheckCircle2,
  AlertTriangle,
  Search,
  Phone,
  MessageCircle,
  Mail,
  ArrowRight,
  MapPin,
  HelpCircle,
  Activity,
  BookOpen,
  Layers,
  Sparkles,
  Droplets,
  FileText
} from 'lucide-react';

const signs = [
  {
    title: 'Visible Worker Ants & Trails',
    desc: 'Lines of ants marching along baseboards, countertops, tiles, and window sills following invisible chemical pheromone pathways.',
    icon: Activity
  },
  {
    title: 'Activity Around Food & Sugars',
    desc: 'Rapid swarms around spilled sugars, open pet food bowls, unsealed cereal containers, and sweet fruits left on counters.',
    icon: Search
  },
  {
    title: 'Moisture & Water Attraction',
    desc: 'Concentrations near leaky faucets, under-sink plumbing pipes, bathroom drains, and refrigerator condensation pans.',
    icon: Droplets
  },
  {
    title: 'Nesting Dirt & Frass Piles',
    desc: 'Small piles of fine debris, soil particles, or frass ejected near baseboards, wall crevices, brick voids, or patio pavers.',
    icon: AlertTriangle
  }
];

const processStages = [
  {
    step: '01',
    title: 'Inspection',
    desc: 'Identify ant activity, likely harbourage and environmental conditions across kitchens, bathrooms, wall gaps, and entry points.'
  },
  {
    step: '02',
    title: 'Assessment',
    desc: 'Determine the appropriate management approach based on inspection findings and property conditions.'
  },
  {
    step: '03',
    title: 'Targeted Treatment',
    desc: 'Apply an appropriate treatment method to suitable areas based on the inspection, using targeted baiting and barrier methods.'
  },
  {
    step: '04',
    title: 'Follow-up & Prevention Guidance',
    desc: 'Provide monitoring and practical prevention recommendations to stop ants from re-entering your space.'
  }
];

const antKnowledgeCards = [
  {
    title: 'Ant Identification',
    desc: 'Recognize common ant behaviors, signs of infestation, trailing activity, and food attraction.',
    href: '/knowledge/ants/identification'
  },
  {
    title: 'Where Ants Hide & Nest',
    desc: 'Discover nesting zones in cracks, wall voids, under sinks, kitchen cupboards, and outdoor perimeters.',
    href: '/knowledge/ants/where-they-hide'
  },
  {
    title: 'How Ants Enter & Spread',
    desc: 'Understand entry through exterior gaps, utility penetrations, foraging trails, and scent-guided expansion.',
    href: '/knowledge/ants/how-they-spread'
  },
  {
    title: 'Ant Prevention Guide',
    desc: 'Proven sanitation steps, food storage habits, moisture control, and structural sealing techniques.',
    href: '/knowledge/ants/prevention'
  },
  {
    title: 'Ant Treatment Guide',
    desc: 'Comprehensive 4-stage management methodology: inspection, colony assessment, targeted baiting, and prevention.',
    href: '/knowledge/ants/treatment-guide'
  },
  {
    title: 'Ant FAQs',
    desc: '12 factual answers addressing ant species, nesting habits, sprays vs baits, safety, and recurrence.',
    href: '/knowledge/ants/faq'
  }
];

const faqs = [
  {
    q: 'Why do ants keep returning to my kitchen?',
    a: 'Ants communicate through persistent pheromone scent trails. When scout ants discover food particles, grease, or moisture, they lay down chemical trails that recruit thousands of nestmates. Simply wiping the surface often leaves scent trails intact or ignores hidden colonies inside wall voids.'
  },
  {
    q: 'How much does ant control cost in Bangalore?',
    a: 'Ant control at SLV Pest Control starts from ₹499. The exact cost depends on property dimensions (1 BHK, 2 BHK, 3 BHK, villa, or commercial pantry), colony extent, and whether outdoor nesting perimeters require barrier management.'
  },
  {
    q: 'Why do store-bought sprays fail to eliminate ants?',
    a: 'Aerosol sprays only kill the small percentage of foraging worker ants on the surface. Sprays can cause colony "budding", prompting the queen to fragment the colony into multiple new nesting sites inside your walls.'
  },
  {
    q: 'How does SLV Pest Control treat ant infestations?',
    a: 'We implement a systematic 4-stage Integrated Pest Management protocol: thorough nesting inspection, colony assessment, targeted professional gel baiting that foraging workers carry back to eliminate the queen and nest, supplemented by perimeter barrier applications where appropriate.'
  }
];
---

<Layout
  title="Ant Control in Bangalore | Starting at ₹499 | SLV Pest Control"
  description="Stop ants at the source with professional Ant Control in Bangalore. Starting at ₹499. Targeted treatment for kitchens, wall voids, and entry points. Call 91803 97822."
  canonical="https://slvpestcontrol.com/services/ant-control"
>
  <Header client:load activeItem="services" />

  <main class="flex-1 w-full relative overflow-hidden bg-[#090a0c]">
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 right-1/4 w-[500px] h-[500px] bg-[#E5A93C]/[0.06] rounded-full blur-[140px]"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-zinc-400">
        <a href="/" class="hover:text-white transition">Home</a>
        <span>/</span>
        <a href="/#services" class="hover:text-white transition">Services</a>
        <span>/</span>
        <span class="text-[#F6C453] font-semibold">Ant Control</span>
      </nav>
    </div>

    {/* HERO */}
    <section class="relative z-10 pt-10 sm:pt-14 lg:pt-18 pb-14 sm:pb-18 border-b border-white/[0.06]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-4xl mx-auto">
        <div class="inline-flex items-center gap-2 mb-5 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-[#E5A93C] animate-pulse"></span>
          <span class="text-[#E5A93C] text-xs font-extrabold tracking-[0.25em] uppercase">
            ANT CONTROL
          </span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-7xl font-black text-white tracking-tight leading-[1.08] mb-5 font-heading">
          Ant Control in <span class="slv-gold-text">Bangalore</span>
        </h1>

        <p class="text-xl sm:text-2xl font-bold text-white mb-6 font-heading tracking-tight">
          Stop ants at the source
        </p>

        <p class="text-zinc-300 text-base sm:text-lg leading-relaxed max-w-3xl mx-auto mb-8">
          Ants enter Bangalore properties searching for food, sweets, and moisture, establishing scent trails and concealed nests inside wall cavities and cupboards. SLV Pest Control delivers targeted colony management and perimeter protection across Bangalore.
        </p>

        <div class="inline-flex items-center gap-4 px-4 py-2 rounded-2xl bg-white/[0.03] border border-white/[0.08] mb-8 text-xs sm:text-sm font-semibold">
          <span class="text-[#F6C453] font-bold">STARTING AT ₹499</span>
          <span class="text-zinc-600">|</span>
          <span class="text-white">Kitchens, Cupboards &amp; Wall Voids</span>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 sm:gap-4">
          <a href="/contact" class="slv-btn-primary w-full sm:w-auto px-8 py-3.5 text-xs sm:text-sm font-black gap-2 uppercase tracking-wider">
            <span>Get Free Inspection</span>
            <ArrowRight class="w-4 h-4" />
          </a>
          <a href="tel:9180397822" class="slv-btn-secondary w-full sm:w-auto px-7 py-3.5 text-xs sm:text-sm font-bold gap-2 uppercase tracking-wider hover:border-[#F6C453]">
            <Phone class="w-4 h-4 text-[#F6C453]" />
            <span>Call Now</span>
          </a>
          <a href="https://wa.me/9180397822" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto px-6 py-3.5 text-xs sm:text-sm font-bold gap-2 uppercase tracking-wider rounded-full bg-[#25D366] text-white shadow-md inline-flex items-center justify-center">
            <MessageCircle class="w-4 h-4 text-white" />
            <span>WhatsApp</span>
          </a>
        </div>
      </div>
    </section>

    {/* SIGNS */}
    <section class="relative z-10 py-16 sm:py-20 border-b border-white/[0.06] bg-[#0c0d10]/50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-2">IDENTIFICATION</span>
          <h2 class="text-3xl sm:text-4xl font-black text-white font-heading">Signs of Ant Infestation</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {signs.map((sign) => {
            const Icon = sign.icon;
            return (
              <div class="slv-card rounded-2xl p-6 border border-white/[0.08]">
                <Icon class="w-6 h-6 text-[#E5A93C] mb-3" />
                <h3 class="text-base font-bold text-white mb-2">{sign.title}</h3>
                <p class="text-zinc-400 text-xs leading-relaxed">{sign.desc}</p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* PROCESS */}
    <section class="relative z-10 py-16 sm:py-20 border-b border-white/[0.06]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-2">PROCESS</span>
          <h2 class="text-3xl sm:text-4xl font-black text-white font-heading">How SLV Treats Ants</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {processStages.map((stage) => (
            <div class="slv-card rounded-2xl p-6 border border-white/[0.08]">
              <span class="text-3xl font-black font-heading slv-gold-text mb-3 block">{stage.step}</span>
              <h3 class="text-base font-bold text-white mb-2">{stage.title}</h3>
              <p class="text-zinc-400 text-xs leading-relaxed">{stage.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* PRICING */}
    <section class="relative z-10 py-16 sm:py-20 border-b border-white/[0.06] bg-[#0c0d10]/50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="slv-card rounded-3xl p-8 sm:p-12 border border-[#E5A93C]/40">
          <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-2">ASSESSMENT PRICING</span>
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading mb-4">ANT CONTROL</h2>
          <div class="my-5">
            <span class="text-3xl sm:text-4xl font-black text-[#F6C453] uppercase tracking-wider">STARTING AT ₹499</span>
          </div>
          <p class="text-zinc-400 text-xs sm:text-sm max-w-md mx-auto mb-6">
            Treatment scope depends on the level of infestation, species involved, number of affected rooms, kitchens, and outdoor nesting conditions.
          </p>
          <a href="/contact" class="slv-btn-primary px-8 py-3.5 text-xs sm:text-sm font-bold uppercase tracking-wider inline-flex items-center gap-2">
            <span>Get Free Inspection</span>
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>
    </section>

    {/* LEARN MORE ABOUT ANTS */}
    <section class="relative z-10 py-16 sm:py-20 border-b border-white/[0.06] bg-[#0c0d10]/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <div class="inline-flex items-center gap-2 mb-3">
            <BookOpen class="w-4 h-4 text-[#E5A93C]" />
            <span class="text-[#E5A93C] text-xs font-bold tracking-[0.25em] uppercase">
              EDUCATIONAL GUIDES
            </span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-black text-white font-heading">
            LEARN MORE ABOUT ANTS
          </h2>
          <p class="text-zinc-400 text-sm mt-3">
            Explore our comprehensive knowledge resources on ant identification, nesting habitats, spread pathways, prevention, and professional colony management.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {antKnowledgeCards.map((card) => (
            <div class="slv-card rounded-2xl p-6 border border-white/[0.08] hover:border-[#E5A93C]/50 transition-all flex flex-col justify-between group">
              <div>
                <span class="text-xs font-bold text-[#F6C453] uppercase tracking-wider block mb-2 font-mono">
                  Ant Guide
                </span>
                <h3 class="text-lg font-bold text-white group-hover:text-[#F6C453] transition mb-2 font-heading">
                  {card.title}
                </h3>
                <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed mb-6">
                  {card.desc}
                </p>
              </div>

              <a
                href={card.href}
                class="pt-3 border-t border-white/[0.06] text-xs font-bold text-[#FFE08A] hover:text-white flex items-center justify-between transition"
              >
                <span>Read Full Article</span>
                <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform text-[#E5A93C]" />
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* FAQS */}
    <section class="relative z-10 py-16 sm:py-20 border-b border-white/[0.06]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
          <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block mb-2">FAQS</span>
          <h2 class="text-3xl sm:text-4xl font-black text-white font-heading">Frequently Asked Questions</h2>
        </div>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="slv-card rounded-2xl p-6 border border-white/[0.08]">
              <h3 class="text-base font-bold text-white mb-2">{faq.q}</h3>
              <p class="text-zinc-300 text-xs sm:text-sm leading-relaxed">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* BANGALORE SERVICE AREAS */}
    <ServiceAreasSection />

    {/* CONTACT FORM */}
    <section class="relative z-10 py-16 sm:py-20 border-b border-white/[0.06] bg-[#0c0d10]/50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
          <div class="lg:col-span-5 space-y-5">
            <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase block">CONTACT US</span>
            <h2 class="text-3xl font-black text-white font-heading">Schedule Ant Assessment</h2>
            <p class="text-zinc-300 text-sm leading-relaxed">
              Contact SLV Pest Control for professional ant inspection and colony treatment across Bangalore.
            </p>
            <div class="slv-card rounded-2xl p-5 border border-white/[0.08] space-y-3 text-xs">
              <div class="flex items-center gap-2">
                <MapPin class="w-4 h-4 text-[#E5A93C]" />
                <span>143 Soundarya Layout, Doddabidarakallu, Bangalore 560073</span>
              </div>
              <div class="flex items-center gap-2">
                <Phone class="w-4 h-4 text-[#E5A93C]" />
                <a href="tel:9180397822" class="font-bold text-white font-mono hover:text-[#FFE08A]">91803 97822</a>
              </div>
              <div class="flex items-center gap-2">
                <Mail class="w-4 h-4 text-[#E5A93C]" />
                <a href="mailto:contact@slvpestcontrol.com" class="text-white hover:text-[#FFE08A]">contact@slvpestcontrol.com</a>
              </div>
            </div>
          </div>
          <div class="lg:col-span-7">
            <ContactForm client:load />
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingActions client:load />
</Layout>
