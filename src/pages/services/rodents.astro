---
import Layout from '../../layouts/Layout.astro';
import { Header } from '../../components/Header';
import { Footer } from '../../components/Footer';
import { FloatingActions } from '../../components/FloatingActions';
import { ContactForm } from '../../components/ContactForm';
import ServiceAreasSection from '../../components/ServiceAreasSection.astro';
import {
  Shield,
  ShieldCheck,
  CheckCircle2,
  AlertTriangle,
  Search,
  Phone,
  MessageCircle,
  Mail,
  ArrowRight,
  MapPin,
  HelpCircle,
  Eye,
  Activity,
  Layers,
  Wrench,
  Building,
  Home,
  DoorOpen,
  Volume2,
  Package,
  Trash2,
  Compass,
  Lock
} from 'lucide-react';

const signs = [
  {
    title: 'Rodent Droppings',
    desc: 'Dark spindle-shaped droppings along kitchen baseboards, under sinks, inside pantries, and above false ceiling panels.',
    icon: Activity
  },
  {
    title: 'Gnaw Marks & Wire Damage',
    desc: 'Visible tooth marks on wooden trims, food packaging, plastic pipes, and stripped electrical or broadband wiring.',
    icon: AlertTriangle
  },
  {
    title: 'Scratching Sounds at Night',
    desc: 'Nocturnal scuttling, squeaking, and scratching noises inside false ceilings, wall cavities, or behind heavy cupboards.',
    icon: Volume2
  },
  {
    title: 'Grease Rub Marks (Smear Marks)',
    desc: 'Dark oily smudge marks left along walls, pipes, and skirting boards where rodents repeatedly brush their sebum-coated fur.',
    icon: Search
  }
];

const harbourageAreas = [
  { name: 'Kitchens & Pantries', desc: 'Spaces beneath sinks, cabinet kicks, and pantry shelves with access to food crumbs' },
  { name: 'Behind Appliances', desc: 'Warm compressor compartments behind refrigerators, stoves, and washing machines' },
  { name: 'Roof & False Ceilings', desc: 'Suspended ceiling grid voids, attic insulation, and duct raceways favored by roof rats' },
  { name: 'Internal Wall Cavities', desc: 'Hollow spaces between drywall sheets and vertical plumbing shafts connecting floors' },
  { name: 'Garages & Basements', desc: 'Stored tyres, garden equipment, tool boxes, and vehicle engine bays' },
  { name: 'Utility Rooms & Chases', desc: 'Water heater closets, electrical conduit sleeves, and laundry drainage junctions' }
];

const fourStageProcess = [
  {
    step: '01',
    title: 'Inspection',
    description: 'Identify signs, activity areas, harbourage and possible entry points.',
    detail: 'Our certified technicians conduct a meticulous structural survey to locate droppings, gnaw damage, active runways, concealed harbourage voids, and perimeter entry gaps.',
    icon: Search
  },
  {
    step: '02',
    title: 'Assessment',
    description: 'Determine the appropriate management approach based on the property and inspection findings.',
    detail: 'Because every property is unique, we assess whether roof rats, Norway rats, or mice are present, evaluate environmental attractants, and calibrate a safe, targeted protocol.',
    icon: Compass
  },
  {
    step: '03',
    title: 'Targeted Management',
    description: 'Apply suitable control measures to identified activity and access areas.',
    detail: 'Deploying tamper-resistant locked bait stations along verified perimeter runways, paired with mechanical snap traps and multi-catch stations placed away from food-contact surfaces.',
    icon: Lock
  },
  {
    step: '04',
    title: 'Monitoring & Prevention',
    description: 'Monitor activity and provide practical recommendations to reduce future access and harbourage.',
    detail: 'Scheduled follow-up inspections track station takes, evaluate population suppression, and provide property owners with actionable advice on structural gap sealing and food sanitation.',
    icon: ShieldCheck
  }
];

const propertiesWeTreat = [
  'Homes, Villas & Row Houses',
  'Apartments & Gated Societies',
  'Commercial Offices & Tech Parks',
  'Restaurants, Cafes & Cloud Kitchens',
  'Warehouses & Logistics Hubs',
  'Retail Outlets & Supermarkets',
  'Educational Campuses & Hostels',
  'Industrial & Manufacturing Plants'
];

const serviceZones = [
  { title: 'NORTH BANGALORE', areas: 'Yelahanka, Hebbal, RT Nagar, Sahakar Nagar and surrounding sectors' },
  { title: 'EAST BANGALORE', areas: 'Whitefield, Indiranagar, Marathahalli, KR Puram and surrounding sectors' },
  { title: 'WEST BANGALORE', areas: 'Nagasandra, Yeshwanthpur, Rajajinagar, Basaveshwaranagar, Andarahalli' },
  { title: 'SOUTH BANGALORE', areas: 'Jayanagar, JP Nagar, BTM Layout, Koramangala, Electronic City' },
  { title: 'CENTRAL BANGALORE', areas: 'Malleshwaram, MG Road, Richmond Town, Shanthi Nagar and central corridors' },
  { title: 'OUTER BANGALORE', areas: 'Sarjapur Road, Devanahalli, Kanakapura Road and extended industrial zones' }
];

const knowledgeArticles = [
  {
    title: 'Rodent Identification',
    desc: 'Signs of activity: droppings, gnaw marks, scratching sounds, nesting material, and unusual odours.',
    href: '/knowledge/rodents/identification'
  },
  {
    title: 'Where Rodents Hide',
    desc: 'Kitchens, storage areas, behind appliances, roof and ceiling spaces, and wall cavities.',
    href: '/knowledge/rodents/where-they-hide'
  },
  {
    title: 'How Rodents Enter & Spread',
    desc: 'Structural gaps and cracks, doors, utility openings, drainage lines, and food waste areas.',
    href: '/knowledge/rodents/how-they-spread'
  },
  {
    title: 'Rodent Prevention',
    desc: 'Secure food storage, waste sanitation, clutter reduction, physical sealing, and moisture repair.',
    href: '/knowledge/rodents/prevention'
  },
  {
    title: 'Rodent Management Guide',
    desc: 'The 4-stage management workflow: inspection, assessment, targeted control, and monitoring.',
    href: '/knowledge/rodents/treatment-guide'
  },
  {
    title: 'Rodent FAQ',
    desc: 'Clear, factual answers to 12 questions on costs, preparation, hiding habits, and commercial care.',
    href: '/knowledge/rodents/faq'
  }
];

const faqs = [
  {
    q: 'How do I know if I have rodents on my property?',
    a: 'Common indicators include dark spindle-shaped droppings along baseboards or under sinks, chewed food packaging, gnawed electrical cables, nocturnal scratching sounds inside ceilings or walls, and grease smear marks along regular runways.'
  },
  {
    q: 'How much does rodent management cost in Bangalore?',
    a: 'Rodent management at SLV Pest Control starts from ₹699. Final pricing is calculated based on property square footage, structural layout, number of required tamper-resistant bait stations or mechanical traps, and the severity of active infestation.'
  },
  {
    q: 'Are your rodent bait stations safe around children and pets?',
    a: 'Yes. All rodent control formulations deployed by SLV Pest Control are secured within heavy-duty, tamper-resistant locked bait stations. These stations can only be opened with a specialized technician key, preventing curious children or domestic pets from accessing the contents.'
  },
  {
    q: 'Can rodents chew through electrical wiring and cause fire hazards?',
    a: 'Yes. Rodents must continually gnaw on hard materials to grind down their continuously growing incisor teeth. Stripped electrical wiring inside false ceilings and electrical conduit ducts represents a verified short-circuit and fire risk.'
  },
  {
    q: 'Can rodent control guarantee that rodents will never return?',
    a: 'Wild rodents inhabit surrounding urban environments, drains, and open plots across Bangalore. While no service can prevent outdoor wild rodents from attempting re-entry, professional targeted management combined with ongoing structural exclusion provides effective, sustainable control.'
  },
  {
    q: 'Do you treat commercial food establishments and warehouses?',
    a: 'Yes. We provide comprehensive rodent management for restaurants, cloud kitchens, retail grocery stores, IT parks, and logistics warehouses across Bangalore, complete with station location mapping and service documentation.'
  }
];
---

<Layout
  title="Rodent Management in Bangalore | Starting at ₹699 | SLV Pest Control"
  description="Professional rodent management in Bangalore. Stop damage, stay safe with tamper-resistant bait stations and mechanical exclusion. Starting at ₹699. Call 91803 97822."
  canonical="https://slvpestcontrol.com/services/rodent-control"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Service",
          "@id": "https://slvpestcontrol.com/services/rodent-control#service",
          "name": "Rodent Management in Bangalore",
          "serviceType": "Rodent Pest Control Service",
          "description": "Professional rodent management in Bangalore providing tamper-resistant bait stations, mechanical trapping, runway tracking, and physical exclusion advice.",
          "provider": {
            "@type": "LocalBusiness",
            "name": "SLV Pest Control",
            "telephone": "+91-9180397822",
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "143 Soundarya Layout, Doddabidarakallu",
              "addressLocality": "Bengaluru",
              "addressRegion": "Karnataka",
              "postalCode": "560073",
              "addressCountry": "IN"
            }
          },
          "areaServed": {
            "@type": "City",
            "name": "Bengaluru"
          },
          "offers": {
            "@type": "Offer",
            "priceSpecification": {
              "@type": "PriceSpecification",
              "priceCurrency": "INR",
              "description": "Pricing determined after property inspection"
            }
          }
        },
        {
          "@type": "FAQPage",
          "@id": "https://slvpestcontrol.com/services/rodent-control#faq",
          "mainEntity": faqs.map((faq) => ({
            "@type": "Question",
            "name": faq.q,
            "acceptedAnswer": {
              "@type": "Answer",
              "text": faq.a
            }
          }))
        }
      ]
    })} />
  </Fragment>

  <Header client:load activeItem="rodents" />

  <main class="flex-1 w-full relative overflow-hidden bg-[#090a0c]">
    {/* Background glow effects */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 right-1/4 w-[500px] h-[500px] bg-[#E5A93C]/[0.06] rounded-full blur-[140px]"></div>
      <div class="absolute top-[35%] left-[-100px] w-[500px] h-[500px] bg-[#E5A93C]/[0.04] rounded-full blur-[160px]"></div>
    </div>

    {/* Breadcrumbs */}
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-zinc-400">
        <a href="/" class="hover:text-white transition">Home</a>
        <span>/</span>
        <a href="/#services" class="hover:text-white transition">Services</a>
        <span>/</span>
        <span class="text-[#F6C453] font-semibold">Rodent Management</span>
      </nav>
    </div>

    {/* HERO */}
    <section class="relative z-10 pt-10 sm:pt-14 lg:pt-18 pb-14 sm:pb-18 border-b border-white/[0.06]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-4xl mx-auto">
        <div class="inline-flex items-center gap-2 mb-5 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-[#E5A93C] animate-pulse"></span>
          <span class="text-[#E5A93C] text-xs font-extrabold tracking-[0.25em] uppercase">
            RODENT MANAGEMENT IN BANGALORE
          </span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-7xl font-black text-white tracking-tight leading-[1.08] mb-5 font-heading">
          Rodent Management in <span class="slv-gold-text">Bangalore</span>
        </h1>

        <p class="text-xl sm:text-2xl font-bold text-white mb-6 font-heading tracking-tight">
          Stop damage, stay safe
        </p>

        <p class="text-zinc-300 text-base sm:text-lg leading-relaxed max-w-3xl mx-auto mb-8 font-normal">
          SLV Pest Control delivers strategic rodent management across Bangalore. Combining thorough structural inspections, child- and pet-safe tamper-resistant locked bait stations, and physical exclusion guidance, we protect homes, apartments, restaurants, and warehouses from costly rodent damage and contamination.
        </p>

        {/* Badges */}
        <div class="inline-flex flex-wrap items-center justify-center gap-3 sm:gap-6 px-5 py-2.5 rounded-2xl bg-white/[0.03] border border-white/[0.08] mb-8 text-xs sm:text-sm font-semibold">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-[#E5A93C]"></span>
            <span class="text-[#F6C453] font-black tracking-wide">STARTING AT ₹699</span>
          </div>
          <span class="text-zinc-600 hidden sm:inline">|</span>
          <div class="flex items-center gap-2">
            <Lock class="w-4 h-4 text-[#E5A93C]" />
            <span class="text-white">Tamper-Resistant Stations</span>
          </div>
          <span class="text-zinc-600 hidden sm:inline">|</span>
          <div class="flex items-center gap-2">
            <ShieldCheck class="w-4 h-4 text-[#E5A93C]" />
            <span class="text-white">Structural Exclusion Guidance</span>
          </div>
        </div>

        {/* CTAs */}
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 sm:gap-4">
          <a
            href="/contact"
            class="slv-btn-primary w-full sm:w-auto px-8 py-3.5 text-xs sm:text-sm font-black gap-2 uppercase tracking-wider"
          >
            <span>Get Free Inspection</span>
            <ArrowRight class="w-4 h-4" />
          </a>
          <a
            href="tel:9180397822"
            class="slv-btn-secondary w-full sm:w-auto px-7 py-3.5 text-xs sm:text-sm font-bold gap-2 uppercase tracking-wider hover:border-[#F6C453]"
          >
            <Phone class="w-4 h-4 text-[#F6C453]" />
            <span>Call Now</span>
          </a>
          <a
            href="https://wa.me/9180397822"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-6 py-3.5 text-xs sm:text-sm font-bold gap-2 uppercase tracking-wider rounded-full bg-[#25D366] text-white shadow-md hover:bg-[#20bd5a] transition inline-flex items-center justify-center"
          >
            <MessageCircle class="w-4 h-4 text-white" />
            <span>WhatsApp</span>
          </a>
        </div>
      </div>
    </section>

    {/* WHY RODENTS ARE A PROBLEM */}
    <section class="relative z-10 py-16 sm:py-20 border-b border-white/[0.06] bg-[#0c0d10]/50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          <div class="lg:col-span-6 space-y-5">
            <div class="inline-flex items-center gap-2">
              <span class="w-6 h-[1.5px] bg-[#E5A93C]"></span>
              <span class="text-[#E5A93C] text-xs font-bold tracking-[0.25em] uppercase">
                DAMAGE &amp; CONTAMINATION
              </span>
            </div>
            <h2 class="text-3xl sm:text-4xl font-black text-white font-heading tracking-tight leading-tight">
              Why Rodents Threaten Property &amp; Health
            </h2>
            <p class="text-zinc-300 text-sm sm:text-base leading-relaxed">
              Rodents are destructive pests capable of causing severe structural and economic harm. Their continuous gnawing habit can compromise electrical wiring inside false ceilings, gnaw through plumbing pipes, and destroy valuable food stores.
            </p>
            <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed">
              Furthermore, rats and mice carry pathogens and leave behind urine trails and droppings that contaminate food preparation surfaces. Overcoming a rodent infestation requires an integrated approach that combines targeted bait stations, mechanical trapping, and physical sealing of structural gaps.
            </p>
          </div>

          <div class="lg:col-span-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="slv-card rounded-2xl p-5 border border-white/[0.08]">
              <AlertTriangle class="w-6 h-6 text-[#E5A93C] mb-3" />
              <h3 class="text-base font-bold text-white mb-2 font-heading">Electrical Fire Hazard</h3>
              <p class="text-zinc-400 text-xs leading-relaxed">
                Rodents gnaw on wiring insulation inside false ceilings and electrical conduits, creating serious short-circuit risks.
              </p>
            </div>
            <div class="slv-card rounded-2xl p-5 border border-white/[0.08]">
              <Package class="w-6 h-6 text-[#E5A93C] mb-3" />
              <h3 class="text-base font-bold text-white mb-2 font-heading">Food Contamination</h3>
              <p class="text-zinc-400 text-xs leading-relaxed">
                Droppings, urine, and body oils contaminate pantry dry goods and food preparation counters.
              </p>
            </div>
            <div class="slv-card rounded-2xl p-5 border border-white/[0.08]">
              <Building class="w-6 h-6 text-[#E5A93C] mb-3" />
              <h3 class="text-base font-bold text-white mb-2 font-heading">Structural Degradation</h3>
              <p class="text-zinc-400 text-xs leading-relaxed">
                Burrowing beneath foundations and chewing through PVC pipes and drywall weakens building structures.
              </p>
            </div>
            <div class="slv-card rounded-2xl p-5 border border-white/[0.08]">
              <Lock class="w-6 h-6 text-[#E5A93C] mb-3" />
              <h3 class="text-base font-bold text-white mb-2 font-heading">Child &amp; Pet Safety</h3>
              <p class="text-zinc-400 text-xs leading-relaxed">
                Our locked, tamper-resistant bait stations ensure control formulations are completely inaccessible to children and pets.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* COMMON SIGNS */}
    <section class="relative z-10 py-16 sm:py-20 border-b border-white/[0.06]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <div class="inline-flex items-center gap-2 mb-3">
            <span class="w-6 h-[1.5px] bg-[#E5A93C]"></span>
            <span class="text-[#E5A93C] text-xs font-bold tracking-[0.25em] uppercase">
              IDENTIFICATION SIGNS
            </span>
            <span class="w-6 h-[1.5px] bg-[#E5A93C]"></span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-black text-white font-heading">
            Common Signs of Rodent Activity
          </h2>
          <p class="text-zinc-400 text-sm mt-3">
            Early detection helps contain rodents before colonies multiply and spread across building voids.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {signs.map((sign) => {
            const Icon = sign.icon;
            return (
              <div class="slv-card rounded-2xl p-6 border border-white/[0.08] hover:border-[#E5A93C]/40 transition flex flex-col justify-between">
                <div>
                  <div class="w-12 h-12 rounded-xl bg-[#E5A93C]/10 border border-[#E5A93C]/20 flex items-center justify-center mb-4">
                    <Icon class="w-6 h-6 text-[#E5A93C]" />
                  </div>
                  <h3 class="text-base font-bold text-white mb-2 font-heading">
                    {sign.title}
                  </h3>
                  <p class="text-zinc-400 text-xs leading-relaxed">
                    {sign.desc}
                  </p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* WHERE RODENTS HIDE */}
    <section class="relative z-10 py-16 sm:py-20 border-b border-white/[0.06] bg-[#0c0d10]/50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <div class="inline-flex items-center gap-2 mb-3">
            <span class="w-6 h-[1.5px] bg-[#E5A93C]"></span>
            <span class="text-[#E5A93C] text-xs font-bold tracking-[0.25em] uppercase">
              HARBOURAGE LOCATIONS
            </span>
            <span class="w-6 h-[1.5px] bg-[#E5A93C]"></span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-black text-white font-heading">
            Where Rodents Hide Inside Properties
          </h2>
          <p class="text-zinc-400 text-sm mt-3">
            Rats and mice prioritize warm, quiet harbourages near food and moisture sources.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {harbourageAreas.map((area) => (
            <div class="slv-card rounded-2xl p-6 border border-white/[0.08]">
              <div class="flex items-center gap-3 mb-3">
                <span class="w-2 h-2 rounded-full bg-[#E5A93C]"></span>
                <h3 class="text-base font-bold text-white font-heading">{area.name}</h3>
              </div>
              <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed">{area.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* 4-STAGE MANAGEMENT PROCESS */}
    <section class="relative z-10 py-16 sm:py-20 border-b border-white/[0.06]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <div class="inline-flex items-center gap-2 mb-3">
            <span class="w-6 h-[1.5px] bg-[#E5A93C]"></span>
            <span class="text-[#E5A93C] text-xs font-bold tracking-[0.25em] uppercase">
              OUR PROTOCOL
            </span>
            <span class="w-6 h-[1.5px] bg-[#E5A93C]"></span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-black text-white font-heading">
            The SLV 4-Stage Rodent Management Process
          </h2>
          <p class="text-zinc-400 text-sm mt-3">
            A methodical Integrated Pest Management (IPM) framework designed for safety and effective population reduction.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {fourStageProcess.map((stage) => {
            const Icon = stage.icon;
            return (
              <div class="slv-card rounded-2xl p-6 border border-white/[0.08] relative group hover:border-[#E5A93C]/50 transition">
                <div class="flex items-center justify-between mb-4">
                  <span class="text-3xl font-black font-heading slv-gold-text">
                    {stage.step}
                  </span>
                  <div class="w-10 h-10 rounded-xl bg-white/[0.04] border border-white/[0.08] flex items-center justify-center">
                    <Icon class="w-5 h-5 text-[#E5A93C]" />
                  </div>
                </div>

                <h3 class="text-base font-bold text-white mb-1 font-heading">
                  {stage.title}
                </h3>
                <p class="text-xs font-semibold text-[#F6C453] mb-3">
                  {stage.description}
                </p>
                <p class="text-zinc-400 text-xs leading-relaxed">
                  {stage.detail}
                </p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* PRICING */}
    <section class="relative z-10 py-16 sm:py-20 border-b border-white/[0.06] bg-[#0c0d10]/50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="slv-card rounded-3xl p-8 sm:p-12 border border-[#E5A93C]/40 relative overflow-hidden">
          <div class="absolute -top-24 -right-24 w-48 h-48 bg-[#E5A93C]/10 rounded-full blur-3xl pointer-events-none"></div>

          <span class="text-[#E5A93C] text-xs font-bold tracking-[0.25em] uppercase block mb-2">
            INSPECTION-BASED PRICING
          </span>
          <h2 class="text-2xl sm:text-4xl font-black text-white font-heading mb-4">
            RODENT MANAGEMENT
          </h2>

          <div class="my-6">
            <span class="text-zinc-400 text-base sm:text-lg mr-2 font-medium">Starting at</span>
            <span class="text-4xl sm:text-5xl lg:text-6xl font-black text-white font-mono tracking-tight text-[#F6C453]">
              ₹699
            </span>
          </div>

          <p class="text-zinc-300 text-xs sm:text-sm max-w-lg mx-auto mb-6 leading-relaxed">
            Treatment scope depends on the square footage of the premises, the number of required tamper-resistant locked bait stations, mechanical trapping zones, and whether roof rats, Norway rats, or mice are involved.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-3 text-xs text-zinc-300 mb-8">
            <span class="px-3 py-1.5 rounded-lg bg-white/[0.04] border border-white/[0.08]">
              Child &amp; Pet Safe Stations
            </span>
            <span class="px-3 py-1.5 rounded-lg bg-white/[0.04] border border-white/[0.08]">
              Transparent Quotations
            </span>
