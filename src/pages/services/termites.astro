---
import Layout from '../../layouts/Layout.astro';
import { Header } from '../../components/Header';
import { Footer } from '../../components/Footer';
import { FloatingActions } from '../../components/FloatingActions';
import { ContactForm } from '../../components/ContactForm';
import ServiceAreasSection from '../../components/ServiceAreasSection.astro';
import {
  Layers,
  Shield,
  ShieldCheck,
  CheckCircle2,
  AlertTriangle,
  Search,
  Phone,
  MessageCircle,
  Mail,
  ArrowRight,
  MapPin,
  Home,
  Building,
  HelpCircle,
  BookOpen,
  Eye,
  Activity,
  FileText,
  DoorOpen,
  Waves,
  Wrench,
  Droplets,
  TreePine,
  Sparkles
} from 'lucide-react';

const signs = [
  {
    title: 'Mud Shelter Tubes',
    desc: 'Earthen tunnels running along foundation plinths, brick walls, skirting boards, door frames, or ceiling joints.',
    icon: Waves
  },
  {
    title: 'Hollow-Sounding Timber',
    desc: 'Door frames, window jambs, and wardrobe panels that sound paper-thin, dull, or hollow when tapped firmly.',
    icon: Layers
  },
  {
    title: 'Discarded Swarmer Wings',
    desc: 'Piles of shed translucent wings left near windowsills, doors, and light fixtures following seasonal rainy-evening flights.',
    icon: AlertTriangle
  },
  {
    title: 'Tight Doors & Window Jams',
    desc: 'Doors or windows becoming difficult to close or latch due to moisture produced by subterranean termite activity inside frames.',
    icon: DoorOpen
  }
];

const harbourageAreas = [
  { name: 'Door & Window Frames', desc: 'Jambs and frames anchored into concrete floor slabs' },
  { name: 'Sub-Slab Foundations', desc: 'Plinth masonry, expansion gaps, and ground soil' },
  { name: 'Skirting Boards', desc: 'Tile-to-wall expansion joints and concealed screed gaps' },
  { name: 'Utility Conduits', desc: 'Electrical cable pipes and plumbing wall sleeves' },
  { name: 'Modular Cabinetry', desc: 'Built-in wardrobes and kitchen modular backboards' },
  { name: 'False Ceilings', desc: 'Wooden perimeter battens and concealed ceiling supports' }
];

const fourStageProcess = [
  {
    step: '01',
    title: 'Property Inspection',
    description: 'Identify visible signs, affected areas and potential termite pathways.',
    detail: 'Our experienced technician evaluates wooden door frames, baseboard skirtings, wardrobes, and masonry joints to document active galleries and structural vulnerabilities.',
    icon: Search
  },
  {
    step: '02',
    title: 'Assessment',
    description: 'Determine the treatment approach based on the property, construction and inspection findings.',
    detail: 'We evaluate wall linear running footage, flooring materials (granite, marble, vitrified tile), and structural layout to design a tailored drill-and-infusion plan.',
    icon: Building
  },
  {
    step: '03',
    title: 'Targeted Treatment',
    description: 'Apply the appropriate treatment to identified areas using the selected treatment method.',
    detail: 'Precision holes (6mm to 8mm) are drilled along skirting junctions and infused with non-repellent liquid termiticide under pressure, followed by color-matched sealing.',
    icon: Wrench
  },
  {
    step: '04',
    title: 'Follow-up & Monitoring',
    description: 'Provide appropriate monitoring and follow-up guidance based on the treatment requirements.',
    detail: 'Post-treatment instructions and monitoring guidance are provided to track barrier performance and verify that structural activity has been successfully arrested.',
    icon: ShieldCheck
  }
];

const propertiesWeTreat = [
  'Homes & Villas',
  'Apartments & High-Rises',
  'Gated Communities',
  'Commercial Offices',
  'Educational Institutions',
  'Warehouses & Storage',
  'Retail Showrooms',
  'Hospitality Properties'
];

const serviceZones = [
  { title: 'NORTH BANGALORE', areas: 'Yelahanka, Hebbal, RT Nagar, Sahakar Nagar and surrounding sectors' },
  { title: 'EAST BANGALORE', areas: 'Whitefield, Indiranagar, Marathahalli, KR Puram and surrounding sectors' },
  { title: 'WEST BANGALORE', areas: 'Nagasandra, Yeshwanthpur, Rajajinagar, Basaveshwaranagar, Andarahalli' },
  { title: 'SOUTH BANGALORE', areas: 'Jayanagar, JP Nagar, BTM Layout, Koramangala, Electronic City' },
  { title: 'CENTRAL BANGALORE', areas: 'Malleshwaram, MG Road, Richmond Town, Shanthi Nagar and central corridors' },
  { title: 'OUTER BANGALORE', areas: 'Sarjapur Road, Devanahalli, Kanakapura Road and extended industrial zones' }
];

const knowledgeArticles = [
  {
    title: 'Termite Identification',
    desc: 'Signs of activity: earthen mud shelter tubes, hollow-sounding wood, and discarded alate wings.',
    href: '/knowledge/termites/identification'
  },
  {
    title: 'Where Termites Are Found',
    desc: 'Foundations, sub-slab plinths, wooden door frames, skirting expansion joints, and moisture areas.',
    href: '/knowledge/termites/where-they-are-found'
  },
  {
    title: 'How Termites Spread',
    desc: 'Movement through subterranean soil, foundation shrinkage cracks, utility conduits, and connected wood.',
    href: '/knowledge/termites/how-they-spread'
  },
  {
    title: 'Termite Prevention',
    desc: 'Practical moisture mitigation, wood-to-soil clearance, crack sealing, and periodic inspection.',
    href: '/knowledge/termites/prevention'
  },
  {
    title: 'Termite Treatment Guide',
    desc: 'The 4-stage journey: property inspection, structural assessment, targeted drill-and-infusion, and monitoring.',
    href: '/knowledge/termites/treatment-guide'
  },
  {
    title: 'Termite FAQ',
    desc: 'Factual answers regarding costs, signs, preparation, duration, apartments, and monitoring.',
    href: '/knowledge/termites/faq'
  }
];

const faqs = [
  {
    q: 'How does subterranean termite treatment work?',
    a: 'We use non-repellent liquid termiticides injected under pressure into precision-drilled holes along wall skirtings, door frames, and masonry joints. Termites unwittingly pass through the treated zone, transfer the active agent to the subterranean colony, and eliminate the nesting source.'
  },
  {
    q: 'How much does termite control cost in Bangalore?',
    a: 'Termite treatment at SLV Pest Control starts from ₹899. The final price depends on the linear footage of walls to be treated, woodwork volume, construction design, and property layout assessed during the on-site evaluation.'
  },
  {
    q: 'Will drilling damage marble, granite, or wooden flooring?',
    a: 'Our technicians utilize specialized precision drill bits (6mm to 8mm) placed discreetly along wall skirtings and tile joints. Following infusion, all holes are sealed with color-matched aesthetic compound.'
  },
  {
    q: 'Can termites damage electrical wiring?',
    a: 'Yes. Termites frequently use electrical conduits as concealed travel highways and can chew through wire insulation, presenting short-circuit hazards.'
  },
  {
    q: 'Is termite treatment suitable for high-rise apartments?',
    a: 'Yes. Termites routinely travel through central plumbing shafts and masonry joints into upper-floor apartments. Our drill-and-infusion protocol is fully adapted for residential flats.'
  },
  {
    q: 'Why is an on-site inspection required before pricing?',
    a: 'Because termite damage occurs behind walls and beneath floorings, an inspection is necessary to measure linear running footage, check woodwork depth, and evaluate foundation access for an accurate quote.'
  }
];
---

<Layout
  title="Termite Treatment in Bangalore | Starting at ₹899 | SLV Pest Control"
  description="Professional termite treatment in Bangalore. Protect your property with precision drill-and-infusion termiticide barriers. Starting at ₹899. Call 91803 97822."
  canonical="https://slvpestcontrol.com/services/termite-control"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Service",
          "@id": "https://slvpestcontrol.com/services/termite-control#service",
          "name": "Termite Treatment in Bangalore",
          "serviceType": "Termite Pest Control Service",
          "provider": {
            "@type": "LocalBusiness",
            "name": "SLV Pest Control",
            "telephone": "+91-9180397822",
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "143 Soundarya Layout, Doddabidarakallu",
              "addressLocality": "Bengaluru",
              "addressRegion": "Karnataka",
              "postalCode": "560073",
              "addressCountry": "IN"
            }
          },
          "areaServed": {
            "@type": "City",
            "name": "Bengaluru"
          },
          "offers": {
            "@type": "Offer",
            "price": "899",
            "priceCurrency": "INR"
          }
        },
        {
          "@type": "FAQPage",
          "@id": "https://slvpestcontrol.com/services/termite-control#faq",
          "mainEntity": faqs.map((faq) => ({
            "@type": "Question",
            "name": faq.q,
            "acceptedAnswer": {
              "@type": "Answer",
              "text": faq.a
            }
          }))
        }
      ]
    })} />
  </Fragment>

  <Header client:load activeItem="termites" />

  <main class="flex-1 w-full relative overflow-hidden bg-[#090a0c]">
    {/* Architectural Background Pattern */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 right-1/4 w-[500px] h-[500px] bg-[#E5A93C]/[0.06] rounded-full blur-[140px]"></div>
      <div class="absolute top-[40%] left-[-100px] w-[500px] h-[500px] bg-[#E5A93C]/[0.04] rounded-full blur-[160px]"></div>
    </div>

    {/* Breadcrumbs */}
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-zinc-400">
        <a href="/" class="hover:text-white transition">Home</a>
        <span>/</span>
        <a href="/#services" class="hover:text-white transition">Services</a>
        <span>/</span>
        <span class="text-[#F6C453] font-semibold">Termite Treatment</span>
      </nav>
    </div>

    {/* ============================================================== */}
    {/* 1. HERO SECTION                                               */}
    {/* ============================================================== */}
    <section class="relative z-10 pt-10 sm:pt-14 lg:pt-18 pb-14 sm:pb-18 border-b border-white/[0.06]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-4xl mx-auto">
          {/* Eyebrow badge */}
          <div class="inline-flex items-center gap-2 mb-5 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-md">
            <span class="w-2 h-2 rounded-full bg-[#E5A93C] animate-pulse"></span>
            <span class="text-[#E5A93C] text-xs font-extrabold tracking-[0.25em] uppercase">
              STRUCTURAL TERMITE PROTECTION • BANGALORE
            </span>
          </div>

          {/* H1 */}
          <h1 class="text-4xl sm:text-5xl lg:text-7xl font-black text-white tracking-tight leading-[1.08] mb-5 font-heading">
            Termite Treatment in <span class="slv-gold-text">Bangalore</span>
          </h1>

          {/* Supporting message */}
          <p class="text-xl sm:text-2xl font-bold text-white mb-6 font-heading tracking-tight">
            Protect your property
          </p>

          <p class="text-zinc-300 text-base sm:text-lg leading-relaxed max-w-3xl mx-auto mb-8 font-normal">
            Subterranean termites cause silent structural damage to wooden door frames, modular wardrobes, and false ceilings. SLV Pest Control provides thorough on-site property evaluations, precision drilling infusion, and long-term chemical barrier protection across Bangalore.
          </p>

          {/* Pricing indicator */}
          <div class="inline-flex items-center gap-4 px-4 py-2 rounded-2xl bg-white/[0.03] border border-white/[0.08] mb-8 text-xs sm:text-sm font-semibold">
            <span class="text-[#F6C453] font-bold">STARTING AT ₹899</span>
            <span class="text-zinc-600">|</span>
            <span class="text-white uppercase tracking-wider text-[11px] sm:text-xs">Precision Drill &amp; Infusion Barrier</span>
          </div>

          {/* CTAs */}
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 sm:gap-4">
            <a
              href="/contact"
              class="slv-btn-primary w-full sm:w-auto px-8 py-3.5 text-xs sm:text-sm font-black gap-2 uppercase tracking-wider"
            >
              <span>Get Free Inspection</span>
              <ArrowRight class="w-4 h-4" />
            </a>

            <a
              href="tel:9180397822"
              class="slv-btn-secondary w-full sm:w-auto px-7 py-3.5 text-xs sm:text-sm font-bold gap-2 uppercase tracking-wider hover:border-[#F6C453]"
            >
              <Phone class="w-4 h-4 text-[#F6C453]" />
              <span>Call Now</span>
            </a>

            <a
              href="https://wa.me/9180397822"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto px-6 py-3.5 text-xs sm:text-sm font-bold gap-2 uppercase tracking-wider rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-md transition-all inline-flex items-center justify-center"
            >
              <MessageCircle class="w-4 h-4 text-white" />
              <span>WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* ============================================================== */}
    {/* 2. SIGNS OF TERMITES                                          */}
    {/* ============================================================== */}
    <section class="relative z-10 py-16 sm:py-20 border-b border-white/[0.06] bg-[#0c0d10]/50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <div class="inline-flex items-center gap-2 mb-4">
            <span class="w-6 h-[1.5px] bg-[#E5A93C]"></span>
            <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase">
              IDENTIFICATION
            </span>
            <span class="w-6 h-[1.5px] bg-[#E5A93C]"></span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight font-heading">
            Signs of Termite Activity
          </h2>
          <p class="text-zinc-400 text-sm sm:text-base mt-3">
            Inspect your foundation walls, door frames, and wooden fixtures for these characteristic indicators.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {signs.map((sign) => {
            const Icon = sign.icon;
            return (
              <div class="slv-card rounded-2xl p-6 border border-white/[0.08] flex flex-col justify-between">
                <div>
                  <div class="w-10 h-10 rounded-xl bg-[#E5A93C]/10 border border-[#E5A93C]/20 flex items-center justify-center text-[#E5A93C] mb-4">
                    <Icon class="w-5 h-5 text-[#E5A93C]" />
                  </div>
                  <h3 class="text-base sm:text-lg font-bold text-white mb-2">
                    {sign.title}
                  </h3>
                  <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed">
                    {sign.desc}
                  </p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* ============================================================== */}
    {/* 3. WHERE TERMITES ARE FOUND                                   */}
    {/* ============================================================== */}
    <section class="relative z-10 py-16 sm:py-20 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
          <div class="inline-flex items-center gap-2 mb-4">
            <span class="w-6 h-[1.5px] bg-[#E5A93C]"></span>
            <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase">
              HARBOURAGE AREAS
            </span>
            <span class="w-6 h-[1.5px] bg-[#E5A93C]"></span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-black text-white font-heading">
            Where Termites Are Found
          </h2>
          <p class="text-zinc-400 text-sm mt-3">
            Common structural entry points and concealed cavities connecting soil to interior woodwork.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
          {harbourageAreas.map((item) => (
            <div class="slv-card rounded-2xl p-5 border border-white/[0.07] flex flex-col justify-between">
              <div>
                <h3 class="text-sm sm:text-base font-bold text-[#F6C453] mb-1.5">{item.name}</h3>
                <p class="text-zinc-400 text-xs leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ============================================================== */}
    {/* 4. OUR 4-STAGE TREATMENT PROCESS                              */}
    {/* ============================================================== */}
    <section class="relative z-10 py-16 sm:py-20 lg:py-24 border-b border-white/[0.06] bg-[#0c0d10]/50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-14 sm:mb-18">
          <div class="inline-flex items-center gap-2 mb-4">
            <span class="w-6 h-[1.5px] bg-[#E5A93C]"></span>
            <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase">
              TREATMENT PROCESS
            </span>
            <span class="w-6 h-[1.5px] bg-[#E5A93C]"></span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight font-heading">
            Our 4-Stage Treatment Journey
          </h2>
          <p class="text-zinc-400 text-sm sm:text-base mt-4">
            A property-specific approach covering on-site evaluation, structural assessment, targeted drill-and-infusion, and monitoring.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {fourStageProcess.map((stage) => {
            const Icon = stage.icon;
            return (
              <div class="slv-card rounded-2xl p-7 flex flex-col justify-between border border-white/[0.08] hover:border-[#E5A93C]/50 transition-all">
                <div>
                  <div class="flex items-center justify-between mb-5">
                    <span class="text-3xl font-black font-heading slv-gold-text tracking-tighter">
                      {stage.step}
                    </span>
                    <div class="w-10 h-10 rounded-xl bg-white/[0.04] border border-white/[0.08] flex items-center justify-center text-[#E5A93C]">
                      <Icon class="w-5 h-5 text-[#E5A93C]" />
                    </div>
                  </div>

                  <h3 class="text-lg font-bold text-white font-heading mb-2">
                    {stage.title}
                  </h3>
                  <p class="text-[#FFE08A] text-xs font-semibold mb-3">
                    {stage.description}
                  </p>
                  <p class="text-zinc-400 text-xs sm:text-[13px] leading-relaxed">
                    {stage.detail}
                  </p>
                </div>

                <div class="mt-6 pt-4 border-t border-white/[0.06] text-[11px] text-zinc-500 font-mono">
                  Phase {stage.step} of 04
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* ============================================================== */}
    {/* 5. PROPERTIES WE TREAT                                        */}
    {/* ============================================================== */}
    <section class="relative z-10 py-16 sm:py-20 border-b border-white/[0.06]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
          <div class="inline-flex items-center gap-2 mb-4">
            <span class="w-6 h-[1.5px] bg-[#E5A93C]"></span>
            <span class="text-[#E5A93C] text-xs font-bold tracking-[0.2em] uppercase">
              COVERAGE
            </span>
            <span class="w-6 h-[1.5px] bg-[#E5A93C]"></span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight font-heading">
            Properties We Treat
          </h2>
          <p class="text-zinc-400 text-sm sm:text-base mt-3">
            Customized termite management solutions across residential, educational, and commercial properties.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-5xl mx-auto">
          {propertiesWeTreat.map((prop) => (
            <div class="slv-card rounded-2xl p-5 border border-white/[0.07] text-center flex flex-col items-center justify-center">
              <Building class="w-6 h-6 text-[#E5A93C] mb-2" />
              <span class="text-sm font-bold text-white">{prop}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ============================================================== */}
    {/* 6. DEDICATED PRICING SECTION                                  */}
    {/* ============================================================== */}
    <section class="relative z-10 py-16 sm:py-20 border-b border-white/[0.06] bg-[#0c0d10]/50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="slv-card rounded-3xl p-8 sm:p-14 border border-[#E5A93C]/40 bg-gradient-to-b from-[#14161c] to-[#0c0d10] shadow-[0_20px_50px_rgba(0,0,0,0.8)]">
          <span class="text-[#E5A93C] text-xs font-extrabold tracking-[0.25em] uppercase block mb-3">
            ASSESSMENT-BASED PRICING
          </span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-white font-heading mb-6">
            TERMITE TREATMENT
          </h2>
          <div class="my-6">
            <span class="text-zinc-400 text-base sm:text-lg mr-2 font-medium">Starting at</span>
            <span class="text-4xl sm:text-5xl lg:text-6xl font-black text-white font-mono tracking-tight text-[#F6C453]">
              ₹899
            </span>
          </div>
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/[0.04] border border-white/[0.08] mb-8">
            <ShieldCheck class="w-4 h-4 text-[#E5A93C]" />
            <span class="text-xs sm:text-sm font-bold text-white uppercase tracking-wider">
              Precision Drill &amp; Infusion Method
            </span>
          </div>
          <p class="text-zinc-400 text-xs sm:text-sm max-w-md mx-auto mb-8 leading-relaxed">
            Termite treatment pricing depends on the linear footage of walls, woodwork complexity, and property layout. We provide clear, transparent upfront quotations following on-site evaluation.
          </p>
          <div class="flex justify-center">
            <a
              href="/contact"
              class="slv-btn-primary px-8 py-4 text-xs sm:text-sm font-black gap-2 uppercase tracking-wider"
            >
              <span>Get Free Inspection</span>
              <ArrowRight class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* ============================================================== */}
    {/* 7. LEARN MORE ABOUT TERMITES (KNOWLEDGE HUB CARDS)            */}
    {/* ============================================================== */}
    <section class="relative z-10 py-16 sm:py-20 lg:py-24 border-b border-white/[0.06]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <div class="inline-flex items-center gap-2 mb-3">
            <BookOpen class="w-4 h-4 text-[#E5A93C]" />
            <span class="text-[#E5A93C] text-xs font-bold tracking-[0.25em] uppercase">
              EDUCATIONAL RESOURCES
            </span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight font-heading">
            Learn More About Termites
          </h2>
          <p class="text-zinc-400 text-sm sm:text-base mt-3">
            Explore our educational Knowledge Hub guides covering identification, structural harbourage zones, spread mechanics, prevention, 4-stage treatment protocols, and FAQs.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {knowledgeArticles.map((article) => (
