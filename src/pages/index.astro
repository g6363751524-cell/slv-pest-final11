---
import Layout from '../layouts/Layout.astro';
import { Header } from '../components/Header';
import { Hero } from '../components/Hero';
import { FeatureBar } from '../components/FeatureBar';
import { ProblemSigns } from '../components/ProblemSigns';
import { ServicesGrid } from '../components/ServicesGrid';
import { HowItWorks } from '../components/HowItWorks';
import { WhyChooseUs } from '../components/WhyChooseUs';
import { ServiceAreas } from '../components/ServiceAreas';
import { InspectionCta } from '../components/InspectionCta';
import { Footer } from '../components/Footer';
import { FloatingActions } from '../components/FloatingActions';
---

<Layout>
  <!-- 1. Header (Interactive navigation, dropdowns, dialer hover, and mobile menu) -->
  <Header client:load activeItem="home" />

  <!-- Main Content Area - normal continuous document flow -->
  <main class="flex-1 w-full">
    <!-- 2. Hero — "PESTS OUT. PEACE IN." -->
    <Hero />

    <!-- 3. Four feature cards -->
    <FeatureBar />

    <!-- 4. Problem / Signs section -->
    <ProblemSigns />

    <!-- 5. 10-Service Mockup Grid (5 cols x 2 rows, diagonal split, live-to-dead hover) -->
    <ServicesGrid client:visible />

    <!-- 6. How It Works -->
    <HowItWorks />

    <!-- 7. Why Choose Us -->
    <WhyChooseUs />

    <!-- 8. Bangalore Service Areas -->
    <ServiceAreas />

    <!-- 9. Inspection CTA -->
    <InspectionCta />
  </main>

  <!-- 10. Footer -->
  <Footer />

  <!-- 11. Floating Scroll to Top & WhatsApp Actions -->
  <FloatingActions client:load />
</Layout>
