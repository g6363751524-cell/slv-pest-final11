---
import Layout from '../layouts/Layout.astro';
import { Header } from '../components/Header';
import { Footer } from '../components/Footer';
import { FloatingActions } from '../components/FloatingActions';
---

<Layout
  title="Terms & Conditions | SLV Pest Control Bangalore"
  description="Terms of service, warranty conditions, and treatment agreements for SLV Pest Control."
  canonical="https://slvpestcontrol.com/terms"
>
  <Header client:load />

  <main class="flex-1 w-full relative overflow-hidden bg-[#090a0c] py-16 sm:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="slv-card rounded-3xl p-8 sm:p-12 border border-white/[0.08]">
        <h1 class="text-3xl sm:text-4xl font-black text-white font-heading mb-6">Terms &amp; Conditions</h1>
        <div class="space-y-4 text-zinc-300 text-sm sm:text-base leading-relaxed">
          <p>
            Welcome to SLV Pest Control. By booking a pest control inspection or service with us, you agree to the following terms and guidelines.
          </p>
          <h2 class="text-xl font-bold text-white font-heading pt-4">Service Scope &amp; Inspection</h2>
          <p>
            All treatments are preceded by an on-site property evaluation to confirm infestation scope, species involved, and safety requirements. Quotations provided reflect the agreed property dimensions and treatment scope.
          </p>
          <h2 class="text-xl font-bold text-white font-heading pt-4">Preparation &amp; Post-Treatment Care</h2>
          <p>
            Clients must follow specific preparation instructions provided by our technicians prior to and following treatment (e.g., maintaining clean surfaces, keeping treated areas dry, and reducing clutter).
          </p>
          <h2 class="text-xl font-bold text-white font-heading pt-4">Warranty Terms</h2>
          <p>
            Where a service warranty applies (such as our 4-month bed bug warranty), warranty assistance covers follow-up visits to treated areas in accordance with the specific service agreement. Re-infestations resulting from introduction of untreated furniture or severe structural neglect are evaluated accordingly.
          </p>
          <h2 class="text-xl font-bold text-white font-heading pt-4">Contact Information</h2>
          <p>
            For customer service inquiries, contact us at <strong>contact@slvpestcontrol.com</strong> or call <strong>91803 97822</strong>. Office address: 143 Soundarya Layout, Doddabidarakallu, Bangalore 560073.
          </p>
        </div>
      </div>
    </div>
  </main>

  <Footer />
  <FloatingActions client:load />
</Layout>
