---
import Layout from '../layouts/Layout.astro';
import { Header } from '../components/Header';
import { Footer } from '../components/Footer';
import { FloatingActions } from '../components/FloatingActions';
import { GoogleDrivePortal } from '../components/GoogleDrivePortal';
import {
  HardDrive,
  ShieldCheck,
  FileCheck,
  Camera,
  FolderLock,
  Phone,
  MessageCircle,
  Clock,
  Sparkles,
} from 'lucide-react';
---

<Layout
  title="Google Drive Document & Inspection Portal | SLV Pest Control"
  description="Securely access, upload, and generate pest control inspection certificates, chemical safety data sheets, and infestation photos stored directly in your Google Drive with SLV Pest Control Bangalore."
>
  <Header client:load />

  <main class="relative bg-[#090a0c] text-zinc-100 min-h-screen overflow-hidden selection:bg-[#F6C453] selection:text-black">
    {/* Geometric Honeycomb Background Pattern */}
    <div class="absolute inset-0 pointer-events-none opacity-[0.035] bg-[radial-gradient(#F6C453_1px,transparent_1px)] [background-size:24px_24px]"></div>
    
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1100px] h-[550px] bg-gradient-to-b from-[#F6C453]/10 via-cyan-500/5 to-transparent blur-[130px] pointer-events-none"></div>
    <div class="absolute top-[700px] right-[-100px] w-[500px] h-[500px] bg-cyan-500/5 blur-[120px] pointer-events-none"></div>

    {/* HERO SECTION */}
    <section class="relative pt-32 pb-12 sm:pt-36 sm:pb-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* Breadcrumb */}
      <nav class="flex items-center gap-2 text-xs font-mono text-zinc-400 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition">Home</a>
        <span class="text-zinc-600">/</span>
        <span class="text-[#F6C453]">Google Drive Portal</span>
      </nav>

      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-12">
        <div class="max-w-3xl space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#F6C453]/10 border border-[#F6C453]/25 text-[#F6C453] text-xs font-semibold uppercase tracking-wider">
            <HardDrive className="w-3.5 h-3.5" />
            <span>Workspace Cloud Integration</span>
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-[1.15]">
            Customer & Inspection <br />
            <span class="bg-gradient-to-r from-[#F6C453] via-amber-200 to-[#F6C453] bg-clip-text text-transparent">
              Google Drive Portal
            </span>
          </h1>

          <p class="text-zinc-400 text-sm sm:text-base leading-relaxed max-w-2xl">
            Access verified pest control treatment certificates, upload site infestation photos, organize AMC service agreements, and store Central Insecticides Board safety documentation directly inside your private Google Drive.
          </p>
        </div>

        {/* Quick Contact Badges */}
        <div class="flex flex-wrap items-center gap-3">
          <a
            href="tel:9180397822"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-zinc-900 border border-white/10 hover:border-[#F6C453]/40 text-xs font-semibold text-white transition group"
          >
            <Phone className="w-3.5 h-3.5 text-[#F6C453] group-hover:scale-110 transition" />
            <span>Support: 91803 97822</span>
          </a>
          <a
            href="https://wa.me/919180397822?text=Hi%20SLV%20Pest%20Control,%20I%20need%20help%20with%20my%20inspection%20records."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-950/40 border border-emerald-500/30 hover:border-emerald-500/60 text-xs font-semibold text-emerald-300 transition"
          >
            <MessageCircle className="w-3.5 h-3.5" />
            <span>WhatsApp Us</span>
          </a>
        </div>
      </div>

      {/* Feature Strip */}
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 mb-10">
        <div class="p-4 rounded-2xl bg-[#0c0e12]/80 border border-white/[0.06] backdrop-blur-md">
          <FileCheck className="w-5 h-5 text-[#F6C453] mb-2" />
          <h3 class="text-xs font-bold text-white mb-1">Audit Reports</h3>
          <p class="text-[11px] text-zinc-400">Save inspection certificates directly into Drive.</p>
        </div>
        <div class="p-4 rounded-2xl bg-[#0c0e12]/80 border border-white/[0.06] backdrop-blur-md">
          <Camera className="w-5 h-5 text-cyan-400 mb-2" />
          <h3 class="text-xs font-bold text-white mb-1">Evidence Photos</h3>
          <p class="text-[11px] text-zinc-400">Upload high-res termite and pest harboring shots.</p>
        </div>
        <div class="p-4 rounded-2xl bg-[#0c0e12]/80 border border-white/[0.06] backdrop-blur-md">
          <FolderLock className="w-5 h-5 text-emerald-400 mb-2" />
          <h3 class="text-xs font-bold text-white mb-1">User-Owned Storage</h3>
          <p class="text-[11px] text-zinc-400">All data stays in your personal Google Drive.</p>
        </div>
        <div class="p-4 rounded-2xl bg-[#0c0e12]/80 border border-white/[0.06] backdrop-blur-md">
          <ShieldCheck className="w-5 h-5 text-purple-400 mb-2" />
          <h3 class="text-xs font-bold text-white mb-1">Strict Token Privacy</h3>
          <p class="text-[11px] text-zinc-400">Memory-only tokens, zero storage leakage.</p>
        </div>
      </div>

      {/* GOOGLE DRIVE INTERACTIVE PORTAL APP */}
      <GoogleDrivePortal client:load />

      {/* EDUCATIONAL & WORKFLOW GUIDANCE */}
      <section class="mt-20 pt-16 border-t border-white/[0.08]">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight mb-3">
            Why We Integrate With Google Drive
          </h2>
          <p class="text-zinc-400 text-xs sm:text-sm">
            Maintaining clear records of chemical applications, warranty periods, and pest sighting histories helps both Bangalore homeowners and commercial facilities stay audit-ready.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl bg-[#0e1015]/70 border border-white/[0.07] space-y-3">
            <div class="w-8 h-8 rounded-lg bg-[#F6C453]/10 border border-[#F6C453]/20 flex items-center justify-center text-[#F6C453] font-bold text-xs">
              01
            </div>
            <h3 class="text-sm font-bold text-white">Pre-Construction & Termite AMC Cards</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Termite warranties often span 1, 3, or 5 years. Storing the digital warranty card and chemical dilution certificate in your Google Drive ensures you never misplace physical paper slips.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-[#0e1015]/70 border border-white/[0.07] space-y-3">
            <div class="w-8 h-8 rounded-lg bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-300 font-bold text-xs">
              02
            </div>
            <h3 class="text-sm font-bold text-white">Commercial Food Safety Audits</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              FSSAI and corporate facility managers require chemical Material Safety Data Sheets (MSDS) and monthly bait station monitoring logs. Easily share Google Drive folders with safety auditors.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-[#0e1015]/70 border border-white/[0.07] space-y-3">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-300 font-bold text-xs">
              03
            </div>
            <h3 class="text-sm font-bold text-white">Before & After Photographic Evidence</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Technicians upload high-resolution inspection photos showing bed bug infestation harbors, rodent entry burrows, or cockroach nests, followed by verified post-treatment resolution photos.
            </p>
          </div>
        </div>
      </section>
    </section>
  </main>

  <Footer client:load />
  <FloatingActions client:load />
</Layout>
