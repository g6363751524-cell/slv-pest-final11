---
import Layout from '../layouts/Layout.astro';
import { Header } from '../components/Header';
import { Footer } from '../components/Footer';
import { FloatingActions } from '../components/FloatingActions';
---

<Layout
  title="Privacy Policy | SLV Pest Control Bangalore"
  description="Privacy policy and data protection principles for SLV Pest Control clients in Bangalore."
  canonical="https://slvpestcontrol.com/privacy"
>
  <Header client:load />

  <main class="flex-1 w-full relative overflow-hidden bg-[#090a0c] py-16 sm:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="slv-card rounded-3xl p-8 sm:p-12 border border-white/[0.08]">
        <h1 class="text-3xl sm:text-4xl font-black text-white font-heading mb-6">Privacy Policy</h1>
        <div class="space-y-4 text-zinc-300 text-sm sm:text-base leading-relaxed">
          <p>
            At SLV Pest Control, we value the trust you place in us when inviting our technicians into your home or commercial premises. We are committed to protecting your personal information and handling your data transparently.
          </p>
          <h2 class="text-xl font-bold text-white font-heading pt-4">Information We Collect</h2>
          <p>
            When you contact us by telephone, WhatsApp, or through our website booking form, we collect necessary contact information such as your name, phone number, service address in Bangalore, and details regarding the pest issues you are facing.
          </p>
          <h2 class="text-xl font-bold text-white font-heading pt-4">How We Use Your Information</h2>
          <p>
            Your information is used solely to coordinate inspections, deliver pest management treatments, issue warranty service agreements, and provide post-treatment follow-up support. We do not sell, rent, or trade your personal information to third parties.
          </p>
          <h2 class="text-xl font-bold text-white font-heading pt-4">Contact Us</h2>
          <p>
            For any questions regarding our privacy practices, contact us at <strong>contact@slvpestcontrol.com</strong> or call <strong>91803 97822</strong>. Office address: 143 Soundarya Layout, Doddabidarakallu, Bangalore 560073.
          </p>
        </div>
      </div>
    </div>
  </main>

  <Footer />
  <FloatingActions client:load />
</Layout>
