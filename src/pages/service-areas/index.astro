---

<Layout
  title="Pest Control Service Areas in Bangalore | North, East, West, South, Central & Outer Bangalore"
  description="We provide pest-control services across North, East, West, South, Central and Outer Bangalore. Same-day inspection, odorless gel baiting, and certified pest management. Call 91803 97822."
  canonical="https://slvpestcontrol.com/service-areas"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "LocalBusiness",
          "@id": "https://slvpestcontrol.com/#business",
          "name": "SLV Pest Control",
          "telephone": "+91-9180397822",
          "email": "contact@slvpestcontrol.com",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "143 Soundarya Layout, Doddabidarakallu",
            "addressLocality": "Bengaluru",
            "addressRegion": "Karnataka",
            "postalCode": "560073",
            "addressCountry": "IN"
          },
          "areaServed": [
            "North Bangalore",
            "East Bangalore",
            "West Bangalore",
            "South Bangalore",
            "Central Bangalore",
            "Outer Bangalore",
            "Bengaluru"
          ]
        },
        {
          "@type": "FAQPage",
          "@id": "https://slvpestcontrol.com/service-areas#faq",
          "mainEntity": faqs.map((faq) => ({
            "@type": "Question",
            "name": faq.q,
            "acceptedAnswer": {
              "@type": "Answer",
              "text": faq.a
            }
          }))
        }
      ]
    })} />
  </Fragment>

  <!-- Reusable Global Header with active Service Areas navigation -->
  <Header client:load activeItem="service-areas" />

  <main class="flex-1 w-full relative overflow-hidden bg-[#090a0c]">
    <!-- Clean Architectural Honeycomb Pattern & Ambient Geometric Lines (NO photo backgrounds) -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <svg
        class="absolute w-full h-full opacity-[0.035]"
        xmlns="http://www.w3.org/2000/svg"
        width="100%"
        height="100%"
      >
        <defs>
          <pattern id="honeycomb-pattern-service-areas" width="56" height="96" patternUnits="userSpaceOnUse">
            <path
              d="M28 0 L56 16 L56 48 L28 64 L0 48 L0 16 Z M28 48 L56 64 L56 96 L28 112 L0 96 L0 64 Z"
              fill="none"
              stroke="#E5A93C"
              stroke-width="1"
            />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#honeycomb-pattern-service-areas)" />
      </svg>

      <!-- Multi-region soft ambient lighting gradients -->
      <div class="absolute -top-32 right-1/4 w-[520px] h-[520px] bg-[#E5A93C]/[0.05] rounded-full blur-[140px]"></div>
      <div class="absolute top-[28%] left-[-120px] w-[500px] h-[500px] bg-cyan-500/[0.03] rounded-full blur-[160px]"></div>
      <div class="absolute top-[55%] right-[-100px] w-[500px] h-[500px] bg-purple-500/[0.03] rounded-full blur-[160px]"></div>
      <div class="absolute bottom-20 left-1/4 w-[500px] h-[500px] bg-emerald-500/[0.03] rounded-full blur-[160px]"></div>
    </div>

    {/* ============================================================== */}
    {/* 1. HERO SECTION                                               */}
    {/* ============================================================== */}
    <section class="relative z-10 pt-16 sm:pt-20 lg:pt-24 pb-14 sm:pb-18 border-b border-white/[0.06]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <!-- Breadcrumb: Home → Service Areas -->
        <nav aria-label="Breadcrumb" class="flex items-center justify-center gap-2 text-xs text-zinc-400 mb-6 font-medium">
          <a href="/" class="hover:text-[#F6C453] transition-colors">Home</a>
          <span class="text-zinc-600">→</span>
          <span class="text-[#F6C453] font-semibold">Service Areas</span>
        </nav>

        <!-- Eyebrow badge -->
        <div class="inline-flex items-center gap-2 mb-5 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-[#E5A93C]/30 backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-[#E5A93C] animate-pulse"></span>
          <span class="text-[#E5A93C] text-[11px] sm:text-xs font-extrabold tracking-[0.2em] uppercase font-mono">
            BANGALORE REGIONAL COVERAGE
          </span>
        </div>

        <!-- Heading: Pest Control Service Areas in Bangalore (Bangalore in gold) -->
        <h1 class="text-4xl sm:text-5xl lg:text-7xl font-black text-white tracking-tight leading-[1.08] mb-5 font-heading max-w-5xl mx-auto">
          Pest Control Service Areas in <span class="text-[#F6C453] slv-gold-text">Bangalore</span>
        </h1>

        <!-- Introductory text verbatim from brief -->
        <p class="text-zinc-200 text-base sm:text-lg lg:text-xl font-medium leading-relaxed max-w-3xl mx-auto mb-4">
          “We provide pest-control services across North, East, West, South, Central and Outer Bangalore.”
        </p>

        <!-- Preserved description about residential and commercial coverage -->
        <p class="text-zinc-400 text-xs sm:text-sm lg:text-base leading-relaxed max-w-3xl mx-auto mb-8 font-normal">
          SLV Pest Control provides comprehensive residential and commercial pest management with certified technicians strategically stationed across all Bangalore metropolitan sectors. Experience odorless, warranty-backed protection with rapid same-day response.
        </p>

        <!-- Three Prominent Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 sm:gap-4 mb-12">
          <!-- Get Free Inspection -->
          <a
            href="#contact"
            class="slv-btn-primary w-full sm:w-auto px-8 py-4 text-xs sm:text-sm font-black gap-2 uppercase tracking-wider shadow-lg shadow-[#E5A93C]/25 hover:shadow-[#E5A93C]/40"
          >
            <span>GET FREE INSPECTION</span>
            <ArrowRight class="w-4 h-4" />
          </a>

          <!-- WhatsApp Button -->
          <a
            href="https://wa.me/9180397822"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-8 py-4 text-xs sm:text-sm font-bold gap-2.5 uppercase tracking-wider rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-[0_4px_20px_rgba(37,211,102,0.35)] hover:shadow-[0_6px_26px_rgba(37,211,102,0.55)] hover:scale-[1.02] active:scale-95 transition-all duration-200 inline-flex items-center justify-center"
          >
            <MessageCircle class="w-4 h-4 text-white" />
            <span>WHATSAPP</span>
          </a>

          <!-- Call Helpline -->
          <a
            href="tel:9180397822"
            class="slv-btn-secondary w-full sm:w-auto px-7 py-4 text-xs sm:text-sm font-black gap-2 uppercase tracking-wider hover:border-[#F6C453]"
          >
            <Phone class="w-4 h-4 text-[#F6C453]" />
            <span>CALL: 91803 97822</span>
          </a>
        </div>

        <!-- Four Compact Feature Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 max-w-5xl mx-auto text-left pt-6 border-t border-white/[0.06]">
          {/* Card 1: Same-Day Service */}
          <div class="slv-card rounded-2xl p-4 sm:p-5 border border-white/[0.08] bg-[#0c0d10]/70 hover:border-[#E5A93C]/40 transition-colors">
            <div class="w-9 h-9 rounded-xl bg-[#E5A93C]/10 border border-[#E5A93C]/30 flex items-center justify-center mb-2.5">
              <Clock class="w-4 h-4 text-[#F6C453]" />
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-white tracking-tight">Same-Day Service</h3>
            <p class="text-[11px] text-zinc-400 mt-0.5">30-45 min local response</p>
          </div>

          {/* Card 2: Safe & Odorless */}
          <div class="slv-card rounded-2xl p-4 sm:p-5 border border-white/[0.08] bg-[#0c0d10]/70 hover:border-cyan-500/40 transition-colors">
            <div class="w-9 h-9 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center mb-2.5">
              <ShieldCheck class="w-4 h-4 text-cyan-400" />
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-white tracking-tight">Safe &amp; Odorless</h3>
            <p class="text-[11px] text-zinc-400 mt-0.5">Kid &amp; pet-friendly gels</p>
          </div>

          {/* Card 3: Free Inspection */}
          <div class="slv-card rounded-2xl p-4 sm:p-5 border border-white/[0.08] bg-[#0c0d10]/70 hover:border-emerald-500/40 transition-colors">
            <div class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center mb-2.5">
              <Sparkles class="w-4 h-4 text-emerald-400" />
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-white tracking-tight">Free Inspection</h3>
            <p class="text-[11px] text-zinc-400 mt-0.5">Zero obligation diagnostics</p>
          </div>

          {/* Card 4: Warranty Backed */}
          <div class="slv-card rounded-2xl p-4 sm:p-5 border border-white/[0.08] bg-[#0c0d10]/70 hover:border-[#E5A93C]/40 transition-colors">
            <div class="w-9 h-9 rounded-xl bg-[#E5A93C]/10 border border-[#E5A93C]/30 flex items-center justify-center mb-2.5">
              <CalendarCheck class="w-4 h-4 text-[#F6C453]" />
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-white tracking-tight">Warranty Backed</h3>
            <p class="text-[11px] text-zinc-400 mt-0.5">Up to 4 mos. / 5 yrs guarantee</p>
          </div>
        </div>
      </div>
    </section>

    {/* ============================================================== */}
    {/* 2. BANGALORE REGIONAL COVERAGE: 6 REGIONAL CARDS               */}
    {/* ============================================================== */}
    <section class="relative z-10 py-16 sm:py-20 lg:py-24 border-b border-white/[0.06]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
