const allTenPests = [
  {
    name: 'Bed Bugs',
    species: 'Cimex lectularius',
    serviceLink: '/services/bed-bugs',
    pricing: 'Starting at ₹999',
    badge: 'High Priority',
    desc: 'Blood-feeding parasitic insects that harbour within 5–8 feet of sleeping areas in mattress seams, box springs, headboards, and electrical socket voids.',
    signs: 'Linear red bite welts, tiny dark fecal spots on sheets, cast nymphal exoskeletons, and a faint sweet-musty room odor.',
    prevention: 'Inspect travel luggage before unpacking, wash bed linen at temperatures exceeding 60°C, and avoid acquiring untreated second-hand furniture.'
  },
  {
    name: 'Subterranean Termites',
    species: 'Coptotermes & Heterotermes',
    serviceLink: '/services/termites',
    pricing: 'Starting at ₹899',
    badge: 'Structural Risk',
    desc: 'Social wood-destroying insects nesting in underground moisture gradients that construct earthen mud tubes to access and hollow out structural timber.',
    signs: 'Mud shelter tubes along plinths, hollow-sounding doorframes, discarded alate swarmer wings near windows, and bubbled wall paint.',
    prevention: 'Eliminate direct wood-to-soil ground contact, repair sub-slab plumbing leaks promptly, and install continuous chemical soil barriers.'
  },
  {
    name: 'Cockroaches',
    species: 'German (Blattella germanica) & American',
    serviceLink: '/services/cockroach-control',
    pricing: 'Starting at ₹599',
    badge: 'Common Infestation',
    desc: 'Nocturnal scavengers sheltering in warm kitchen crevices, behind refrigerator motors, and in drainage shafts. Carry pathogens and trigger allergic asthma.',
    signs: 'Pepper-like droppings, dark ootheca egg capsules, stale oily odor, and live insects scattering when kitchen lights are switched on.',
    prevention: 'Seal plumbing pipe wall penetrations, wipe kitchen counters nightly, and store pantry dry grains in airtight containers.'
  },
  {
    name: 'Mosquitoes',
    species: 'Aedes aegypti, Culex & Anopheles',
    serviceLink: '/services/mosquitoes',
    pricing: 'Starting at ₹799',
    badge: 'Vector Risk',
    desc: 'Flying disease vectors breeding in stagnant water containers, plant saucers, and storm sumps, resting in shaded indoor foliage and curtains during daylight.',
    signs: 'Audible buzzing around beds, persistent itchy bites at dawn/dusk, and visible wigglers (larvae) in standing water receptacles.',
    prevention: 'Empty balcony plant drip trays weekly, ensure overhead tank lids are sealed tightly, and maintain fine window mesh screens.'
  },
  {
    name: 'Rodents (Rats & Mice)',
    species: 'Rattus rattus & Mus musculus',
    serviceLink: '/services/rodents',
    pricing: 'Starting at ₹699',
    badge: 'Wire & Food Hazard',
    desc: 'Destructive mammals that gnaw electrical wiring, contaminate pantry foods, and travel along false ceilings, kitchen modular voids, and drainage pipes.',
    signs: 'Spindle-shaped black droppings, gnaw marks on PVC pipes/wood, nocturnal scuttling noises, and dark greasy rub trails along skirting.',
    prevention: 'Seal wall penetrations greater than 6mm with steel wool and mortar, keep pantry staples in glass/metal jars, and maintain covered floor drains.'
  },
  {
    name: 'Ants (Black & Carpenter Ants)',
    species: 'Formicidae family',
    serviceLink: '/services/ant-control',
    pricing: 'Starting at ₹499',
    badge: 'Kitchen Invader',
    desc: 'Social foraging insects that establish pheromone trails along electrical conduits, wall gaps, and sink rims leading to satellite colonies.',
    signs: 'Organized trailing columns of worker ants, food and sweet contamination, fine sawdust frass in timber, and perimeter nesting mounds.',
    prevention: 'Store sugar and syrups in airtight containers, wipe counter spills immediately, fix faucet drips, and seal perimeter baseboard gaps.'
  },
  {
    name: 'Brown Dog Ticks',
    species: 'Rhipicephalus sanguineus',
    serviceLink: '/services/tick-control',
    pricing: 'Starting at ₹799',
    badge: 'Pet Parasite',
    desc: 'Eight-legged arachnids that crawl vertically up indoor walls, curtains, and kennel cracks, attaching to domestic pets and humans to ingest blood.',
    signs: 'Ticks attached to pet skin (ears, neck, paws), flat reddish-brown nymphs climbing vertical walls, and scratching dogs.',
    prevention: 'Maintain veterinarian-approved topical pet spot-on treatments, inspect kennel crevices regularly, and treat compound perimeter walls.'
  },
  {
    name: 'Fleas',
    species: 'Ctenocephalides felis & canis',
    serviceLink: '/services/fleas',
    pricing: 'Starting at ₹799',
    badge: 'Bite Vector',
    desc: 'Tiny wingless jumping insects residing in carpet piles, rug fibers, and pet resting cushions, biting human ankles and lower legs.',
    signs: 'Domestic pets constantly scratching, red itchy ankle bite clusters, and black specks of flea dirt (digested blood) on pet bedding.',
    prevention: 'Regular pet brushing, hot laundering of pet cushions at 60°C, and frequent high-suction vacuuming of carpet fibers and baseboards.'
  },
  {
    name: 'Wood Borers',
    species: 'Anobiidae & Bostrichidae',
    serviceLink: '/services/wood-borer-control',
    pricing: 'Starting at ₹899',
    badge: 'Timber Threat',
    desc: 'Timber-infesting beetles whose larvae tunnel through wooden furniture, doorframes, plywood cabinetry, and wooden architectural rafters.',
    signs: 'Tiny round pinholes (shot-holes), piles of fine flour-like yellow wood dust (frass) beneath wooden items, and brittle timber edges.',
    prevention: 'Apply protective polyurethane sealer coats on unpolished timber backs, maintain low indoor humidity, and inspect newly purchased wooden items.'
  },
  {
    name: 'Flies (House & Fruit Flies)',
    species: 'Musca domestica & Drosophila',
    serviceLink: '/services/fly-control',
    pricing: 'Starting at ₹499',
    badge: 'Sanitation Vector',
    desc: 'Filth and fruit flies breeding in decomposing organic kitchen waste, unsealed drains, and overripe fruit, transferring bacteria onto food surfaces.',
    signs: 'Adult flies hovering around dining areas, maggots in waste bins, and drain fly larvae emerging from bathroom floor traps.',
    prevention: 'Sanitize kitchen sink drains with hot water and baking soda, keep food covered, use tightly sealed garbage bins, and install mesh screens.'
  }
];

const seasonalGuides = [
  {
    season: 'Monsoon (June – September)',
    focus: 'Mosquitoes, Cockroaches & Termite Swarms',
    desc: 'High ambient humidity and accumulated rainwater create rapid mosquito breeding cycles in stagnant drains. Heavy rainfall drives cockroaches upwards out of municipal sewers into kitchens. Termite reproductive swarmers emerge in twilight following early showers.',
    actions: 'Inspect balcony plant saucers weekly, maintain mesh screens, seal kitchen floor drains with jali traps, and look for discarded termite wings.'
  },
  {
    season: 'Post-Monsoon & Autumn (October – November)',
    focus: 'Rodents & Bed Bugs',
    desc: 'Falling evening temperatures prompt outdoor rats and mice to seek warm indoor harbourage inside false ceilings, wall cavities, and modular kitchens. Increased festive holiday and business travel accelerates bed bug transfers via suitcases.',
    actions: 'Seal pipe wall gaps with stainless steel wool, inspect hotel luggage before unpacking in bedrooms, and wash travel clothes in hot water.'
  },
  {
    season: 'Winter (December – February)',
    focus: 'Indoor Rodent Nesting & Fleas',
    desc: 'Rodents establish permanent indoor nests close to warmth sources, gnawing cables and contaminating food storages. Domestic pets spending extended hours on indoor carpets and blankets facilitate concentrated flea pupal cycles.',
    actions: 'Store pantry dry goods in glass containers, vacuum rugs and pet beds weekly, and monitor false ceiling access panels for rodent activity.'
  },
  {
    season: 'Summer (March – May)',
    focus: 'Ticks, Ants & Cockroaches',
    desc: 'High temperatures accelerate insect metabolism and egg hatch rates. Brown dog ticks proliferate rapidly in gardens, compound walls, and kennels. Foraging black and carpenter ants invade kitchens seeking moisture and food supplies.',
    actions: 'Apply pet tick prevention, seal exterior foundation cracks, wipe kitchen countertops nightly, and eliminate plumbing faucet leaks.'
  }
];

