<Layout
  title="Pest Control Knowledge Hub | Educational Guides & Pest Library | SLV Pest Control"
  description="Understand pests, prevent infestations, and protect your home. Comprehensive Bangalore pest library, identification diagnostics, IPM treatment guides, and seasonal calendars."
  canonical="https://slvpestcontrol.com/knowledge"
>
  <Header client:load activeItem="knowledge" />

  <main class="flex-1 w-full relative overflow-hidden bg-[#090a0c]">
    {/* Subtle Ambient Background Accents & Hexagonal Pattern */}
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 right-1/4 w-[550px] h-[550px] bg-[#E5A93C]/[0.05] rounded-full blur-[140px]"></div>
      <div class="absolute top-[35%] left-[-100px] w-[500px] h-[500px] bg-[#00D4FF]/[0.03] rounded-full blur-[160px]"></div>
      <div class="absolute bottom-[20%] right-[-80px] w-[450px] h-[450px] bg-[#E5A93C]/[0.04] rounded-full blur-[150px]"></div>
      <div class="absolute inset-0 opacity-[0.025] slv-hex-bg"></div>
    </div>

    {/* Breadcrumb Navigation */}
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-zinc-400">
        <a href="/" class="hover:text-white transition">Home</a>
        <span>/</span>
        <span class="text-[#F6C453] font-semibold">Knowledge Hub</span>
      </nav>
    </div>

    {/* HERO SECTION WITH RELEVANT EDUCATIONAL BACKGROUND BACKDROP */}
    <section class="relative z-10 pt-10 sm:pt-14 lg:pt-18 pb-12 sm:pb-16 border-b border-white/[0.06] overflow-hidden">
      {/* Educational Background Backdrop with subtle dark glass overlay */}
      <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
        <img
          src="/hero-banner.png"
          alt="SLV Pest Control Knowledge Hub"
          data-image-component="true"
          loading="eager"
          class="w-full h-full object-cover object-center opacity-15 filter blur-[1px] scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-[#090a0c]/85 via-[#090a0c]/95 to-[#090a0c]"></div>
        <div class="absolute inset-0 slv-hex-bg opacity-[0.03]"></div>
      </div>

      <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        {/* Category Badge */}
        <div class="inline-flex items-center gap-2 mb-4 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-md">
          <BookOpen class="w-3.5 h-3.5 text-[#E5A93C]" />
          <span class="text-[#E5A93C] text-xs font-extrabold tracking-[0.22em] uppercase">
            Pest Education &amp; Resource Directory
          </span>
        </div>

        {/* Title */}
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.08] mb-4 font-heading">
          Pest Control Knowledge <span class="slv-gold-text">Hub</span>
        </h1>

        {/* Subtitle & Description verbatim from mockup */}
        <p class="text-lg sm:text-xl font-medium text-[#FFE08A] mb-3">
          Understand, prevent and manage common pests for a cleaner and healthier space.
        </p>
        <p class="text-zinc-300 text-sm sm:text-base leading-relaxed max-w-2xl mx-auto mb-8 font-normal">
          Explore verified biological profiles, scientific IPM treatment protocols, structural prevention checklists, and Bangalore seasonal pest activity calendars.
        </p>

        {/* Hero CTAs: Call Now & WhatsApp */}
        <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 mb-8">
          <a
            href="tel:9180397822"
            class="slv-btn-primary px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider inline-flex items-center gap-2 shadow-[0_0_20px_rgba(229,169,60,0.3)]"
          >
            <Phone class="w-4 h-4 text-[#1a1202]" />
            <span>Call Now: 91803 97822</span>
          </a>
          <a
            href="https://wa.me/9180397822?text=Hello%20SLV%20Pest%20Control%2C%20I%20have%20a%20question%20about%20pest%20control%20services"
            target="_blank"
            rel="noopener noreferrer"
            class="slv-btn-secondary px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider inline-flex items-center gap-2 border-emerald-500/30 text-emerald-400 hover:text-white hover:border-emerald-400 hover:bg-emerald-500/10"
          >
            <MessageCircle class="w-4 h-4 text-emerald-400" />
            <span>WhatsApp Us</span>
          </a>
          <a
            href="/contact"
            class="px-5 py-3 rounded-xl bg-white/[0.04] border border-white/[0.1] text-xs sm:text-sm font-bold text-zinc-200 hover:text-white hover:bg-white/[0.08] transition inline-flex items-center gap-2"
          >
            <span>Book Free Inspection</span>
            <ArrowRight class="w-3.5 h-3.5 text-[#E5A93C]" />
          </a>
        </div>

        {/* Four Main Navigation Pills */}
        <div class="flex flex-wrap items-center justify-center gap-2 text-xs font-semibold">
          <a
            href="/knowledge/pests"
            class="px-3.5 py-2 rounded-xl bg-[#E5A93C]/10 border border-[#E5A93C]/30 text-[#F6C453] hover:text-white hover:border-[#F6C453] transition font-bold"
          >
            1. Pest Library
          </a>
          <a
            href="/knowledge/treatment"
            class="px-3.5 py-2 rounded-xl bg-white/[0.04] border border-white/[0.1] text-zinc-300 hover:text-white hover:border-[#F6C453] transition font-bold"
          >
            2. Treatment &amp; Prevention
          </a>
          <a
            href="/knowledge/seasonal"
            class="px-3.5 py-2 rounded-xl bg-white/[0.04] border border-white/[0.1] text-zinc-300 hover:text-white hover:border-[#F6C453] transition font-bold"
          >
            3. Seasonal Pest Guide
          </a>
          <a
            href="#pest-articles"
            class="px-3.5 py-2 rounded-xl bg-white/[0.04] border border-white/[0.08] text-zinc-400 hover:text-white hover:border-white/[0.2] transition"
          >
            4. Expert Articles (48+ Guides)
          </a>
        </div>
      </div>
    </section>

    {/* CORE HUB NAVIGATION CARDS (2 × 2 GRID MATCHING MOCKUP) */}
    <section class="relative z-10 py-12 sm:py-16 border-b border-white/[0.06] bg-black/20">
